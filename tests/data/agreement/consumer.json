{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:REAL:consumer:init",
  "assigner": "did:consumer:C-OK",
  "assignee": ["did:provider:P-OK"],
  "target": ["urn:asset:dataset:OK"],
  "permission": [
    {
      "action": "use",
      "constraint": [
        { "leftOperand": "odrl:absoluteTemporalPosition", "operator": "odrl:gteq", "rightOperand": "2025-06-01T00:00:00Z" },
        { "leftOperand": "odrl:percentage", "operator": "odrl:gteq", "rightOperand": 70 },
        { "leftOperand": "odrl:count", "operator": "odrl:gteq", "rightOperand": 1700 },
        { "leftOperand": "odrl:delayPeriod", "operator": "odrl:gteq", "rightOperand": "PT20M" },
        { "leftOperand": "odrl:fileFormat", "operator": "odrl:eq", "rightOperand": "XML" },
        { "leftOperand": "odrl:industry", "operator": "odrl:isAllOf", "rightOperand": ["research", "production"] },
        { "leftOperand": "odrl:language", "operator": "odrl:eq", "rightOperand": "en" },
        { "leftOperand": "odrl:purpose", "operator": "odrl:isAnyOf", "rightOperand": ["analytics", "publication"] }
      ]
    }
  ],
  "obligation": []
}
