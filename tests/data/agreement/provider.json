{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:REAL:provider:init",
  "assigner": "did:provider:P-OK",
  "assignee": ["did:consumer:C-OK"],
  "target": ["urn:asset:dataset:OK"],
  "permission": [
    {
      "action": "use",
      "constraint": [
        { "leftOperand": "odrl:absoluteTemporalPosition", "operator": "odrl:lteq", "rightOperand": "2025-07-01T00:00:00Z" },
        { "leftOperand": "odrl:percentage", "operator": "odrl:lteq", "rightOperand": 80 },
        { "leftOperand": "odrl:count", "operator": "odrl:lteq", "rightOperand": 1500 },
        { "leftOperand": "odrl:delayPeriod", "operator": "odrl:eq", "rightOperand": "PT15M" },
        { "leftOperand": "odrl:fileFormat", "operator": "odrl:eq", "rightOperand": "JSON" },
        { "leftOperand": "odrl:industry", "operator": "odrl:eq", "rightOperand": "research" },
        { "leftOperand": "odrl:language", "operator": "odrl:isAnyOf", "rightOperand": ["en", "fr", "gr"] },
        { "leftOperand": "odrl:purpose", "operator": "odrl:isAllOf", "rightOperand": ["research", "analytics", "open-source"] }
      ]
    }

  ],
  "obligation": []
}
