{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:REAL:consumer:init",
  "assigner": "did:consumer:C-OK",
  "assignee": ["did:provider:P-OK"],
  "target": ["urn:asset:dataset:OK"],
  "permission": [
    {
      "action": "use",
      "constraint": [
        { "leftOperand": "odrl:dateTime", "operator": "odrl:gteq", "rightOperand": "2025-05-15" },
        { "leftOperand": "odrl:dateTime", "operator": "odrl:lteq", "rightOperand": "2025-12-31" },
        { "leftOperand": "odrl:purpose", "operator": "odrl:eq", "rightOperand": "analytics" },
        { "leftOperand": "odrl:purpose", "operator": "odrl:neq", "rightOperand": "commercial" },
        { "leftOperand": "odrl:industry", "operator": "odrl:isAnyOf", "rightOperand": ["research", "development", "education"] },
        { "leftOperand": "odrl:industry", "operator": "odrl:isNoneOf", "rightOperand": ["gambling", "adult"] },
        { "leftOperand": "odrl:spatial", "operator": "odrl:isAnyOf", "rightOperand": ["EU", "NA"] },
        { "leftOperand": "odrl:count", "operator": "odrl:lt", "rightOperand": 12000 },
        { "leftOperand": "odrl:absoluteSize", "operator": "odrl:gt", "rightOperand": 1500 },
        { "leftOperand": "odrl:payAmount", "operator": "odrl:lteq", "rightOperand": 5500 },
        { "leftOperand": "odrl:percentage", "operator": "odrl:gteq", "rightOperand": 80 },
        { "leftOperand": "odrl:fileFormat", "operator": "odrl:isAnyOf", "rightOperand": ["json", "xml"] },
        { "leftOperand": "odrl:systemDevice", "operator": "odrl:isAnyOf", "rightOperand": ["cloud", "edge"] },
        { "leftOperand": "odrl:version", "operator": "odrl:neq", "rightOperand": "2.0.0" },
        { "leftOperand": "odrl:language", "operator": "odrl:eq", "rightOperand": "en" },
        { "leftOperand": "odrl:resolution", "operator": "odrl:isAnyOf", "rightOperand": ["grid:125m", "grid:250m"] },
        { "leftOperand": "odrl:delayPeriod", "operator": "odrl:gteq", "rightOperand": "PT30M" },
        { "leftOperand": "odrl:timeInterval", "operator": "odrl:lteq", "rightOperand": "P1M" }
      ]
    },
    {
      "action": "share",
      "constraint": [
        { "leftOperand": "odrl:dateTime", "operator": "odrl:gt", "rightOperand": "2025-05-15T00:00:00Z" },
        { "leftOperand": "odrl:dateTime", "operator": "odrl:lt", "rightOperand": "2025-12-31T00:00:00Z" },
        { "leftOperand": "odrl:purpose", "operator": "odrl:isNoneOf", "rightOperand": ["resale", "redistribution"] },
        { "leftOperand": "odrl:recipient", "operator": "odrl:eq", "rightOperand": "did:consumer:A:affiliate" },
        { "leftOperand": "odrl:industry", "operator": "odrl:neq", "rightOperand": "competitor" }
      ]
    }
  ],

  "obligation": []
}