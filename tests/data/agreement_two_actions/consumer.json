{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:REAL:consumer:init",
  "assigner": "did:consumer:C-OK",
  "assignee": ["did:provider:P-OK"],
  "target": ["urn:asset:dataset:OK"],
  "permission": [
    {
      "action": "use",
      "constraint": [
        { "leftOperand": "odrl:dateTime", "operator": "odrl:gteq", "rightOperand": "2025-06-01" },
        { "leftOperand": "odrl:dateTime", "operator": "odrl:lteq", "rightOperand": "2025-11-30" },
        { "leftOperand": "odrl:purpose", "operator": "odrl:eq", "rightOperand": "analytics" },
        { "leftOperand": "odrl:industry", "operator": "odrl:isAnyOf", "rightOperand": ["research", "development", "education"] },
        { "leftOperand": "odrl:spatial", "operator": "odrl:isAllOf", "rightOperand": ["EU", "NA"] },
        { "leftOperand": "odrl:count", "operator": "odrl:lt", "rightOperand": 10000 },
        { "leftOperand": "odrl:absoluteSize", "operator": "odrl:gt", "rightOperand": 2000},
        { "leftOperand": "odrl:payAmount", "operator": "odrl:lteq", "rightOperand": 5000 },
        { "leftOperand": "odrl:percentage", "operator": "odrl:gteq", "rightOperand": 80 },
        { "leftOperand": "odrl:fileFormat", "operator": "odrl:eq", "rightOperand": "json" },
        { "leftOperand": "odrl:systemDevice", "operator": "odrl:isAnyOf", "rightOperand": ["server", "cloud", "edge"] },
        { "leftOperand": "odrl:version", "operator": "odrl:neq", "rightOperand": "2.0.0" },
        { "leftOperand": "odrl:language", "operator": "odrl:eq", "rightOperand": "en" },
        { "leftOperand": "odrl:resolution", "operator": "odrl:eq", "rightOperand": "grid:125m" },
        { "leftOperand": "odrl:delayPeriod", "operator": "odrl:gteq", "rightOperand": "PT1H" },
        { "leftOperand": "odrl:timeInterval", "operator": "odrl:lteq", "rightOperand": "P15D" }
      ]
    },
    {
      "action": "share",
      "constraint": [
        { "leftOperand": "odrl:dateTime", "operator": "odrl:gt", "rightOperand": "2025-06-01T00:00:00Z" },
        { "leftOperand": "odrl:dateTime", "operator": "odrl:lt", "rightOperand": "2025-11-30T00:00:00Z" },
        { "leftOperand": "odrl:purpose", "operator": "odrl:isNoneOf", "rightOperand": ["resale", "redistribution"] },
        { "leftOperand": "odrl:recipient", "operator": "odrl:eq", "rightOperand": "did:consumer:A:affiliate" },
        { "leftOperand": "odrl:industry", "operator": "odrl:neq", "rightOperand": "competitor" }
      ]
    }
  ],

  "obligation": []
}