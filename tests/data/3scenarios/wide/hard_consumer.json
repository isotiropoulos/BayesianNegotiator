{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:WIDE:consumer:hard",
  "assigner": "did:consumer:C-WIDE",
  "assignee": ["did:provider:P-WIDE"],
  "target": ["urn:asset:dataset:WIDE"],
  "permission": [
    {
      "action": "use",
      "constraint": [
        { "leftOperand": "odrl:absoluteTemporalPosition", "operator": "odrl:gteq", "rightOperand": "2025-05-01T00:00:00Z" },
        { "leftOperand": "odrl:percentage", "operator": "odrl:gteq", "rightOperand": 50 },
        { "leftOperand": "odrl:count", "operator": "odrl:gteq", "rightOperand": 1200 },
        { "leftOperand": "odrl:delayPeriod", "operator": "odrl:gteq", "rightOperand": "PT5M" },
        { "leftOperand": "odrl:fileFormat", "operator": "odrl:isAnyOf", "rightOperand": ["JSON", "XML", "CSV"] },
        { "leftOperand": "odrl:industry", "operator": "odrl:isAnyOf", "rightOperand": ["research", "production"] },
        { "leftOperand": "odrl:language", "operator": "odrl:eq", "rightOperand": "en" },
        { "leftOperand": "odrl:purpose", "operator": "odrl:isAnyOf", "rightOperand": ["analytics", "publication", "research"] }
      ]
    },
    {
      "action": "transform",
      "constraint": [
        { "leftOperand": "odrl:percentage", "operator": "odrl:gteq", "rightOperand": 50 },
        { "leftOperand": "odrl:count", "operator": "odrl:gteq", "rightOperand": 1200 },
        { "leftOperand": "odrl:fileFormat", "operator": "odrl:isAnyOf", "rightOperand": ["JSON", "XML", "CSV"] }
      ]
    }
  ],
  "obligation": [
    {
      "action": "anonymize",
      "constraint": [
        { "leftOperand": "odrl:delayPeriod", "operator": "odrl:gteq", "rightOperand": "PT5M" },
        { "leftOperand": "odrl:percentage", "operator": "odrl:gteq", "rightOperand": 50 },
        { "leftOperand": "odrl:industry", "operator": "odrl:isAnyOf", "rightOperand": ["research", "production"] }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "redistribute",
      "constraint": [
        { "leftOperand": "odrl:count", "operator": "odrl:gteq", "rightOperand": 1200 },
        { "leftOperand": "odrl:purpose", "operator": "odrl:isAnyOf", "rightOperand": ["analytics", "publication", "research"] }
      ]
    }
  ]
}
