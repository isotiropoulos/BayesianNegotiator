      "constraint": [
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:eq",
          "rightOperand": "low-resolution images"
        },
        {
          "leftOperand": "odrl:absoluteTemporalPosition",
          "operator": "odrl:eq",
          "rightOperand": "2027-01-13"
        },
        {
          "leftOperand": "odrl:samplingRate",
          "operator": "odrl:eq",
          "rightOperand": 0.25
        },
        {
          "leftOperand": "odrl:recipient",
          "operator": "odrl:eq",
          "rightOperand": "affiliate"
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:spatialResolution",
          "operator": "odrl:eq",
          "rightOperand": 413
        },
        {
          "leftOperand": "odrl:language",
          "operator": "odrl:eq",
          "rightOperand": "en"
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:relativeTemporalPosition",
          "operator": "odrl:eq",
          "rightOperand": "2025-10-30"
        },
        {
          "leftOperand": "odrl:deliveryChannel",
          "operator": "odrl:eq",
          "rightOperand": "s3"
        }
      ]
    }
  ]
