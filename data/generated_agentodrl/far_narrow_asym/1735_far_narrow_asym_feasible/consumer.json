{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1735_far_narrow_asym:consumer:aspiration",
  "assigner": "did:party:policy-owner",
  "assignee": [
    "did:party:counterparty"
  ],
  "target": [
    "urn:asset:transactional-behavior-data-asset"
  ],
  "permission": [
    {
      "action": "provide",
      "constraint": [
        {
          "leftOperand": "odrl:retentionInformation",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "retention phase or criteria"
          ]
        },
        {
          "leftOperand": "odrl:committeeInfo",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "Alliance Data Governance Committee qualified to handle Customer rights requests"
          ]
        },
        {
          "leftOperand": "odrl:protocol",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "Protocol 9.2.A",
            "RESTful,其他主流协议"
          ]
        },
        {
          "leftOperand": "odrl:withdrawalRight",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "Customer's right to withdraw consent at any time",
            "Based on Smart Agriculture Cooperative Charter Article 9.2(A)",
            "true"
          ]
        },
        {
          "leftOperand": "odrl:version",
          "operator": "odrl:lteq",
          "rightOperand": 0
        },
        {
          "leftOperand": "odrl:unitOfCount",
          "operator": "odrl:gteq",
          "rightOperand": 1529
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:delayPeriod",
          "operator": "odrl:lteq",
          "rightOperand": "PT0S"
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:timeInterval",
          "operator": "odrl:lteq",
          "rightOperand": "PT0S"
        }
      ]
    }
  ]
}