{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Agreement",
  "@id": "urn:witness",
  "assigner": "did:party:policy-issuer",
  "assignee": [
    "did:party:ecological-environment-authority",
    "did:party:polluting-enterprise"
  ],
  "target": [
    "urn:asset:environmental-pollution-source-tracing",
    "urn:asset:polluting-enterprise"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:payAmount",
          "operator": "odrl:eq",
          "rightOperand": 750
        },
        {
          "leftOperand": "odrl:unitOfCount",
          "operator": "odrl:eq",
          "rightOperand": 1471
        },
        {
          "leftOperand": "odrl:virtualLocation",
          "operator": "odrl:eq",
          "rightOperand": "hybrid"
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:spatialResolution",
          "operator": "odrl:eq",
          "rightOperand": 120
        },
        {
          "leftOperand": "odrl:industry",
          "operator": "odrl:eq",
          "rightOperand": "energy"
        },
        {
          "leftOperand": "odrl:recipient",
          "operator": "odrl:eq",
          "rightOperand": "affiliate"
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:version",
          "operator": "odrl:eq",
          "rightOperand": 1
        },
        {
          "leftOperand": "odrl:purpose",
          "operator": "odrl:eq",
          "rightOperand": "marketing"
        }
      ]
    }
  ]
}