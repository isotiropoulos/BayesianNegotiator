{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1267_far_narrow_asym:consumer:hard",
  "assigner": "did:party:health-data-authority",
  "assignee": [
    "did:party:alliance-member"
  ],
  "target": [
    "urn:asset:health-data-asset"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:delayPeriod",
          "operator": "odrl:lt",
          "rightOperand": "P2DT4H18M2.996S"
        },
        {
          "leftOperand": "odrl:meteredTime",
          "operator": "odrl:gt",
          "rightOperand": "P21DT20H59M7.66S"
        },
        {
          "leftOperand": "odrl:purpose",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "journalism",
            "Port efficiency studies",
            "ongoing trial enrollment numbers"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:samplingRate",
          "operator": "odrl:gteq",
          "rightOperand": 0.72
        },
        {
          "leftOperand": "odrl:deliveryChannel",
          "operator": "odrl:isNoneOf",
          "rightOperand": [
            "courier"
          ]
        },
        {
          "leftOperand": "odrl:systemDevice",
          "operator": "odrl:neq",
          "rightOperand": "container"
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:relativeTemporalPosition",
          "operator": "odrl:lt",
          "rightOperand": "2024-06-24"
        },
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "CH"
          ]
        }
      ]
    }
  ]
