{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0291_far_narrow_asym:provider:hard",
  "assigner": "did:party:air-quality-monitoring-data",
  "assignee": [
    "did:party:city-health-departments"
  ],
  "target": [
    "urn:asset:real-time-alert-dashboard",
    "urn:asset:detailed-sensor-datasets"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:relativeTemporalPosition",
          "operator": "odrl:gteq",
          "rightOperand": "2025-08-10"
        },
        {
          "leftOperand": "odrl:delayPeriod",
          "operator": "odrl:gteq",
          "rightOperand": "P4DT9H4M12.577S"
        },
        {
          "leftOperand": "odrl:virtualLocation",
          "operator": "odrl:neq",
          "rightOperand": "edge"
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:version",
          "operator": "odrl:gteq",
          "rightOperand": 1
        },
        {
          "leftOperand": "odrl:purpose",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "audit"
          ]
        },
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:eq",
          "rightOperand": "EEA"
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:meteredTime",
          "operator": "odrl:lt",
          "rightOperand": "P10DT5H12M54.213S"
        },
        {
          "leftOperand": "odrl:systemDevice",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "hsm",
            "container",
            "tee"
          ]
        }
      ]
    }
  ]
}