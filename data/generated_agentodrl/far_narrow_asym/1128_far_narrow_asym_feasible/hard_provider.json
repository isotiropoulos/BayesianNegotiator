{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1128_far_narrow_asym:provider:hard",
  "assigner": "did:party:yield-forecast",
  "assignee": [
    "did:party:farm-net",
    "did:party:agri-metrics"
  ],
  "target": [
    "urn:asset:yield-forecast"
  ],
  "permission": [
    {
      "action": "distribute",
      "constraint": [
        {
          "leftOperand": "odrl:revenueType",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "subscription"
          ]
        },
        {
          "leftOperand": "odrl:spatialResolution",
          "operator": "odrl:gt",
          "rightOperand": 224
        },
        {
          "leftOperand": "odrl:relativeTemporalPosition",
          "operator": "odrl:gteq",
          "rightOperand": "2025-09-11"
        },
        {
          "leftOperand": "odrl:deliveryChannel",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "s3",
            "sftp",
            "kafka"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:unitOfCount",
          "operator": "odrl:lt",
          "rightOperand": 1955
        },
        {
          "leftOperand": "odrl:systemDevice",
          "operator": "odrl:eq",
          "rightOperand": "container"
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:resolution",
          "operator": "odrl:gt",
          "rightOperand": 23
        },
        {
          "leftOperand": "odrl:recipient",
          "operator": "odrl:neq",
          "rightOperand": "regulator"
        }
      ]
    }
  ]
}