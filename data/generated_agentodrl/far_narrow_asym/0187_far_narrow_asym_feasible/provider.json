{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0187_far_narrow_asym:provider:aspiration",
  "assigner": "did:party:policy-issuer",
  "assignee": [
    "did:party:mountain-conservation-authority",
    "did:party:alpine-data-trust"
  ],
  "target": [
    "urn:asset:endangered-alpine-flora-records",
    "urn:asset:usage-reports"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:unitOfCount",
          "operator": "odrl:lteq",
          "rightOperand": 1172
        },
        {
          "leftOperand": "odrl:purpose",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "audit",
            "marketing",
            "statistics"
          ]
        },
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "global",
            "EEA",
            "CH"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:resolution",
          "operator": "odrl:lteq",
          "rightOperand": 63
        },
        {
          "leftOperand": "odrl:media",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "web",
            "broadcast",
            "internal-wiki"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "deliverReport",
      "constraint": [
        {
          "leftOperand": "odrl:dateTime",
          "operator": "odrl:lt",
          "rightOperand": "2024-01-01T00:00:00Z"
        },
        {
          "leftOperand": "odrl:count",
          "operator": "odrl:lteq",
          "rightOperand": 189940
        },
        {
          "leftOperand": "odrl:event",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "breach",
            "termination",
            "renewal"
          ]
        }
      ]
    }
  ]
}