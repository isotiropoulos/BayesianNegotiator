{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Agreement",
  "@id": "urn:witness",
  "assigner": "did:party:system-owner",
  "assignee": [
    "did:party:user"
  ],
  "target": [
    "urn:asset:digital-collection-climate-data-records",
    "urn:asset:user"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:absoluteTemporalPosition",
          "operator": "odrl:eq",
          "rightOperand": "2028-06-10"
        },
        {
          "leftOperand": "odrl:meteredTime",
          "operator": "odrl:eq",
          "rightOperand": "P22DT1H47M40.085S"
        },
        {
          "leftOperand": "odrl:media",
          "operator": "odrl:eq",
          "rightOperand": "internal-wiki"
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:spatialResolution",
          "operator": "odrl:eq",
          "rightOperand": 78
        },
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:eq",
          "rightOperand": "EU"
        },
        {
          "leftOperand": "odrl:industry",
          "operator": "odrl:eq",
          "rightOperand": "energy"
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:unitOfCount",
          "operator": "odrl:eq",
          "rightOperand": 3030
        },
        {
          "leftOperand": "odrl:recipient",
          "operator": "odrl:eq",
          "rightOperand": "//example.org/parties/agriTechCompany"
        }
      ]
    }
  ]
}