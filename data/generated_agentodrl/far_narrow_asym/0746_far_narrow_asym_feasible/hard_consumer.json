{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0746_far_narrow_asym:consumer:hard",
  "assigner": "did:party:data-owner",
  "assignee": [
    "did:party:enterprise-user"
  ],
  "target": [
    "urn:asset:hospital-admission-records",
    "urn:asset:authorization"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:version",
          "operator": "odrl:lt",
          "rightOperand": 3
        },
        {
          "leftOperand": "odrl:confidenceLevel",
          "operator": "odrl:lt",
          "rightOperand": 0.47
        },
        {
          "leftOperand": "odrl:industry",
          "operator": "odrl:eq",
          "rightOperand": "health"
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:percentage",
          "operator": "odrl:gt",
          "rightOperand": 20
        },
        {
          "leftOperand": "odrl:deliveryChannel",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "kafka"
          ]
        },
        {
          "leftOperand": "odrl:language",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "es"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:spatialResolution",
          "operator": "odrl:lt",
          "rightOperand": 389
        },
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "UK",
            "ASEAN",
            "online privacy policy"
          ]
        }
      ]
    }
  ]
}