        {
          "leftOperand": "odrl:recipient",
          "operator": "odrl:neq",
          "rightOperand": "regulator"
        },
        {
          "leftOperand": "odrl:media",
          "operator": "odrl:eq",
          "rightOperand": "web"
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:version",
          "operator": "odrl:lt",
          "rightOperand": 4
