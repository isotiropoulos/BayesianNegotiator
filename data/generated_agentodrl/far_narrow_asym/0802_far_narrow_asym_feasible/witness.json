{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Agreement",
  "@id": "urn:witness",
  "assigner": "did:party:content-owner",
  "assignee": [
    "did:party:user"
  ],
  "target": [
    "urn:asset:alpine-traditional-music-database"
  ],
  "permission": [
    {
      "action": "play",
      "constraint": [
        {
          "leftOperand": "odrl:absoluteSpatialPosition",
          "operator": "odrl:eq",
          "rightOperand": "Eurozone"
        },
        {
          "leftOperand": "odrl:spatialPosition",
          "operator": "odrl:eq",
          "rightOperand": "Eurozone"
        },
        {
          "leftOperand": "odrl:meteredTime",
          "operator": "odrl:eq",
          "rightOperand": "P7DT17H23M50.342S"
        },
        {
          "leftOperand": "odrl:timeInterval",
          "operator": "odrl:eq",
          "rightOperand": "P18DT9H45M55.915S"
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:delayPeriod",
          "operator": "odrl:eq",
          "rightOperand": "P5DT4H6M18.684S"
        },
        {
          "leftOperand": "odrl:recipient",
          "operator": "odrl:eq",
          "rightOperand": "regulator"
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:spatialResolution",
          "operator": "odrl:eq",
          "rightOperand": 257
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:eq",
          "rightOperand": "PARQUET"
        }
      ]
    }
  ]
}