{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0802_far_narrow_asym:provider:hard",
  "assigner": "did:party:content-owner",
  "assignee": [
    "did:party:user"
  ],
  "target": [
    "urn:asset:alpine-traditional-music-database"
  ],
  "permission": [
    {
      "action": "play",
      "constraint": [
        {
          "leftOperand": "odrl:absoluteSpatialPosition",
          "operator": "odrl:isNoneOf",
          "rightOperand": [
            "domestic"
          ]
        },
        {
          "leftOperand": "odrl:spatialPosition",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "Eurozone"
          ]
        },
        {
          "leftOperand": "odrl:meteredTime",
          "operator": "odrl:lteq",
          "rightOperand": "P9DT11H12M30.963S"
        },
        {
          "leftOperand": "odrl:timeInterval",
          "operator": "odrl:gt",
          "rightOperand": "P16DT17H40M52.915S"
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:delayPeriod",
          "operator": "odrl:gt",
          "rightOperand": "P4DT16H50M39.642S"
        },
        {
          "leftOperand": "odrl:recipient",
          "operator": "odrl:eq",
          "rightOperand": "regulator"
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:spatialResolution",
          "operator": "odrl:gteq",
          "rightOperand": 233
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "PARQUET",
            "RDF",
            "JSON"
          ]
        }
      ]
    }
  ]
}