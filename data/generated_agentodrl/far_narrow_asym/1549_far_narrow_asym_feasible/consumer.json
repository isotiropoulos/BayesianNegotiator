        },
        {
          "leftOperand": "odrl:systemDevice",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "hsm",
            "consortium-approved",
            "container"
          ]
        }
      ]
    }
  ],
  "obligation": [
