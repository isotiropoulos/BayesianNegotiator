{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0678_far_narrow_asym:consumer:aspiration",
  "assigner": "did:party:steward-of-su-359",
  "assignee": [
    "did:party:counterparty"
  ],
  "target": [
    "urn:asset:live-grid-load-data",
    "urn:asset:granular-data-streams"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:payAmount",
          "operator": "odrl:lteq",
          "rightOperand": 0
        },
        {
          "leftOperand": "odrl:purpose",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "education",
            "derivative works",
            "数据分类"
          ]
        },
        {
          "leftOperand": "odrl:deliveryChannel",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "sftp",
            "courier",
            "SupportChannel"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "distribute",
      "constraint": [
        {
          "leftOperand": "odrl:reportingLevel",
          "operator": "odrl:lteq",
          "rightOperand": 0
        },
        {
          "leftOperand": "odrl:timeInterval",
          "operator": "odrl:lteq",
          "rightOperand": "PT0S"
        },
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "EU",
            "European Union",
            "中华人民共和国境内"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:absoluteTemporalPosition",
          "operator": "odrl:gteq",
          "rightOperand": "2028-12-07"
        },
        {
          "leftOperand": "odrl:industry",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "mobility",
            "finance",
            "国家工业安全"
          ]
        }
      ]
    }
  ]
}