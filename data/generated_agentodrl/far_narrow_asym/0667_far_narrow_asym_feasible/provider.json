{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0667_far_narrow_asym:provider:aspiration",
  "assigner": "did:party:policy-issuer",
  "assignee": [
    "did:party:participant"
  ],
  "target": [
    "urn:asset:arctic-wildlife-migration-data",
    "urn:asset:full-resolution-data",
    "urn:asset:summary-heatmaps"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:spatialResolution",
          "operator": "odrl:lteq",
          "rightOperand": 463
        },
        {
          "leftOperand": "odrl:media",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "web",
            "broadcast",
            "internal-wiki"
          ]
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "CSV",
            "XML",
            "XLSX"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "download",
      "constraint": [
        {
          "leftOperand": "odrl:detectAnomalousMovement",
          "operator": "odrl:gt",
          "rightOperand": 3
        },
        {
          "leftOperand": "odrl:version",
          "operator": "odrl:lteq",
          "rightOperand": 2
        },
        {
          "leftOperand": "odrl:purpose",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "education",
            "commercial",
            "statistics"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:confidenceLevel",
          "operator": "odrl:lteq",
          "rightOperand": 0.56
        },
        {
          "leftOperand": "odrl:deliveryChannel",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "courier",
            "s3",
            "sftp"
          ]
        }
      ]
    }
  ]
}