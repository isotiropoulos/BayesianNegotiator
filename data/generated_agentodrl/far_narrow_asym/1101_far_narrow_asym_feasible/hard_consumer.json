{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1101_far_narrow_asym:consumer:hard",
  "assigner": "did:party:sensor-data",
  "assignee": [
    "did:party:user"
  ],
  "target": [
    "urn:asset:sensor-data"
  ],
  "permission": [
    {
      "action": "distribute",
      "constraint": [
        {
          "leftOperand": "odrl:userConsent",
          "operator": "odrl:eq",
          "rightOperand": "True"
        },
        {
          "leftOperand": "odrl:percentage",
          "operator": "odrl:gteq",
          "rightOperand": 73
        },
        {
          "leftOperand": "odrl:count",
          "operator": "odrl:gt",
          "rightOperand": 387292
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:version",
          "operator": "odrl:lt",
          "rightOperand": 1
        },
        {
          "leftOperand": "odrl:virtualLocation",
          "operator": "odrl:eq",
          "rightOperand": "air-gapped"
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "provide",
      "constraint": [
        {
          "leftOperand": "odrl:sensorDataResolution",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "high"
          ]
        },
        {
          "leftOperand": "odrl:elapsedTime",
          "operator": "odrl:gt",
          "rightOperand": "P51DT11H52M40.88S"
        },
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:eq",
          "rightOperand": "UK"
        }
      ]
    }
  ]
