{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0959_far_narrow_asym:provider:hard",
  "assigner": "did:party:data-space",
  "assignee": [
    "did:party:counterparty"
  ],
  "target": [
    "urn:asset:data-space",
    "urn:asset:public-notice",
    "urn:asset:approval-list"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:resolution",
          "operator": "odrl:gteq",
          "rightOperand": 10
        },
        {
          "leftOperand": "odrl:relativeTemporalPosition",
          "operator": "odrl:gteq",
          "rightOperand": "2024-03-19"
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:samplingRate",
          "operator": "odrl:lteq",
          "rightOperand": 0.74
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:neq",
          "rightOperand": "XLSX"
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "publish",
      "constraint": [
        {
          "leftOperand": "odrl:approvalList",
          "operator": "odrl:eq",
          "rightOperand": "Asset:PublicNoticePeriod"
        },
        {
          "leftOperand": "odrl:meteredTime",
          "operator": "odrl:lteq",
          "rightOperand": "P22DT15H44M30.374S"
        },
        {
          "leftOperand": "odrl:industry",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "health",
            "energy",
            "public"
          ]
        }
      ]
    },
    {
      "action": "wait",
      "constraint": [
        {
          "leftOperand": "odrl:publicNoticeStatus",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "no_objection"
          ]
        }
      ]
    }
  ]
}