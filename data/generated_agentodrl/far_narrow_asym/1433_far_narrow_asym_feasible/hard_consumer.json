{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1433_far_narrow_asym:consumer:hard",
  "assigner": "did:party:policy-to-delete-account-assigner",
  "assignee": [
    "did:party:counterparty"
  ],
  "target": [
    "urn:asset:account"
  ],
  "permission": [
    {
      "action": "delete",
      "constraint": [
        {
          "leftOperand": "odrl:link",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "same link"
          ]
        },
        {
          "leftOperand": "odrl:relativeTemporalPosition",
          "operator": "odrl:lteq",
          "rightOperand": "2024-06-30"
        },
        {
          "leftOperand": "odrl:confidenceLevel",
          "operator": "odrl:lt",
          "rightOperand": 0.13
        },
        {
          "leftOperand": "odrl:event",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "audit"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:count",
          "operator": "odrl:gt",
          "rightOperand": 599460
        },
        {
          "leftOperand": "odrl:language",
          "operator": "odrl:neq",
          "rightOperand": "es"
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:meteredTime",
          "operator": "odrl:gt",
          "rightOperand": "P19DT16H21M43.251S"
        },
        {
          "leftOperand": "odrl:recipient",
          "operator": "odrl:neq",
          "rightOperand": "regulator"
        }
      ]
    }
  ]
}