{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1009_far_narrow_asym:consumer:aspiration",
  "assigner": "did:party:policy-issuer",
  "assignee": [
    "did:party:data-processor-party"
  ],
  "target": [
    "urn:asset:energy-data-asset",
    "urn:asset:data-sharing"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:confidenceLevel",
          "operator": "odrl:lteq",
          "rightOperand": 0.0
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "CSV",
            "structured, commonly used, machine-readable",
            "granular, real-time consumption"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:epsilon",
          "operator": "odrl:gteq",
          "rightOperand": 5.2
        },
        {
          "leftOperand": "odrl:unitOfCount",
          "operator": "odrl:gteq",
          "rightOperand": 1682
        },
        {
          "leftOperand": "odrl:virtualLocation",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "us-cloud",
            "edge",
            "air-gapped"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "apply",
      "constraint": [
        {
          "leftOperand": "odrl:privacyLevel",
          "operator": "odrl:gteq",
          "rightOperand": 5.2
        },
        {
          "leftOperand": "odrl:language",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "es",
            "de",
            "el"
          ]
        },
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "EEA",
            "UserCountry",
            "DACH"
          ]
        }
      ]
    }
  ]
}