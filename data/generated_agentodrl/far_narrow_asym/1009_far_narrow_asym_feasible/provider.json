{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1009_far_narrow_asym:provider:aspiration",
  "assigner": "did:party:policy-issuer",
  "assignee": [
    "did:party:data-processor-party"
  ],
  "target": [
    "urn:asset:energy-data-asset",
    "urn:asset:data-sharing"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:confidenceLevel",
          "operator": "odrl:lteq",
          "rightOperand": 0.55
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "CSV",
            "RDF",
            "XLSX"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:epsilon",
          "operator": "odrl:lteq",
          "rightOperand": 2.0
        },
        {
          "leftOperand": "odrl:unitOfCount",
          "operator": "odrl:lteq",
          "rightOperand": 647
        },
        {
          "leftOperand": "odrl:virtualLocation",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "us-cloud",
            "eu-cloud",
            "on-prem"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "apply",
      "constraint": [
        {
          "leftOperand": "odrl:privacyLevel",
          "operator": "odrl:lteq",
          "rightOperand": 2.0
        },
        {
          "leftOperand": "odrl:language",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "es",
            "en",
            "fr"
          ]
        },
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "EEA",
            "US",
            "UK"
          ]
        }
      ]
    }
  ]
}