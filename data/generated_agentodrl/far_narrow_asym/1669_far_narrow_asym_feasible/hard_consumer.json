{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1669_far_narrow_asym:consumer:hard",
  "assigner": "did:party:party-policy-owner",
  "assignee": [
    "did:party:online-travel-agency"
  ],
  "target": [
    "urn:asset:personal-information",
    "urn:asset:traveler"
  ],
  "permission": [
    {
      "action": "distribute",
      "constraint": [
        {
          "leftOperand": "odrl:parentOrGuardianAuthorization",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "True"
          ]
        },
        {
          "leftOperand": "odrl:travelerAge",
          "operator": "odrl:gt",
          "rightOperand": 35
        },
        {
          "leftOperand": "odrl:payAmount",
          "operator": "odrl:lteq",
          "rightOperand": 1350
        },
        {
          "leftOperand": "odrl:recipient",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "affiliate",
            "CarOwner",
            "local_minimum_age_of_consent"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "distribute",
      "constraint": [
        {
          "leftOperand": "odrl:travelerAge",
          "operator": "odrl:gteq",
          "rightOperand": 35
        },
        {
          "leftOperand": "odrl:resolution",
          "operator": "odrl:lt",
          "rightOperand": 22
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "JSON",
            "XLSX",
            "granular, real-time consumption"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:systemDevice",
          "operator": "odrl:isNoneOf",
          "rightOperand": [
            "bare-metal"
          ]
        }
      ]
    }
  ]
}