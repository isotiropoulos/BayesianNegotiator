{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1510_far_narrow_asym:provider:aspiration",
  "assigner": "did:party:steward-of-cu-j-635",
  "assignee": [
    "did:party:certified-logistics-partner"
  ],
  "target": [
    "urn:asset:shipment-tracking-data"
  ],
  "permission": [
    {
      "action": "fileReport",
      "constraint": [
        {
          "leftOperand": "odrl:detectReliabilityIssue",
          "operator": "odrl:eq",
          "rightOperand": "true"
        },
        {
          "leftOperand": "odrl:delayPeriod",
          "operator": "odrl:lteq",
          "rightOperand": "PT8M"
        },
        {
          "leftOperand": "odrl:samplingRate",
          "operator": "odrl:lteq",
          "rightOperand": 0.07
        },
        {
          "leftOperand": "odrl:deliveryChannel",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "kafka",
            "sftp",
            "https"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:percentage",
          "operator": "odrl:lteq",
          "rightOperand": 11
        },
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "global",
            "US",
            "EU"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:count",
          "operator": "odrl:lteq",
          "rightOperand": 269040
        },
        {
          "leftOperand": "odrl:recipient",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "affiliate",
            "internal-only",
            "third-party"
          ]
        }
      ]
    }
  ]
}