{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1303_far_narrow_asym:consumer:aspiration",
  "assigner": "did:party:policy-issuer",
  "assignee": [
    "did:party:smart-contract",
    "did:party:system"
  ],
  "target": [
    "urn:asset:smart-contract",
    "urn:asset:data-asset"
  ],
  "permission": [
    {
      "action": "execute",
      "constraint": [
        {
          "leftOperand": "odrl:executionTrigger",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "automatic"
          ]
        },
        {
          "leftOperand": "odrl:confidenceLevel",
          "operator": "odrl:lteq",
          "rightOperand": 0.0
        },
        {
          "leftOperand": "odrl:relativeTemporalPosition",
          "operator": "odrl:lteq",
          "rightOperand": "2023-10-04"
        }
      ]
    },
    {
      "action": "delete",
      "constraint": [
        {
          "leftOperand": "odrl:violationDetected",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "true"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:payAmount",
          "operator": "odrl:lteq",
          "rightOperand": 0
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "CSV",
            "XML",
            "granular, real-time consumption"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:unitOfCount",
          "operator": "odrl:gteq",
          "rightOperand": 2288
        },
        {
          "leftOperand": "odrl:deliveryChannel",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "courier",
            "SupportChannel",
            "kafka"
          ]
        }
      ]
    }
  ]
}