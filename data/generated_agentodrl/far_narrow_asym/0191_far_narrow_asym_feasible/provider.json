{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0191_far_narrow_asym:provider:aspiration",
  "assigner": "did:party:steward-of-su-112",
  "assignee": [
    "did:party:baltic-oceanography-consortium"
  ],
  "target": [
    "urn:asset:rare-marine-species-observations",
    "urn:asset:marine-data-governance-council"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:meteredTime",
          "operator": "odrl:lteq",
          "rightOperand": "P2DT7H52M11.264S"
        },
        {
          "leftOperand": "odrl:resolution",
          "operator": "odrl:lteq",
          "rightOperand": 85
        },
        {
          "leftOperand": "odrl:industry",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "public",
            "health",
            "finance"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:unitOfCount",
          "operator": "odrl:lteq",
          "rightOperand": 1165
        },
        {
          "leftOperand": "odrl:systemDevice",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "vm",
            "tee",
            "container"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "submitActivityLogs",
      "constraint": [
        {
          "leftOperand": "odrl:frequency",
          "operator": "odrl:eq",
          "rightOperand": "quarterly"
        },
        {
          "leftOperand": "odrl:relativeTemporalPosition",
          "operator": "odrl:lteq",
          "rightOperand": "2026-03-05"
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "XLSX",
            "XML",
            "PARQUET"
          ]
        }
      ]
    }
  ]
