{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1193_far_narrow_asym:consumer:aspiration",
  "assigner": "did:party:policy-owner",
  "assignee": [
    "did:party:data-scientist"
  ],
  "target": [
    "urn:asset:earth-observation-data-model"
  ],
  "permission": [
    {
      "action": "test",
      "constraint": [
        {
          "leftOperand": "odrl:environment",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "neutral Earth Observation Data Space sandbox",
            "Official VR Headsets",
            "Gaia-X Trusted Zone"
          ]
        },
        {
          "leftOperand": "odrl:unitOfCount",
          "operator": "odrl:gteq",
          "rightOperand": 2681
        },
        {
          "leftOperand": "odrl:confidenceLevel",
          "operator": "odrl:lteq",
          "rightOperand": 0.0
        },
        {
          "leftOperand": "odrl:language",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "fr",
            "en",
            "es"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:samplingRate",
          "operator": "odrl:gteq",
          "rightOperand": 0.93
        },
        {
          "leftOperand": "odrl:deliveryChannel",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "kafka",
            "courier",
            "SupportChannel"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:delayPeriod",
          "operator": "odrl:lteq",
          "rightOperand": "PT0S"
        },
        {
          "leftOperand": "odrl:recipient",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "consortium",
            "urn:party:AccountHolder",
            "NationalEnvironmentalAgency"
          ]
        }
      ]
    }
  ]
}