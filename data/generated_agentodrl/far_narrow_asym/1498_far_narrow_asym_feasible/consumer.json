{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1498_far_narrow_asym:consumer:aspiration",
  "assigner": "did:party:policy-issuer",
  "assignee": [
    "did:party:data-provider"
  ],
  "target": [
    "urn:asset:incident-explanation",
    "urn:asset:publishing-capabilities",
    "urn:asset:correction"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:percentage",
          "operator": "odrl:gteq",
          "rightOperand": 95
        },
        {
          "leftOperand": "odrl:virtualLocation",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "edge",
            "on-prem",
            "certified_archival_workstation"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "publish",
      "constraint": [
        {
          "leftOperand": "odrl:dateTime",
          "operator": "odrl:gteq",
          "rightOperand": "2026-02-26"
        },
        {
          "leftOperand": "odrl:delayPeriod",
          "operator": "odrl:lteq",
          "rightOperand": "PT0S"
        },
        {
          "leftOperand": "odrl:systemDevice",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "container",
            "consortium-approved",
            "videoPlatforms"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "completeCorrection",
      "constraint": [
        {
          "leftOperand": "odrl:dateTime",
          "operator": "odrl:gteq",
          "rightOperand": "2026-02-26"
        },
        {
          "leftOperand": "odrl:media",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "print",
            "web"
          ]
        },
        {
          "leftOperand": "odrl:recipient",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "third-party",
            "DesignatedDataServiceProvider",
            "drk:registeredUser"
          ]
        }
      ]
    }
  ]
}