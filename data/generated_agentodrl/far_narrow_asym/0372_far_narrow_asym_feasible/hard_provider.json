{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0372_far_narrow_asym:provider:hard",
  "assigner": "did:party:asset-owner",
  "assignee": [
    "did:party:traffic-data-user"
  ],
  "target": [
    "urn:asset:urban-traffic-sensor-feeds"
  ],
  "permission": [
    {
      "action": "distribute",
      "constraint": [
        {
          "leftOperand": "odrl:authorizationLevel",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "gold"
          ]
        },
        {
          "leftOperand": "odrl:samplingRate",
          "operator": "odrl:lteq",
          "rightOperand": 0.28
        },
        {
          "leftOperand": "odrl:spatialResolution",
          "operator": "odrl:gteq",
          "rightOperand": 201
        }
      ]
    },
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:authorizationLevel",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "gold"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:percentage",
          "operator": "odrl:lteq",
          "rightOperand": 28
        },
        {
          "leftOperand": "odrl:language",
          "operator": "odrl:isNoneOf",
          "rightOperand": [
            "es"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:confidenceLevel",
          "operator": "odrl:gt",
          "rightOperand": 0.42
        },
        {
          "leftOperand": "odrl:deliveryChannel",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "courier"
          ]
        }
      ]
    }
  ]
}