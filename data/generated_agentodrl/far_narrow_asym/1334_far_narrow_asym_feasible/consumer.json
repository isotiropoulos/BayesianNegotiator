{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1334_far_narrow_asym:consumer:aspiration",
  "assigner": "did:party:audit-process",
  "assignee": [
    "did:party:counterparty"
  ],
  "target": [
    "urn:asset:audit-process",
    "urn:asset:all-participants"
  ],
  "permission": [
    {
      "action": "update",
      "constraint": [
        {
          "leftOperand": "odrl:legalRegulationOrStandardRevisionOrRelease",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "null"
          ]
        },
        {
          "leftOperand": "odrl:spatialResolution",
          "operator": "odrl:lteq",
          "rightOperand": 0
        },
        {
          "leftOperand": "odrl:purpose",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "commercial",
            "sharing",
            "Level 3 and above"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:payAmount",
          "operator": "odrl:lteq",
          "rightOperand": 0
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:legalRegulationOrStandardRevisionOrRelease",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "null"
          ]
        },
        {
          "leftOperand": "odrl:samplingRate",
          "operator": "odrl:gteq",
          "rightOperand": 0.9
        }
      ]
    },
    {
      "action": "update",
      "constraint": [
        {
          "leftOperand": "odrl:delayPeriod",
          "operator": "odrl:lteq",
          "rightOperand": "PT0S"
        },
        {
          "leftOperand": "odrl:legalRegulationOrStandardRevisionOrRelease",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "null"
          ]
        }
      ]
    }
  ]
}