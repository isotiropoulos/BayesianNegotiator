{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0104_far_narrow_asym:consumer:hard",
  "assigner": "did:party:data-space-owner",
  "assignee": [
    "did:party:registered-curators"
  ],
  "target": [
    "urn:asset:restoration-documentation-files",
    "urn:asset:all-servers"
  ],
  "permission": [
    {
      "action": "retrieve",
      "constraint": [
        {
          "leftOperand": "odrl:dateTime",
          "operator": "odrl:gteq",
          "rightOperand": "2024-03-11"
        },
        {
          "leftOperand": "odrl:accessLocation",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "certifiedArchivalServers",
            "Gaia-X Trusted Zone"
          ]
        },
        {
          "leftOperand": "odrl:percentage",
          "operator": "odrl:gteq",
          "rightOperand": 18
        },
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:neq",
          "rightOperand": "US"
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "access",
      "constraint": [
        {
          "leftOperand": "odrl:accessLocation",
          "operator": "odrl:eq",
          "rightOperand": "Gaia-X Trusted Zone"
        },
        {
          "leftOperand": "odrl:version",
          "operator": "odrl:lt",
          "rightOperand": 3
        },
        {
          "leftOperand": "odrl:deliveryChannel",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "kafka",
            "s3",
            "SupportChannel"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:samplingRate",
          "operator": "odrl:gteq",
          "rightOperand": 0.25
        }
      ]
    }
  ]
}