{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Agreement",
  "@id": "urn:witness",
  "assigner": "did:party:policy-owner",
  "assignee": [
    "did:party:authorized-user"
  ],
  "target": [
    "urn:asset:sme-credit-risk-dataset"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:accessLevel",
          "operator": "odrl:eq",
          "rightOperand": "differentiated"
        },
        {
          "leftOperand": "odrl:payAmount",
          "operator": "odrl:eq",
          "rightOperand": 1099
        },
        {
          "leftOperand": "odrl:meteredTime",
          "operator": "odrl:eq",
          "rightOperand": "P23DT1H44M55.946S"
        },
        {
          "leftOperand": "odrl:recipient",
          "operator": "odrl:eq",
          "rightOperand": "//example.org/parties/agriTechCompany"
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:samplingRate",
          "operator": "odrl:eq",
          "rightOperand": 0.7
        },
        {
          "leftOperand": "odrl:media",
          "operator": "odrl:eq",
          "rightOperand": "print"
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:timeInterval",
          "operator": "odrl:eq",
          "rightOperand": "P2DT20H7M49.497S"
        },
        {
          "leftOperand": "odrl:virtualLocation",
          "operator": "odrl:eq",
          "rightOperand": "eu-cloud"
        }
      ]
    }
  ]
