{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Agreement",
  "@id": "urn:witness",
  "assigner": "did:party:policy-owner",
  "assignee": [
    "did:party:all-accessors"
  ],
  "target": [
    "urn:asset:building-permit-records"
