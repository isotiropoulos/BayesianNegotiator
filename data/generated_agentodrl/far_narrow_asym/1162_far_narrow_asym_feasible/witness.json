      "constraint": [
        {
          "leftOperand": "odrl:dataValidityIssueResolvedTimestamp",
          "operator": "odrl:eq",
          "rightOperand": "2023-05-02"
        },
        {
          "leftOperand": "odrl:delayPeriod",
          "operator": "odrl:eq",
          "rightOperand": "P8DT18H26M44.192S"
        },
        {
          "leftOperand": "odrl:recipient",
          "operator": "odrl:eq",
          "rightOperand": "third-party"
        },
        {
          "leftOperand": "odrl:virtualLocation",
          "operator": "odrl:eq",
          "rightOperand": "hybrid"
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:percentage",
          "operator": "odrl:eq",
          "rightOperand": 30
        },
        {
          "leftOperand": "odrl:industry",
          "operator": "odrl:eq",
          "rightOperand": "energy"
