{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0737_far_narrow_asym:consumer:hard",
  "assigner": "did:party:grid-watch-system",
  "assignee": [
    "did:party:distributor-party"
  ],
  "target": [
    "urn:asset:live-grid-load-metrics-data"
  ],
  "permission": [
    {
      "action": "distribute",
      "constraint": [
        {
          "leftOperand": "odrl:dataSource",
          "operator": "odrl:neq",
          "rightOperand": "null"
        },
        {
          "leftOperand": "odrl:resolution",
          "operator": "odrl:lteq",
          "rightOperand": 14
        },
        {
          "leftOperand": "odrl:confidenceLevel",
          "operator": "odrl:lt",
          "rightOperand": 0.14
        },
        {
          "leftOperand": "odrl:event",
          "operator": "odrl:neq",
          "rightOperand": "termination"
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:meteredTime",
          "operator": "odrl:gt",
          "rightOperand": "P20DT21H24M45.007S"
        },
        {
          "leftOperand": "odrl:language",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "de",
            "el",
            "fr"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:version",
          "operator": "odrl:lteq",
          "rightOperand": 2
        },
        {
          "leftOperand": "odrl:systemDevice",
          "operator": "odrl:neq",
          "rightOperand": "bare-metal"
        }
      ]
    }
  ]
}