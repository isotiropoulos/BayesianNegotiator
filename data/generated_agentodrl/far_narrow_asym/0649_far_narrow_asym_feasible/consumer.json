{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0649_far_narrow_asym:consumer:aspiration",
  "assigner": "did:party:data-owner",
  "assignee": [
    "did:party:public"
  ],
  "target": [
    "urn:asset:brain-mriscan-data"
  ],
  "permission": [
    {
      "action": "distribute",
      "constraint": [
        {
          "leftOperand": "odrl:delayPeriod",
          "operator": "odrl:lteq",
          "rightOperand": "PT0S"
        },
        {
          "leftOperand": "odrl:confidenceLevel",
          "operator": "odrl:lteq",
          "rightOperand": 0.0
        },
        {
          "leftOperand": "odrl:event",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "breach",
            "audit"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "publish",
      "constraint": [
        {
          "leftOperand": "odrl:releaseDate",
          "operator": "odrl:gteq",
          "rightOperand": "P234D"
        },
        {
          "leftOperand": "odrl:percentage",
          "operator": "odrl:gteq",
          "rightOperand": 89
        },
        {
          "leftOperand": "odrl:media",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "print",
            "web"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "CH",
            "中华人民共和国境内",
            "online privacy policy"
          ]
        },
        {
          "leftOperand": "odrl:virtualLocation",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "eu-cloud",
            "hybrid",
            "http://example.org/servers"
          ]
        }
      ]
    }
  ]
}