{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1449_far_narrow_asym:provider:hard",
  "assigner": "did:party:policy-owner",
  "assignee": [
    "did:party:platform-api"
  ],
  "target": [
    "urn:asset:gn-energy-usage-peak-load-score"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:absoluteSpatialPosition",
          "operator": "odrl:neq",
          "rightOperand": "domestic"
        },
        {
          "leftOperand": "odrl:version",
          "operator": "odrl:gt",
          "rightOperand": 1
        },
        {
          "leftOperand": "odrl:samplingRate",
          "operator": "odrl:lt",
          "rightOperand": 0.27
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "distribute",
      "constraint": [
        {
          "leftOperand": "odrl:bulkExport",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "False"
          ]
        },
        {
          "leftOperand": "odrl:share",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "False"
          ]
        },
        {
          "leftOperand": "odrl:absoluteTemporalPosition",
          "operator": "odrl:lt",
          "rightOperand": "2027-01-20"
        },
        {
          "leftOperand": "odrl:systemDevice",
          "operator": "odrl:isNoneOf",
          "rightOperand": [
            "bare-metal"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:unitOfCount",
          "operator": "odrl:lt",
          "rightOperand": 1450
        }
      ]
    }
  ]
}