{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Agreement",
  "@id": "urn:witness",
  "assigner": "did:party:policy-owner",
  "assignee": [
    "did:party:counterparty"
  ],
  "target": [
    "urn:asset:data-handling-asset"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:entityNameOrRepresentativeInfo",
          "operator": "odrl:eq",
          "rightOperand": "name of entity or name and contact info of representative"
        },
        {
          "leftOperand": "odrl:confidenceLevel",
          "operator": "odrl:eq",
          "rightOperand": 0.11
        },
        {
          "leftOperand": "odrl:count",
          "operator": "odrl:eq",
          "rightOperand": 636090
        },
        {
          "leftOperand": "odrl:purpose",
          "operator": "odrl:eq",
          "rightOperand": "statistics"
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:version",
          "operator": "odrl:eq",
          "rightOperand": 1
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:eq",
          "rightOperand": "SubstationOperationData"
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:percentage",
          "operator": "odrl:eq",
          "rightOperand": 77
        },
        {
          "leftOperand": "odrl:systemDevice",
          "operator": "odrl:eq",
          "rightOperand": "bare-metal"
        }
      ]
    }
  ]
}