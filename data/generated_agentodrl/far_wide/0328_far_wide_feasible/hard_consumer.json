{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0328_far_wide:consumer:hard",
  "assigner": "did:party:policy-owner-party",
  "assignee": [
    "did:party:counterparty"
  ],
  "target": [
    "urn:asset:catena-xnetwork-asset"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:elapsedTime",
          "operator": "odrl:gt",
          "rightOperand": "P47DT1H48M21.251S"
        },
        {
          "leftOperand": "odrl:confidenceLevel",
          "operator": "odrl:lteq",
          "rightOperand": 0.35
        },
        {
          "leftOperand": "odrl:virtualLocation",
          "operator": "odrl:eq",
          "rightOperand": "air-gapped"
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "//example.org/forbiddenAction",
      "constraint": [
        {
          "leftOperand": "odrl:purpose",
          "operator": "odrl:eq",
          "rightOperand": "substation-specific"
        },
        {
          "leftOperand": "odrl:absoluteTemporalPosition",
          "operator": "odrl:gt",
          "rightOperand": "2027-05-12"
        },
        {
          "leftOperand": "odrl:event",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "breach",
            "renewal"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:unitOfCount",
          "operator": "odrl:gt",
          "rightOperand": 2038
        },
        {
          "leftOperand": "odrl:systemDevice",
          "operator": "odrl:neq",
          "rightOperand": "bare-metal"
        }
      ]
    }
  ]
