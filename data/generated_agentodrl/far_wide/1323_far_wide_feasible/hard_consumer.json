{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1323_far_wide:consumer:hard",
  "assigner": "did:party:policy-owner",
  "assignee": [
    "did:party:data-owner"
  ],
  "target": [
    "urn:asset:transport-trajectory-data"
  ],
  "permission": [
    {
      "action": "resubmit",
      "constraint": [
        {
          "leftOperand": "odrl:samplingFailureRate",
          "operator": "odrl:lt",
          "rightOperand": 4
        },
        {
          "leftOperand": "odrl:version",
          "operator": "odrl:lteq",
          "rightOperand": 2
        },
        {
          "leftOperand": "odrl:language",
          "operator": "odrl:eq",
          "rightOperand": "el"
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "distribute",
      "constraint": [
        {
          "leftOperand": "odrl:samplingFailureRate",
          "operator": "odrl:lt",
          "rightOperand": 4
        },
        {
          "leftOperand": "odrl:event",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "audit",
            "termination"
          ]
        },
        {
          "leftOperand": "odrl:virtualLocation",
          "operator": "odrl:neq",
          "rightOperand": "edge"
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "resubmit",
      "constraint": [
        {
          "leftOperand": "odrl:samplingFailureRate",
          "operator": "odrl:lt",
          "rightOperand": 4
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "CSV"
          ]
        }
      ]
    }
  ]
}