{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1673_far_wide:provider:hard",
  "assigner": "did:party:policy-issuer",
  "assignee": [
    "did:party:video-streaming-platform"
  ],
  "target": [
    "urn:asset:personal-information-of-viewers"
  ],
  "permission": [
    {
      "action": "sell",
      "constraint": [
        {
          "leftOperand": "odrl:age",
          "operator": "odrl:lt",
          "rightOperand": 32
        },
        {
          "leftOperand": "odrl:confidenceLevel",
          "operator": "odrl:gt",
          "rightOperand": 0.22
        },
        {
          "leftOperand": "odrl:recipient",
          "operator": "odrl:neq",
          "rightOperand": "regulator"
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "sell",
      "constraint": [
        {
          "leftOperand": "odrl:age",
          "operator": "odrl:lt",
          "rightOperand": 26
        },
        {
          "leftOperand": "odrl:resolution",
          "operator": "odrl:gt",
          "rightOperand": 33
        },
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:isNoneOf",
          "rightOperand": [
            "global"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:language",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "el",
            "fr",
            "de"
          ]
        },
        {
          "leftOperand": "odrl:virtualLocation",
          "operator": "odrl:neq",
          "rightOperand": "air-gapped"
        }
      ]
    }
  ]
}