{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1148_far_wide:provider:aspiration",
  "assigner": "did:party:regulatory-body",
  "assignee": [
    "did:party:green-grid-analytics"
  ],
  "target": [
    "urn:asset:eu-energy-usage"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:environment",
          "operator": "odrl:eq",
          "rightOperand": "Gaia-X Trusted Zone"
        },
        {
          "leftOperand": "odrl:requirement",
          "operator": "odrl:hasPart",
          "rightOperand": "attestation:CrossBorderCompliance"
        },
        {
          "leftOperand": "odrl:timeInterval",
          "operator": "odrl:lteq",
          "rightOperand": "P13DT22H17M27.802S"
        },
        {
          "leftOperand": "odrl:spatialResolution",
          "operator": "odrl:lteq",
          "rightOperand": 252
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:resolution",
          "operator": "odrl:lteq",
          "rightOperand": 79
        },
        {
          "leftOperand": "odrl:language",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "fr",
            "es",
            "en"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:relativeTemporalPosition",
          "operator": "odrl:lteq",
          "rightOperand": "2026-04-14"
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "PARQUET",
            "XLSX",
            "XML"
          ]
        }
      ]
    }
  ]
}