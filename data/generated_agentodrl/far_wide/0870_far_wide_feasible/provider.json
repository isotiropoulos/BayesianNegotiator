{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0870_far_wide:provider:aspiration",
  "assigner": "did:party:steward-of-cu-j-449",
  "assignee": [
    "did:party:counterparty"
  ],
  "target": [
    "urn:asset:content",
    "urn:asset:user-account"
  ],
  "permission": [
    {
      "action": "delete",
      "constraint": [
        {
          "leftOperand": "odrl:content",
          "operator": "odrl:eq",
          "rightOperand": "allegedInfringement"
        },
        {
          "leftOperand": "odrl:meteredTime",
          "operator": "odrl:lteq",
          "rightOperand": "P1DT14H20M58.02S"
        },
        {
          "leftOperand": "odrl:relativeTemporalPosition",
          "operator": "odrl:lteq",
          "rightOperand": "2026-03-17"
        },
        {
          "leftOperand": "odrl:virtualLocation",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "hybrid",
            "air-gapped",
            "us-cloud"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:version",
          "operator": "odrl:lteq",
          "rightOperand": 4
        },
        {
          "leftOperand": "odrl:purpose",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "journalism",
            "statistics",
            "research"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:percentage",
          "operator": "odrl:lteq",
          "rightOperand": 8
        },
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "US",
            "global",
            "UK"
          ]
        }
      ]
    }
  ]
}