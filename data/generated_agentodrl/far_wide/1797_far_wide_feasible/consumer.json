{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1797_far_wide:consumer:aspiration",
  "assigner": "did:party:platform-authority",
  "assignee": [
    "did:party:research-sub-center"
  ],
  "target": [
    "urn:asset:data-protection-entity",
    "urn:asset:ethics-review-board"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:confidenceLevel",
          "operator": "odrl:lteq",
          "rightOperand": 0.0
        },
        {
          "leftOperand": "odrl:relativeTemporalPosition",
          "operator": "odrl:lteq",
          "rightOperand": "2023-12-12"
        },
        {
          "leftOperand": "odrl:recipient",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "consortium",
            "drk:ExternalConsultant",
            "local_minimum_age_of_consent"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:delayPeriod",
          "operator": "odrl:lteq",
          "rightOperand": "PT0S"
        },
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "UK",
            "http://w3id.org/drk:CatenaXTrustedZone",
            "Gaia-X Trusted Zone"
          ]
        },
        {
          "leftOperand": "odrl:media",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "web",
            "print"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:version",
          "operator": "odrl:lteq",
          "rightOperand": 0
        },
        {
          "leftOperand": "odrl:deliveryChannel",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "s3",
            "courier",
            "SupportChannel"
          ]
        }
      ]
    }
  ]
}