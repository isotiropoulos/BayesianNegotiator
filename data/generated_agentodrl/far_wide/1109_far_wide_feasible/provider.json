{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1109_far_wide:provider:aspiration",
  "assigner": "did:party:policy-owner",
  "assignee": [
    "did:party:visitor"
  ],
  "target": [
    "urn:asset:detailed-logs-asset",
    "urn:asset:analytics-consent"
  ],
  "permission": [
    {
      "action": "view",
      "constraint": [
        {
          "leftOperand": "odrl:consentToAnalytics",
          "operator": "odrl:eq",
          "rightOperand": true
        },
        {
          "leftOperand": "odrl:version",
          "operator": "odrl:lteq",
          "rightOperand": 4
        },
        {
          "leftOperand": "odrl:relativeTemporalPosition",
          "operator": "odrl:lteq",
          "rightOperand": "2026-03-15"
        },
        {
          "leftOperand": "odrl:virtualLocation",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "on-prem",
            "hybrid",
            "eu-cloud"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:samplingRate",
          "operator": "odrl:lteq",
          "rightOperand": 0.07
        },
        {
          "leftOperand": "odrl:systemDevice",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "vm",
            "hsm",
            "bare-metal"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:meteredTime",
          "operator": "odrl:lteq",
          "rightOperand": "P3DT23H8M45.193S"
        },
        {
          "leftOperand": "odrl:event",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "renewal",
            "termination",
            "breach"
          ]
        }
      ]
    }
  ]
}