{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0038_far_wide:provider:hard",
  "assigner": "did:party:policy-owner",
  "assignee": [
    "did:party:commercial-entity"
  ],
  "target": [
    "urn:asset:digital-revolution-posters-asset"
  ],
  "permission": [
    {
      "action": "distribute",
      "constraint": [
        {
          "leftOperand": "odrl:count",
          "operator": "odrl:lt",
          "rightOperand": 1
        },
        {
          "leftOperand": "odrl:timeInterval",
          "operator": "odrl:gteq",
          "rightOperand": "P5DT12H1M14.028S"
        },
        {
          "leftOperand": "odrl:deliveryChannel",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "s3"
          ]
        },
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:neq",
          "rightOperand": "global"
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:absoluteTemporalPosition",
          "operator": "odrl:lt",
          "rightOperand": "2028-03-18"
        },
        {
          "leftOperand": "odrl:event",
          "operator": "odrl:neq",
          "rightOperand": "termination"
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:elapsedTime",
          "operator": "odrl:lt",
          "rightOperand": "P65DT6H8M14.942S"
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:eq",
          "rightOperand": "JSON"
        }
      ]
    }
  ]
}