            "Paid subscription service",
            "household energy efficiency analysis and optimization"
          ]
        },
        {
          "leftOperand": "odrl:resolution",
          "operator": "odrl:lteq",
          "rightOperand": 0
        },
        {
          "leftOperand": "odrl:media",
