{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0962_far_wide:consumer:aspiration",
  "assigner": "did:party:data-access-controller",
  "assignee": [
    "did:party:counterparty"
  ],
  "target": [
    "urn:asset:data-access"
  ],
  "permission": [
    {
      "action": "freezeDataAccess",
      "constraint": [
        {
          "leftOperand": "odrl:evidenceSubmissionDeadline",
          "operator": "odrl:gteq",
          "rightOperand": "P26D"
        },
        {
          "leftOperand": "odrl:unitOfCount",
          "operator": "odrl:gteq",
          "rightOperand": 3697
        },
        {
          "leftOperand": "odrl:media",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "internal-wiki",
            "broadcast"
          ]
        },
        {
          "leftOperand": "odrl:virtualLocation",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "edge",
            "us-cloud",
            "http://example.org/servers"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:delayPeriod",
          "operator": "odrl:lteq",
          "rightOperand": "PT0S"
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "XLSX",
            "low-resolution images",
            "granular, real-time consumption"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:timeInterval",
          "operator": "odrl:lteq",
          "rightOperand": "PT0S"
        },
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "global",
            "EEA",
            "European Union"
          ]
        }
      ]
    }
  ]
}