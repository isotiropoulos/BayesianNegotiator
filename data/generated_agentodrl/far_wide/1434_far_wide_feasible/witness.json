{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Agreement",
  "@id": "urn:witness",
  "assigner": "did:party:data-owner-party",
  "assignee": [
    "did:party:data-owner"
  ],
  "target": [
    "urn:asset:data"
  ],
  "permission": [
    {
      "action": "delete",
      "constraint": [
        {
          "leftOperand": "odrl:deletionType",
          "operator": "odrl:eq",
          "rightOperand": "permanent"
        },
        {
          "leftOperand": "odrl:unitOfCount",
          "operator": "odrl:eq",
          "rightOperand": 1683
        },
        {
          "leftOperand": "odrl:relativeTemporalPosition",
          "operator": "odrl:eq",
          "rightOperand": "2025-01-09"
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "delete",
      "constraint": [
        {
          "leftOperand": "odrl:deletionReversibility",
          "operator": "odrl:eq",
          "rightOperand": "reversible"
        },
        {
          "leftOperand": "odrl:percentage",
          "operator": "odrl:eq",
          "rightOperand": 55
        },
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:eq",
          "rightOperand": "CentralEuropeanCountries"
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:resolution",
          "operator": "odrl:eq",
          "rightOperand": 20
        },
        {
          "leftOperand": "odrl:media",
          "operator": "odrl:eq",
          "rightOperand": "print"
        }
      ]
    }
  ]
}