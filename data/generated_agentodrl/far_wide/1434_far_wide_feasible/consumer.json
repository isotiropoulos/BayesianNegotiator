{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1434_far_wide:consumer:aspiration",
  "assigner": "did:party:data-owner-party",
  "assignee": [
    "did:party:data-owner"
  ],
  "target": [
    "urn:asset:data"
  ],
  "permission": [
    {
      "action": "delete",
      "constraint": [
        {
          "leftOperand": "odrl:deletionType",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "permanent"
          ]
        },
        {
          "leftOperand": "odrl:unitOfCount",
          "operator": "odrl:gteq",
          "rightOperand": 2431
        },
        {
          "leftOperand": "odrl:relativeTemporalPosition",
          "operator": "odrl:lteq",
          "rightOperand": "2023-10-29"
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "delete",
      "constraint": [
        {
          "leftOperand": "odrl:deletionReversibility",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "reversible"
          ]
        },
        {
          "leftOperand": "odrl:percentage",
          "operator": "odrl:gteq",
          "rightOperand": 95
        },
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "UK",
            "CentralEuropeanCountries",
            "online privacy policy"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:resolution",
          "operator": "odrl:lteq",
          "rightOperand": 0
        },
        {
          "leftOperand": "odrl:media",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "print",
            "broadcast"
          ]
        }
      ]
    }
  ]
}