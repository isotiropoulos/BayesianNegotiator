{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0660_far_wide:provider:hard",
  "assigner": "did:party:energy-data-owner",
  "assignee": [
    "did:party:public-data-feed"
  ],
  "target": [
    "urn:asset:wind-turbine-metrics",
    "urn:asset:aggregated-results"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:absoluteTemporalPosition",
          "operator": "odrl:lteq",
          "rightOperand": "2028-05-12"
        },
        {
          "leftOperand": "odrl:purpose",
          "operator": "odrl:neq",
          "rightOperand": "audit"
        },
        {
          "leftOperand": "odrl:virtualLocation",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "us-cloud",
            "eu-cloud",
            "hybrid"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:version",
          "operator": "odrl:gteq",
          "rightOperand": 0
        },
        {
          "leftOperand": "odrl:media",
          "operator": "odrl:neq",
          "rightOperand": "internal-wiki"
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "delayedResult",
      "constraint": [
        {
          "leftOperand": "odrl:delayPeriod",
          "operator": "odrl:gteq",
          "rightOperand": "PT9H17M13.426S"
        },
        {
          "leftOperand": "odrl:samplingRate",
          "operator": "odrl:lteq",
          "rightOperand": 0.69
        },
        {
          "leftOperand": "odrl:language",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "es"
          ]
        }
      ]
    }
  ]
}