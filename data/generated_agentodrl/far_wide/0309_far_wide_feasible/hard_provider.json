{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0309_far_wide:provider:hard",
  "assigner": "did:party:european-genomics-network",
  "assignee": [
    "did:party:licensed-geneticists"
  ],
  "target": [
    "urn:asset:de-identified-genomic-sequences"
  ],
  "permission": [
    {
      "action": "examine",
      "constraint": [
        {
          "leftOperand": "odrl:hasQualification",
          "operator": "odrl:eq",
          "rightOperand": "up-to-date compliance training"
        },
        {
          "leftOperand": "odrl:unitOfCount",
          "operator": "odrl:lt",
          "rightOperand": 1907
        },
        {
          "leftOperand": "odrl:percentage",
          "operator": "odrl:lteq",
          "rightOperand": 63
        },
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:isNoneOf",
          "rightOperand": [
            "global"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:samplingRate",
          "operator": "odrl:lt",
          "rightOperand": 0.59
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:isNoneOf",
          "rightOperand": [
            "XLSX"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:count",
          "operator": "odrl:lteq",
          "rightOperand": 624100
        },
        {
          "leftOperand": "odrl:language",
          "operator": "odrl:neq",
          "rightOperand": "fr"
        }
      ]
    }
  ]
}