{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1562_far_wide:consumer:hard",
  "assigner": "did:party:owner",
  "assignee": [
    "did:party:stakeholders"
  ],
  "target": [
    "urn:asset:application-outcomes-summary",
    "urn:asset:payment-into-sustainability-trust"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:spatialResolution",
          "operator": "odrl:lt",
          "rightOperand": 323
        },
        {
          "leftOperand": "odrl:systemDevice",
          "operator": "odrl:eq",
          "rightOperand": "bare-metal"
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:resolution",
          "operator": "odrl:lt",
          "rightOperand": 23
        },
        {
          "leftOperand": "odrl:media",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "web",
            "internal-wiki"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "distribute",
      "constraint": [
        {
          "leftOperand": "odrl:dateTime",
          "operator": "odrl:gt",
          "rightOperand": "2024-05-27"
        },
        {
          "leftOperand": "odrl:count",
          "operator": "odrl:gteq",
          "rightOperand": 254912
        },
        {
          "leftOperand": "odrl:recipient",
          "operator": "odrl:eq",
          "rightOperand": "third-party"
        }
      ]
    },
    {
      "action": "pay",
      "constraint": [
        {
          "leftOperand": "odrl:purpose",
          "operator": "odrl:neq",
          "rightOperand": "audit"
        }
      ]
    }
  ]
