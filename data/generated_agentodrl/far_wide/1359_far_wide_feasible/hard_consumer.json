          "rightOperand": "complete"
        },
        {
          "leftOperand": "odrl:informationCorrectness",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "correct"
          ]
        },
        {
          "leftOperand": "odrl:count",
          "operator": "odrl:gt",
          "rightOperand": 222363
