{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1359_far_wide:consumer:aspiration",
  "assigner": "did:party:registration-owner",
  "assignee": [
    "did:party:counterparty"
  ],
  "target": [
    "urn:asset:asset-registration"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:informationCompleteness",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "complete"
          ]
        },
        {
          "leftOperand": "odrl:informationCorrectness",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "correct"
          ]
        },
        {
          "leftOperand": "odrl:count",
          "operator": "odrl:gteq",
          "rightOperand": 427586
        },
        {
          "leftOperand": "odrl:samplingRate",
          "operator": "odrl:gteq",
          "rightOperand": 0.86
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:absoluteTemporalPosition",
          "operator": "odrl:gteq",
          "rightOperand": "2028-09-29"
        },
        {
          "leftOperand": "odrl:virtualLocation",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "us-cloud",
            "eu-cloud",
            "FrenchIP"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:timeInterval",
          "operator": "odrl:lteq",
          "rightOperand": "PT0S"
        },
        {
          "leftOperand": "odrl:recipient",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "consortium",
            "Farmers",
            "ResponsiblePersonnel"
          ]
        }
      ]
    }
  ]
}