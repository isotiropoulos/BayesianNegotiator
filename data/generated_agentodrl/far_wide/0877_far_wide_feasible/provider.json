{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0877_far_wide:provider:aspiration",
  "assigner": "did:party:policy-owner",
  "assignee": [
    "did:party:registered-drone-operators"
  ],
  "target": [
    "urn:asset:alpine-geohazard",
    "urn:asset:raw-data-files"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:spatialResolution",
          "operator": "odrl:lteq",
          "rightOperand": 639
        },
        {
          "leftOperand": "odrl:virtualLocation",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "edge",
            "on-prem",
            "eu-cloud"
          ]
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "XLSX",
            "RDF",
            "PARQUET"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "access",
      "constraint": [
        {
          "leftOperand": "odrl:dateTime",
          "operator": "odrl:lteq",
          "rightOperand": 72
        },
        {
          "leftOperand": "odrl:payAmount",
          "operator": "odrl:lteq",
          "rightOperand": 6885
        },
        {
          "leftOperand": "odrl:media",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "broadcast",
            "print",
            "web"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:samplingRate",
          "operator": "odrl:lteq",
          "rightOperand": 0.14
        },
        {
          "leftOperand": "odrl:event",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "breach",
            "termination",
            "renewal"
          ]
        }
      ]
    }
  ]
}