{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0425_far_wide:provider:hard",
  "assigner": "did:party:content-owner",
  "assignee": [
    "did:party:generative-ai"
  ],
  "target": [
    "urn:asset:derivatives"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:unitOfCount",
          "operator": "odrl:lteq",
          "rightOperand": 1695
        },
        {
          "leftOperand": "odrl:samplingRate",
          "operator": "odrl:lteq",
          "rightOperand": 0.7
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "distribute",
      "constraint": [
        {
          "leftOperand": "odrl:trainingDataSource",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "Louvre Museum Open Collection Images"
          ]
        },
        {
          "leftOperand": "odrl:networkScope",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "Gaia-X Creative Industries Network"
          ]
        },
        {
          "leftOperand": "odrl:payAmount",
          "operator": "odrl:gteq",
          "rightOperand": 1001
        },
        {
          "leftOperand": "odrl:recipient",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "third-party"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:percentage",
          "operator": "odrl:lt",
          "rightOperand": 66
        },
        {
          "leftOperand": "odrl:event",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "termination"
          ]
        }
      ]
    }
  ]
}