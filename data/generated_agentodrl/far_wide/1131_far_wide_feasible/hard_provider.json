{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1131_far_wide:provider:hard",
  "assigner": "did:party:policy-issuer",
  "assignee": [
    "did:party:fin-guard"
  ],
  "target": [
    "urn:asset:smart-contract"
  ],
  "permission": [
    {
      "action": "distribute",
      "constraint": [
        {
          "leftOperand": "odrl:count",
          "operator": "odrl:lteq",
          "rightOperand": 105
        },
        {
          "leftOperand": "odrl:confidenceLevel",
          "operator": "odrl:gt",
          "rightOperand": 0.17
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:isNoneOf",
          "rightOperand": [
            "XLSX"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:version",
          "operator": "odrl:gt",
          "rightOperand": 0
        },
        {
          "leftOperand": "odrl:event",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "termination",
            "breach",
            "renewal"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "execute",
      "constraint": [
        {
          "leftOperand": "odrl:transactionType",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "subscription"
          ]
        },
        {
          "leftOperand": "odrl:delayPeriod",
          "operator": "odrl:gteq",
          "rightOperand": "P2DT12H25M30.691S"
        },
        {
          "leftOperand": "odrl:purpose",
          "operator": "odrl:neq",
          "rightOperand": "audit"
        }
      ]
    }
  ]
