  "permission": [
    {
      "action": "submitImpactDocumentation",
      "constraint": [
        {
          "leftOperand": "odrl:serviceInterruptionDuration",
          "operator": "odrl:lteq",
          "rightOperand": 0
        },
        {
          "leftOperand": "odrl:spatialResolution",
          "operator": "odrl:lteq",
          "rightOperand": 0
        },
        {
          "leftOperand": "odrl:event",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "audit",
            "breach"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:percentage",
          "operator": "odrl:gteq",
          "rightOperand": 95
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "CSV",
            "Farm-to-Fork Shipment Data",
            "JSON"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "submitImpactDocumentation",
      "constraint": [
        {
          "leftOperand": "odrl:serviceInterruptionDuration",
          "operator": "odrl:lteq",
          "rightOperand": 0
        },
        {
          "leftOperand": "odrl:purpose",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "education",
            "payment account numbers",
            "scientific research"
          ]
        },
        {
          "leftOperand": "odrl:industry",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "public",
            "国家工业安全",
            "health"
          ]
        }
      ]
    }
  ]
}