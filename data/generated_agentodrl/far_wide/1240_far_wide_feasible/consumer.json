{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1240_far_wide:consumer:aspiration",
  "assigner": "did:party:policy-owner",
  "assignee": [
    "did:party:active-diagnostic-tool-vendors-using-dataset"
  ],
  "target": [
    "urn:asset:clinical-trial-outcomes-dataset2022",
    "urn:asset:diagnostic-tool-vendor"
