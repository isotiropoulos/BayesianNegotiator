{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1645_far_wide:consumer:aspiration",
  "assigner": "did:party:policy-issuer",
  "assignee": [
    "did:party:borrowing-enterprise",
    "did:party:financial-institution"
  ],
  "target": [
    "urn:asset:enterprise-operational-data",
    "urn:asset:processing"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:delayPeriod",
          "operator": "odrl:lteq",
          "rightOperand": "PT0S"
        },
        {
          "leftOperand": "odrl:deliveryChannel",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "s3",
            "kafka",
            "SupportChannel"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "process",
      "constraint": [
        {
          "leftOperand": "odrl:grounds",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "grounds related to particular situation",
            "grounds relating to their particular situation"
          ]
        },
        {
          "leftOperand": "odrl:spatialResolution",
          "operator": "odrl:lteq",
          "rightOperand": 0
        },
        {
          "leftOperand": "odrl:virtualLocation",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "hybrid",
            "us-cloud",
            "EU Claims Aggregates"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "demonstrate",
      "constraint": [
        {
          "leftOperand": "odrl:grounds",
          "operator": "odrl:lteq",
          "rightOperand": 0
        },
        {
          "leftOperand": "odrl:samplingRate",
          "operator": "odrl:gteq",
          "rightOperand": 0.89
        },
        {
          "leftOperand": "odrl:systemDevice",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "hsm",
            "videoPlatforms",
            "secure research terminals"
          ]
        }
      ]
    }
  ]
}