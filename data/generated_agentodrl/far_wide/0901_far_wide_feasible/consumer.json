{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0901_far_wide:consumer:aspiration",
  "assigner": "did:party:policy-owner",
  "assignee": [
    "did:party:user"
  ],
  "target": [
    "urn:asset:account"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:resolution",
          "operator": "odrl:lteq",
          "rightOperand": 0
        },
        {
          "leftOperand": "odrl:unitOfCount",
          "operator": "odrl:gteq",
          "rightOperand": 1867
        },
        {
          "leftOperand": "odrl:recipient",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "third-party",
            "InsuranceCompany",
            "RegisteredShippingCompanies"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:payAmount",
          "operator": "odrl:lteq",
          "rightOperand": 0
        },
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "EU",
            "UserCountry",
            "DACH"
          ]
        },
        {
          "leftOperand": "odrl:systemDevice",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "tee",
            "authorized_mixed_reality_headset",
            "bare-metal"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:spatialResolution",
          "operator": "odrl:lteq",
          "rightOperand": 0
        },
        {
          "leftOperand": "odrl:virtualLocation",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "on-prem",
            "EU Claims Aggregates",
            "http://example.org/servers"
          ]
        }
      ]
    }
  ]
}