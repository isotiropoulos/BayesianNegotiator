{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0802_far_wide:consumer:aspiration",
  "assigner": "did:party:content-owner",
  "assignee": [
    "did:party:user"
  ],
  "target": [
    "urn:asset:alpine-traditional-music-database"
  ],
  "permission": [
    {
      "action": "play",
      "constraint": [
        {
          "leftOperand": "odrl:absoluteSpatialPosition",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "Eurozone",
            "EEA",
            "TerritoryX"
          ]
        },
        {
          "leftOperand": "odrl:spatialPosition",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "Eurozone"
          ]
        },
        {
          "leftOperand": "odrl:meteredTime",
          "operator": "odrl:gteq",
          "rightOperand": "P26DT22H11M50.342S"
        },
        {
          "leftOperand": "odrl:timeInterval",
          "operator": "odrl:lteq",
          "rightOperand": "PT0S"
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:delayPeriod",
          "operator": "odrl:lteq",
          "rightOperand": "PT0S"
        },
        {
          "leftOperand": "odrl:recipient",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "regulator",
            "European Union",
            "RegisteredShippingCompanies"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:spatialResolution",
          "operator": "odrl:lteq",
          "rightOperand": 0
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "PARQUET",
            "HourlyPollutionSensorReadings",
            "structured, commonly used, machine-readable"
          ]
        }
      ]
    }
  ]
}