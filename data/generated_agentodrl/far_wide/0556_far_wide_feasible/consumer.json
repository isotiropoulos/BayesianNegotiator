{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0556_far_wide:consumer:aspiration",
  "assigner": "did:party:policy-owner",
  "assignee": [
    "did:party:participating-institutions"
  ],
  "target": [
    "urn:asset:curated-coin-collection-data"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:elapsedTime",
          "operator": "odrl:gteq",
          "rightOperand": "P120DT11H6M13.326S"
        },
        {
          "leftOperand": "odrl:version",
          "operator": "odrl:lteq",
          "rightOperand": 0
        },
        {
          "leftOperand": "odrl:event",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "renewal",
            "breach"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "collect",
      "constraint": [
        {
          "leftOperand": "odrl:purpose",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "reputation",
            "VirtualExhibitionCreation",
            "asset allocation analysis"
          ]
        },
        {
          "leftOperand": "odrl:resolution",
          "operator": "odrl:lteq",
          "rightOperand": 0
        },
        {
          "leftOperand": "odrl:recipient",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "consortium",
            "authorized_dealership",
            "drk:SpecificSupplyChainManagementPlatform"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:timeInterval",
          "operator": "odrl:lteq",
          "rightOperand": "PT0S"
        },
        {
          "leftOperand": "odrl:media",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "print",
            "broadcast"
          ]
        }
      ]
    }
