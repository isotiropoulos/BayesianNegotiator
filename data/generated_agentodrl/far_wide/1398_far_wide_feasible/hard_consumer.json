{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1398_far_wide:consumer:hard",
  "assigner": "did:party:policy-owner",
  "assignee": [
    "did:party:policy-owner"
  ],
  "target": [
    "urn:asset:account"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:spatialResolution",
          "operator": "odrl:lteq",
          "rightOperand": 500
        },
        {
          "leftOperand": "odrl:resolution",
          "operator": "odrl:lt",
          "rightOperand": 27
        },
        {
          "leftOperand": "odrl:virtualLocation",
          "operator": "odrl:eq",
          "rightOperand": "hybrid"
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:version",
          "operator": "odrl:lteq",
          "rightOperand": 2
        },
        {
          "leftOperand": "odrl:purpose",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "education",
            "Description of Data Asset",
            "occupancy analytics"
          ]
        },
        {
          "leftOperand": "odrl:language",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "fr",
            "en",
            "de"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:confidenceLevel",
          "operator": "odrl:lt",
          "rightOperand": 0.38
        },
        {
          "leftOperand": "odrl:event",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "renewal"
          ]
        }
      ]
    }
  ]
}