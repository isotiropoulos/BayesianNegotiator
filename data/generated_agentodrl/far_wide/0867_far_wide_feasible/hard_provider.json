{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0867_far_wide:provider:hard",
  "assigner": "did:party:policy-issuer",
  "assignee": [
    "did:party:data-service-provider",
    "did:party:unauthorized-party"
  ],
  "target": [
    "urn:asset:personal-sensitive-data",
    "urn:asset:third-party-report"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:privacyParameter",
          "operator": "odrl:lteq",
          "rightOperand": 3.17
        },
        {
          "leftOperand": "odrl:resolution",
          "operator": "odrl:gteq",
          "rightOperand": 22
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "PARQUET",
            "XLSX",
            "XML"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "distribute",
      "constraint": [
        {
          "leftOperand": "odrl:privacyParameter",
          "operator": "odrl:lt",
          "rightOperand": 3.17
        },
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:isNoneOf",
          "rightOperand": [
            "global"
          ]
        },
        {
          "leftOperand": "odrl:language",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "de"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "submitReport",
      "constraint": [
        {
          "leftOperand": "odrl:privacyParameter",
          "operator": "odrl:lteq",
          "rightOperand": 3.17
        },
        {
          "leftOperand": "odrl:media",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "internal-wiki",
            "print",
            "broadcast"
          ]
        }
      ]
    }
  ]
}