{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1751_far_wide:provider:hard",
  "assigner": "did:party:steward-of-cu-p-733",
  "assignee": [
    "did:party:passenger"
  ],
  "target": [
    "urn:asset:travel-history-data-asset",
    "urn:asset:data-transfer-hindrance"
  ],
  "permission": [
    {
      "action": "distribute",
      "constraint": [
        {
          "leftOperand": "odrl:purpose",
          "operator": "odrl:isNoneOf",
          "rightOperand": [
            "audit"
          ]
        },
        {
          "leftOperand": "odrl:automated",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "True"
          ]
        },
        {
          "leftOperand": "odrl:recipient",
          "operator": "odrl:neq",
          "rightOperand": "regulator"
        },
        {
          "leftOperand": "odrl:elapsedTime",
          "operator": "odrl:lt",
          "rightOperand": "P100DT14H22M33.93S"
        },
        {
          "leftOperand": "odrl:percentage",
          "operator": "odrl:lt",
          "rightOperand": 60
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:payAmount",
          "operator": "odrl:gt",
          "rightOperand": 1896
        },
        {
          "leftOperand": "odrl:deliveryChannel",
          "operator": "odrl:isNoneOf",
          "rightOperand": [
            "courier"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:resolution",
          "operator": "odrl:gt",
          "rightOperand": 15
        }
      ]
    }
  ]
