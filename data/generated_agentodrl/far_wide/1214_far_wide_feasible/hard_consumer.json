{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1214_far_wide:consumer:hard",
  "assigner": "did:party:medical-ethics-board",
  "assignee": [
    "did:party:researcher-group"
  ],
  "target": [
    "urn:asset:cardio-scan-dataset",
    "urn:asset:research-articles"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:purpose",
          "operator": "odrl:neq",
          "rightOperand": "audit"
        },
        {
          "leftOperand": "odrl:timeInterval",
          "operator": "odrl:lt",
          "rightOperand": "P8DT22H6M0.356S"
        },
        {
          "leftOperand": "odrl:confidenceLevel",
          "operator": "odrl:lt",
          "rightOperand": 0.32
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "modify",
      "constraint": [
        {
          "leftOperand": "odrl:purpose",
          "operator": "odrl:isNoneOf",
          "rightOperand": [
            "audit"
          ]
        },
        {
          "leftOperand": "odrl:meteredTime",
          "operator": "odrl:gteq",
          "rightOperand": "P11DT20H42M55.73S"
        },
        {
          "leftOperand": "odrl:event",
          "operator": "odrl:isNoneOf",
          "rightOperand": [
            "termination"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:relativeTemporalPosition",
          "operator": "odrl:lt",
          "rightOperand": "2025-03-30"
        },
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "CH"
          ]
        }
      ]
    }
  ]
}