{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0220_far_wide:provider:aspiration",
  "assigner": "did:party:city-authority",
  "assignee": [
    "did:party:municipal-planning-authority"
  ],
  "target": [
    "urn:asset:smart-city-sensor-feed"
  ],
  "permission": [
    {
      "action": "distribute",
      "constraint": [
        {
          "leftOperand": "odrl:dateTime",
          "operator": "odrl:eq",
          "rightOperand": "immediate"
        },
        {
          "leftOperand": "odrl:version",
          "operator": "odrl:lteq",
          "rightOperand": 3
        },
        {
          "leftOperand": "odrl:resolution",
          "operator": "odrl:lteq",
          "rightOperand": 68
        },
        {
          "leftOperand": "odrl:deliveryChannel",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "courier",
            "kafka",
            "s3"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:meteredTime",
          "operator": "odrl:lteq",
          "rightOperand": "P3DT17H18M14.945S"
        },
        {
          "leftOperand": "odrl:virtualLocation",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "hybrid",
            "edge",
            "eu-cloud"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:timeInterval",
          "operator": "odrl:lteq",
          "rightOperand": "P21DT17H10M25.553S"
        },
        {
          "leftOperand": "odrl:language",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "es",
            "el",
            "de"
          ]
        }
      ]
    }
  ]
}