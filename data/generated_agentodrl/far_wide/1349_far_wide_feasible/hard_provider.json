{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1349_far_wide:provider:hard",
  "assigner": "did:party:smart-energy-owner",
  "assignee": [
    "did:party:account-creator"
