{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1816_far_wide:consumer:aspiration",
  "assigner": "did:party:policy-owner-party",
  "assignee": [
    "did:party:customer-territory-analysis-party"
  ],
  "target": [
    "urn:asset:large-value-transaction-data"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:confidenceLevel",
          "operator": "odrl:lteq",
          "rightOperand": 0.0
        },
        {
          "leftOperand": "odrl:version",
          "operator": "odrl:lteq",
          "rightOperand": 0
        },
        {
          "leftOperand": "odrl:recipient",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "third-party",
            "consortium",
            "//w3id.org/drk/MembershipVerificationParty"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:activityLocation",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "China",
            "network coverage area"
          ]
        },
        {
          "leftOperand": "odrl:relativeTemporalPosition",
          "operator": "odrl:lteq",
          "rightOperand": "2023-11-07"
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "XLSX",
            "RDF",
            "Farm-to-Fork Shipment Data"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:samplingRate",
          "operator": "odrl:gteq",
          "rightOperand": 0.93
        },
        {
          "leftOperand": "odrl:purpose",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "audit",
            "FacialRecognition",
            "rawResultsExport"
          ]
        }
      ]
    }
  ]
}