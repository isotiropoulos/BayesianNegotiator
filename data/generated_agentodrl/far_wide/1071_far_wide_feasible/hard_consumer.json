          "rightOperand": 0
        },
        {
          "leftOperand": "odrl:relativeTemporalPosition",
          "operator": "odrl:lt",
          "rightOperand": "2025-06-21"
        },
        {
          "leftOperand": "odrl:industry",
          "operator": "odrl:eq",
