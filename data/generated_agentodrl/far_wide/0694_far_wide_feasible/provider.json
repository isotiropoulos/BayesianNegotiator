{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0694_far_wide:provider:aspiration",
  "assigner": "did:party:policy-issuer",
  "assignee": [
    "did:party:researcher"
  ],
  "target": [
    "urn:asset:genomics-data-asset",
    "urn:asset:ethics-credentials-asset"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:confidenceLevel",
          "operator": "odrl:lteq",
          "rightOperand": 0.56
        },
        {
          "leftOperand": "odrl:version",
          "operator": "odrl:lteq",
          "rightOperand": 2
        },
        {
          "leftOperand": "odrl:media",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "web",
            "internal-wiki",
            "print"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:delayPeriod",
          "operator": "odrl:lteq",
          "rightOperand": "P13DT6H37M52.662S"
        },
        {
          "leftOperand": "odrl:event",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "breach",
            "renewal",
            "termination"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "maintain",
      "constraint": [
        {
          "leftOperand": "odrl:annualEthicsCredentials",
          "operator": "odrl:eq",
          "rightOperand": "up-to-date"
        },
        {
          "leftOperand": "odrl:percentage",
          "operator": "odrl:lteq",
          "rightOperand": 16
        },
        {
          "leftOperand": "odrl:purpose",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "commercial",
            "research",
            "marketing"
          ]
        }
      ]
    }
  ]
