{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1442_far_wide:consumer:hard",
  "assigner": "did:party:farm-owner-party",
  "assignee": [
    "did:party:farm-consent-party",
    "did:party:farm-no-consent-party"
  ],
  "target": [
    "urn:asset:real-time-video-stream",
    "urn:asset:anonymized-batch-footage"
  ],
  "permission": [
    {
      "action": "distribute",
      "constraint": [
        {
          "leftOperand": "odrl:farmConsent",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "drk:ConsentGiven"
          ]
        },
        {
          "leftOperand": "odrl:delayPeriod",
          "operator": "odrl:lt",
          "rightOperand": "P8DT15H17M8.825S"
        },
        {
          "leftOperand": "odrl:percentage",
          "operator": "odrl:gt",
          "rightOperand": 26
        },
        {
          "leftOperand": "odrl:virtualLocation",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "hybrid"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:confidenceLevel",
          "operator": "odrl:lteq",
          "rightOperand": 0.42
        },
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:eq",
          "rightOperand": "EU"
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:relativeTemporalPosition",
          "operator": "odrl:lt",
          "rightOperand": "2025-08-12"
        },
        {
          "leftOperand": "odrl:deliveryChannel",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "kafka",
            "courier",
            "s3"
          ]
        }
      ]
    }
  ]
}