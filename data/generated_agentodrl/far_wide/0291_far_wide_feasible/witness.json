{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Agreement",
  "@id": "urn:witness",
  "assigner": "did:party:air-quality-monitoring-data",
  "assignee": [
    "did:party:city-health-departments"
  ],
  "target": [
    "urn:asset:real-time-alert-dashboard",
    "urn:asset:detailed-sensor-datasets"
