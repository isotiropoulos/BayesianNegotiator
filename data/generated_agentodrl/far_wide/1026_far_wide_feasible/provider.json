{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1026_far_wide:provider:aspiration",
  "assigner": "did:party:policy-issuer",
  "assignee": [
    "did:party:user-under18"
  ],
  "target": [
    "urn:asset:content-asset",
    "urn:asset:parental-guardian"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:unitOfCount",
          "operator": "odrl:lteq",
          "rightOperand": 968
        },
        {
          "leftOperand": "odrl:spatialResolution",
          "operator": "odrl:lteq",
          "rightOperand": 482
        },
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "EEA",
            "global",
            "EU"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:percentage",
          "operator": "odrl:lteq",
          "rightOperand": 13
        },
        {
          "leftOperand": "odrl:language",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "el",
            "es",
            "de"
          ]
        },
        {
          "leftOperand": "odrl:media",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "web",
            "internal-wiki",
            "broadcast"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:absoluteTemporalPosition",
          "operator": "odrl:lteq",
          "rightOperand": "2026-06-19"
        },
        {
          "leftOperand": "odrl:industry",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "mobility",
            "finance",
            "retail"
          ]
        }
      ]
    }
  ]
}