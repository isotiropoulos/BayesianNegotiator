          "rightOperand": [
            "es",
            "en",
            "de"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:meteredTime",
          "operator": "odrl:lteq",
