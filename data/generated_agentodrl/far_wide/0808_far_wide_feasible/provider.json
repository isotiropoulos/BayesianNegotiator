  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:count",
          "operator": "odrl:lteq",
          "rightOperand": 286827
        },
        {
          "leftOperand": "odrl:deliveryChannel",
