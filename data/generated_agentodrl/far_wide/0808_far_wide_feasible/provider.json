          "operator": "odrl:lteq",
          "rightOperand": 689
        },
        {
          "leftOperand": "odrl:absoluteTemporalPosition",
          "operator": "odrl:lteq",
          "rightOperand": "2026-07-03"
        },
        {
          "leftOperand": "odrl:language",
