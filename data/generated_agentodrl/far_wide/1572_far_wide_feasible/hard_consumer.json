            "third-party"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:percentage",
          "operator": "odrl:gt",
          "rightOperand": 41
        },
        {
          "leftOperand": "odrl:media",
          "operator": "odrl:eq",
          "rightOperand": "web"
        },
        {
          "leftOperand": "odrl:event",
          "operator": "odrl:neq",
