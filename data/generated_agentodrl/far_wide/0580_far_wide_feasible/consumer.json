{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0580_far_wide:consumer:aspiration",
  "assigner": "did:party:steward-of-su-314",
  "assignee": [
    "did:party:south-american-biodiversity-council"
  ],
  "target": [
    "urn:asset:threatened-tree-species-database",
    "urn:asset:quarterly-utilization-reports"
  ],
  "permission": [
    {
      "action": "retrieve",
      "constraint": [
        {
          "leftOperand": "odrl:quarterlyUtilizationReports",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "true"
          ]
        },
        {
          "leftOperand": "odrl:timeInterval",
          "operator": "odrl:lteq",
          "rightOperand": "PT0S"
        },
        {
          "leftOperand": "odrl:confidenceLevel",
          "operator": "odrl:lteq",
          "rightOperand": 0.0
        },
        {
          "leftOperand": "odrl:virtualLocation",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "eu-cloud",
            "EU Claims Aggregates",
            "edge"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:meteredTime",
          "operator": "odrl:gteq",
          "rightOperand": "P26DT15H51M20.353S"
        },
        {
          "leftOperand": "odrl:language",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "es",
            "de",
            "el"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:relativeTemporalPosition",
          "operator": "odrl:lteq",
          "rightOperand": "2023-12-19"
        },
        {
          "leftOperand": "odrl:industry",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "finance",
            "retail",
            "医院数据提供方"
          ]
        }
      ]
    }
  ]
}