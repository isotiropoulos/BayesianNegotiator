{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0996_far_wide:provider:aspiration",
  "assigner": "did:party:policy-owner",
  "assignee": [
    "did:party:data-access-party"
  ],
  "target": [
    "urn:asset:clinical-trial-results-data",
    "urn:asset:all-data"
  ],
  "permission": [
    {
      "action": "distribute",
      "constraint": [
        {
          "leftOperand": "odrl:failureRate",
          "operator": "odrl:gt",
          "rightOperand": 5
        },
        {
          "leftOperand": "odrl:resolution",
          "operator": "odrl:lteq",
          "rightOperand": 86
        },
        {
          "leftOperand": "odrl:event",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "termination",
            "breach",
            "audit"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "distribute",
      "constraint": [
        {
          "leftOperand": "odrl:failureRate",
          "operator": "odrl:gt",
          "rightOperand": 5
        },
        {
          "leftOperand": "odrl:virtualLocation",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "hybrid",
            "air-gapped",
            "eu-cloud"
          ]
        },
        {
          "leftOperand": "odrl:language",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "fr",
            "en",
            "es"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "resubmit",
      "constraint": [
        {
          "leftOperand": "odrl:failureRate",
          "operator": "odrl:gt",
          "rightOperand": 5
        },
        {
          "leftOperand": "odrl:purpose",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "research",
            "commercial",
            "audit"
          ]
        }
      ]
    }
  ]
}