{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1163_far_wide:consumer:hard",
  "assigner": "did:party:supply-chain-authority",
  "assignee": [
    "did:party:registered-logistics-partner"
  ],
  "target": [
    "urn:asset:shipment-tracking-records"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:count",
          "operator": "odrl:gt",
          "rightOperand": 169840
        },
        {
          "leftOperand": "odrl:resolution",
          "operator": "odrl:lt",
          "rightOperand": 32
        },
        {
          "leftOperand": "odrl:systemDevice",
          "operator": "odrl:neq",
          "rightOperand": "bare-metal"
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:elapsedTime",
          "operator": "odrl:gteq",
          "rightOperand": "P30DT15H7M26.192S"
        },
        {
          "leftOperand": "odrl:event",
          "operator": "odrl:neq",
          "rightOperand": "termination"
        },
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:isNoneOf",
          "rightOperand": [
            "global"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:absoluteTemporalPosition",
          "operator": "odrl:gteq",
          "rightOperand": "2027-07-02"
        },
        {
          "leftOperand": "odrl:recipient",
          "operator": "odrl:isNoneOf",
          "rightOperand": [
            "regulator"
          ]
        }
      ]
    }
  ]
}