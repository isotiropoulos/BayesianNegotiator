{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0671_far_wide:provider:aspiration",
  "assigner": "did:party:policy-issuer",
  "assignee": [
    "did:party:commercial-film-production-party"
  ],
  "target": [
    "urn:asset:digital-renaissance-manuscripts"
  ],
  "permission": [
    {
      "action": "distribute",
      "constraint": [
        {
          "leftOperand": "odrl:elapsedTime",
          "operator": "odrl:gt",
          "rightOperand": "PT0S"
        },
        {
          "leftOperand": "odrl:spatialResolution",
          "operator": "odrl:lteq",
          "rightOperand": 359
        },
        {
          "leftOperand": "odrl:deliveryChannel",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "https",
            "courier",
            "kafka"
          ]
        },
        {
          "leftOperand": "odrl:event",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "termination",
            "breach",
            "renewal"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:timeInterval",
          "operator": "odrl:lteq",
          "rightOperand": "P18DT8H38M45.122S"
        },
        {
          "leftOperand": "odrl:language",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "de",
            "en",
            "el"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:version",
          "operator": "odrl:lteq",
          "rightOperand": 3
        },
        {
          "leftOperand": "odrl:purpose",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "audit",
            "marketing",
            "statistics"
          ]
        }
      ]
    }
  ]
}