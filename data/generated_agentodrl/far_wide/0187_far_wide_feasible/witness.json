{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Agreement",
  "@id": "urn:witness",
  "assigner": "did:party:policy-issuer",
  "assignee": [
    "did:party:mountain-conservation-authority",
    "did:party:alpine-data-trust"
  ],
  "target": [
    "urn:asset:endangered-alpine-flora-records",
    "urn:asset:usage-reports"
  ],
  "permission": [
