    "did:party:approved-logistics-operator"
  ],
  "target": [
    "urn:asset:cross-border-shipment-events"
  ],
  "permission": [
    {
      "action": "request",
      "constraint": [
        {
          "leftOperand": "odrl:count",
          "operator": "odrl:gteq",
          "rightOperand": 192
        },
        {
