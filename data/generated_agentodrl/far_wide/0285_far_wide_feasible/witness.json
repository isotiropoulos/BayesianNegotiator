{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Agreement",
  "@id": "urn:witness",
  "assigner": "did:party:policy-owner",
  "assignee": [
    "did:party:environmental-ngos"
  ],
  "target": [
    "urn:asset:heatmaps",
    "urn:asset:wildlife-tracker-logs"
  ],
  "permission": [
    {
      "action": "anonymize",
      "constraint": [
        {
          "leftOperand": "odrl:proximitySignal",
          "operator": "odrl:eq",
          "rightOperand": "RiskTier4"
        },
        {
          "leftOperand": "odrl:relativeTemporalPosition",
          "operator": "odrl:eq",
          "rightOperand": "2024-12-30"
        },
        {
          "leftOperand": "odrl:resolution",
          "operator": "odrl:eq",
          "rightOperand": 30
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "retrieveGranularLogs",
      "constraint": [
        {
          "leftOperand": "odrl:signalEndangeredSpeciesProximity",
          "operator": "odrl:eq",
          "rightOperand": "RiskTier4"
        },
        {
          "leftOperand": "odrl:payAmount",
          "operator": "odrl:eq",
          "rightOperand": 2908
        },
        {
          "leftOperand": "odrl:purpose",
          "operator": "odrl:eq",
          "rightOperand": "audit"
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:count",
          "operator": "odrl:eq",
          "rightOperand": 498780
        },
        {
          "leftOperand": "odrl:deliveryChannel",
          "operator": "odrl:eq",
          "rightOperand": "SupportChannel"
        }
      ]
    }
  ]
}