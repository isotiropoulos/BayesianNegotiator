{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0065_far_wide:consumer:aspiration",
  "assigner": "did:party:policy-issuer",
  "assignee": [
    "did:party:data-controller"
  ],
  "target": [
    "urn:asset:swiss-private-bank-transaction-samples-logs"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:timeInterval",
          "operator": "odrl:lteq",
          "rightOperand": "PT0S"
        },
        {
          "leftOperand": "odrl:virtualLocation",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "hybrid",
            "http://example.org/servers",
            "certified_archival_workstation"
          ]
        },
        {
          "leftOperand": "odrl:recipient",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "affiliate",
            "consortium",
            "corporateEmail"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:confidenceLevel",
          "operator": "odrl:lteq",
          "rightOperand": 0.0
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "CSV",
            "RDF",
            "anonymized"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "retain",
      "constraint": [
        {
          "leftOperand": "odrl:delayPeriod",
          "operator": "odrl:lteq",
          "rightOperand": "PT0S"
        },
        {
          "leftOperand": "odrl:count",
          "operator": "odrl:gteq",
          "rightOperand": 459592
        },
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "CH",
            "http://w3id.org/drk/territory/China",
            "Germany"
          ]
        }
      ]
    }
  ]
}