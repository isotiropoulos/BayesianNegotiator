{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Agreement",
  "@id": "urn:witness",
  "assigner": "did:party:policy-issuer",
  "assignee": [
    "did:party:smart-contract",
    "did:party:system"
  ],
  "target": [
    "urn:asset:smart-contract",
    "urn:asset:data-asset"
  ],
  "permission": [
    {
      "action": "execute",
      "constraint": [
        {
          "leftOperand": "odrl:executionTrigger",
          "operator": "odrl:eq",
          "rightOperand": "automatic"
        },
        {
          "leftOperand": "odrl:confidenceLevel",
          "operator": "odrl:eq",
          "rightOperand": 0.28
        },
        {
          "leftOperand": "odrl:relativeTemporalPosition",
          "operator": "odrl:eq",
          "rightOperand": "2024-12-15"
        }
      ]
    },
    {
      "action": "delete",
      "constraint": [
        {
          "leftOperand": "odrl:violationDetected",
          "operator": "odrl:eq",
          "rightOperand": "true"
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:payAmount",
          "operator": "odrl:eq",
          "rightOperand": 1898
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:eq",
          "rightOperand": "CSV"
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:unitOfCount",
          "operator": "odrl:eq",
          "rightOperand": 1584
        },
        {
          "leftOperand": "odrl:deliveryChannel",
          "operator": "odrl:eq",
          "rightOperand": "courier"
        }
      ]
    }
  ]
}