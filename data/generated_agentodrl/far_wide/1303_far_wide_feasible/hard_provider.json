{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1303_far_wide:provider:hard",
  "assigner": "did:party:policy-issuer",
  "assignee": [
    "did:party:smart-contract",
    "did:party:system"
  ],
  "target": [
    "urn:asset:smart-contract",
    "urn:asset:data-asset"
  ],
  "permission": [
    {
      "action": "execute",
      "constraint": [
        {
          "leftOperand": "odrl:executionTrigger",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "automatic"
          ]
        },
        {
          "leftOperand": "odrl:confidenceLevel",
          "operator": "odrl:gteq",
          "rightOperand": 0.13
        },
        {
          "leftOperand": "odrl:relativeTemporalPosition",
          "operator": "odrl:gt",
          "rightOperand": "2024-04-26"
        }
      ]
    },
    {
      "action": "delete",
      "constraint": [
        {
          "leftOperand": "odrl:violationDetected",
          "operator": "odrl:eq",
          "rightOperand": "true"
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:payAmount",
          "operator": "odrl:gteq",
          "rightOperand": 890
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:eq",
          "rightOperand": "CSV"
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:unitOfCount",
          "operator": "odrl:lt",
          "rightOperand": 1958
        },
        {
          "leftOperand": "odrl:deliveryChannel",
          "operator": "odrl:isNoneOf",
          "rightOperand": [
            "s3"
          ]
        }
      ]
    }
  ]
}