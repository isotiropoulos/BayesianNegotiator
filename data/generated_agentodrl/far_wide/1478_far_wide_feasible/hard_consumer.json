{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1478_far_wide:consumer:hard",
  "assigner": "did:party:network-owner",
  "assignee": [
    "did:party:tier-one-components"
  ],
  "target": [
    "urn:asset:supply-chain-dataset"
  ],
  "permission": [
    {
      "action": "distribute",
      "constraint": [
        {
          "leftOperand": "odrl:submissionCondition",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "national supply chain compliance certificate"
          ]
        },
        {
          "leftOperand": "odrl:count",
          "operator": "odrl:gteq",
          "rightOperand": 209923
        },
        {
          "leftOperand": "odrl:version",
          "operator": "odrl:lteq",
          "rightOperand": 2
        },
        {
          "leftOperand": "odrl:event",
          "operator": "odrl:neq",
          "rightOperand": "renewal"
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:payAmount",
          "operator": "odrl:lteq",
          "rightOperand": 1869
        },
        {
          "leftOperand": "odrl:media",
          "operator": "odrl:isNoneOf",
          "rightOperand": [
            "internal-wiki"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:relativeTemporalPosition",
          "operator": "odrl:lteq",
          "rightOperand": "2025-05-05"
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:neq",
          "rightOperand": "XLSX"
        }
      ]
    }
  ]
}