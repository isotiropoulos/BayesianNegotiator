            "audit",
            "marketing"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:timeInterval",
          "operator": "odrl:lteq",
          "rightOperand": "P19DT12H28M28.339S"
        },
        {
          "leftOperand": "odrl:systemDevice",
