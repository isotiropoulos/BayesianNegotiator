{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0310_full_infeasible:consumer:hard",
  "assigner": "did:party:policy-issuer",
  "assignee": [
    "did:party:dataset-access-controller"
  ],
  "target": [
    "urn:asset:pan-european-genome-vault"
  ],
  "permission": [
    {
      "action": "terminate",
      "constraint": [
        {
          "leftOperand": "odrl:reIdentificationActivityDetected",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "detected re-identification activity"
          ]
        },
        {
          "leftOperand": "odrl:samplingRate",
          "operator": "odrl:gt",
          "rightOperand": 0.28
        },
        {
          "leftOperand": "odrl:payAmount",
          "operator": "odrl:lt",
          "rightOperand": 1085
        },
        {
          "leftOperand": "odrl:virtualLocation",
          "operator": "odrl:eq",
          "rightOperand": "hybrid"
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:elapsedTime",
          "operator": "odrl:gt",
          "rightOperand": "P31DT21H31M12.4S"
        },
        {
          "leftOperand": "odrl:deliveryChannel",
          "operator": "odrl:neq",
          "rightOperand": "courier"
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:relativeTemporalPosition",
          "operator": "odrl:lt",
          "rightOperand": "2025-09-10"
        },
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "US",
            "European Union",
            "Germany"
          ]
        }
      ]
    }
  ]
}