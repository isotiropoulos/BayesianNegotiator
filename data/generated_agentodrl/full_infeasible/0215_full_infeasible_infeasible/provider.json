{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0215_full_infeasible:provider:aspiration",
  "assigner": "did:party:data-owner-party",
  "assignee": [
    "did:party:automotive-suppliers-party"
  ],
  "target": [
    "urn:asset:vehicle-emissions-dataset-api"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:count",
          "operator": "odrl:lteq",
          "rightOperand": 100279
        },
        {
          "leftOperand": "odrl:elapsedTime",
          "operator": "odrl:lteq",
          "rightOperand": "P30DT9H40M25.225S"
        },
        {
          "leftOperand": "odrl:systemDevice",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "vm",
            "container",
            "bare-metal"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:version",
          "operator": "odrl:lteq",
          "rightOperand": 3
        },
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "EEA",
            "US",
            "CH"
          ]
        },
        {
          "leftOperand": "odrl:virtualLocation",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "on-prem",
            "edge",
            "air-gapped"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:meteredTime",
          "operator": "odrl:lteq",
          "rightOperand": "P1DT22H27M57.233S"
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "RDF",
            "JSON",
            "XML"
          ]
        }
      ]
    }
  ]
