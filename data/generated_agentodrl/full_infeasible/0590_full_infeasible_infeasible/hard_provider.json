{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0590_full_infeasible:provider:hard",
  "assigner": "did:party:european-health-data-space-authority",
  "assignee": [
    "did:party:pharmaceutical-company"
  ],
  "target": [
    "urn:asset:historical-clinical-trial-results-archive"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:payAmount",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "per-use"
          ]
        },
        {
          "leftOperand": "odrl:timeInterval",
          "operator": "odrl:gt",
          "rightOperand": "P2DT13H9M15.937S"
        },
        {
          "leftOperand": "odrl:version",
          "operator": "odrl:gt",
          "rightOperand": 3
        },
        {
          "leftOperand": "odrl:language",
          "operator": "odrl:neq",
          "rightOperand": "es"
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:absoluteTemporalPosition",
          "operator": "odrl:lt",
          "rightOperand": "2028-06-21"
        },
        {
          "leftOperand": "odrl:virtualLocation",
          "operator": "odrl:neq",
          "rightOperand": "air-gapped"
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:spatialResolution",
          "operator": "odrl:gt",
          "rightOperand": 125
        },
        {
          "leftOperand": "odrl:deliveryChannel",
          "operator": "odrl:isNoneOf",
          "rightOperand": [
            "s3"
          ]
        }
      ]
    }
  ]
}