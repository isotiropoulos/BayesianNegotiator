{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1492_full_infeasible:consumer:aspiration",
  "assigner": "did:party:policy-owner",
  "assignee": [
    "did:party:system"
  ],
  "target": [
    "urn:asset:clinical-trial-results-dataset",
    "urn:asset:all-data-exports"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:confidenceLevel",
          "operator": "odrl:lteq",
          "rightOperand": 0.0
        },
        {
          "leftOperand": "odrl:version",
          "operator": "odrl:lteq",
          "rightOperand": 0
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "distribute",
      "constraint": [
        {
          "leftOperand": "odrl:scope",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "Healthcare Research Data Space",
            "Asia-Pacific Documentary Network",
            "GlobalOpenArtDataSpace"
          ]
        },
        {
          "leftOperand": "odrl:delayPeriod",
          "operator": "odrl:lteq",
          "rightOperand": "PT0S"
        },
        {
          "leftOperand": "odrl:industry",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "finance",
            "mobility",
            "defence"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "tag",
      "constraint": [
        {
          "leftOperand": "odrl:tag",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "Quality Check Pending"
          ]
        },
        {
          "leftOperand": "odrl:percentage",
          "operator": "odrl:gteq",
          "rightOperand": 88
        },
        {
          "leftOperand": "odrl:media",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "print",
            "web"
          ]
        }
      ]
    }
  ]
}