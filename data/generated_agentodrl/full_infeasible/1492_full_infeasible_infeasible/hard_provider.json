{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1492_full_infeasible:provider:hard",
  "assigner": "did:party:policy-owner",
  "assignee": [
    "did:party:system"
  ],
  "target": [
    "urn:asset:clinical-trial-results-dataset",
    "urn:asset:all-data-exports"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:confidenceLevel",
          "operator": "odrl:gteq",
          "rightOperand": 1.0
        },
        {
          "leftOperand": "odrl:version",
          "operator": "odrl:gt",
          "rightOperand": 0
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "distribute",
      "constraint": [
        {
          "leftOperand": "odrl:scope",
          "operator": "odrl:neq",
          "rightOperand": "医疗数据的注册、检索与交付全流程互通"
        },
        {
          "leftOperand": "odrl:delayPeriod",
          "operator": "odrl:gt",
          "rightOperand": "P2DT6H28M24.815S"
        },
        {
          "leftOperand": "odrl:industry",
          "operator": "odrl:isNoneOf",
          "rightOperand": [
            "defence"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "tag",
      "constraint": [
        {
          "leftOperand": "odrl:tag",
          "operator": "odrl:eq",
          "rightOperand": "Quality Check Pending"
        },
        {
          "leftOperand": "odrl:percentage",
          "operator": "odrl:lt",
          "rightOperand": 72
        },
        {
          "leftOperand": "odrl:media",
          "operator": "odrl:eq",
          "rightOperand": "print"
        }
      ]
    }
  ]
}