{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0305_full_infeasible:consumer:hard",
  "assigner": "did:party:european-space-agency",
  "assignee": [
    "did:party:researchers"
  ],
  "target": [
    "urn:asset:anonymized-patient-cohort-data"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:relativeTemporalPosition",
          "operator": "odrl:lt",
          "rightOperand": "2025-11-18"
        },
        {
          "leftOperand": "odrl:samplingRate",
          "operator": "odrl:gt",
          "rightOperand": 1.0
        },
        {
          "leftOperand": "odrl:deliveryChannel",
          "operator": "odrl:eq",
          "rightOperand": "courier"
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:resolution",
          "operator": "odrl:lt",
          "rightOperand": 64
        },
        {
          "leftOperand": "odrl:language",
          "operator": "odrl:isNoneOf",
          "rightOperand": [
            "es"
          ]
        },
        {
          "leftOperand": "odrl:event",
          "operator": "odrl:isNoneOf",
          "rightOperand": [
            "renewal"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:percentage",
          "operator": "odrl:gt",
          "rightOperand": 28
        },
        {
          "leftOperand": "odrl:purpose",
          "operator": "odrl:eq",
          "rightOperand": "education"
        }
      ]
    }
  ]
}