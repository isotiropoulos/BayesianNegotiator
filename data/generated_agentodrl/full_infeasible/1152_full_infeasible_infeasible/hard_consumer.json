{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1152_full_infeasible:consumer:hard",
  "assigner": "did:party:policy-owner",
  "assignee": [
    "did:party:monitoring-gateway"
  ],
  "target": [
    "urn:asset:eu-energy-usage-dataset"
  ],
  "permission": [
    {
      "action": "distribute",
      "constraint": [
        {
          "leftOperand": "odrl:mode",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "http://www.w3.org/ns/odrl/2/real-time"
          ]
        },
        {
          "leftOperand": "odrl:meteredTime",
          "operator": "odrl:gt",
          "rightOperand": "P16DT15H25M39.705S"
        },
        {
          "leftOperand": "odrl:percentage",
          "operator": "odrl:gt",
          "rightOperand": 30
        },
        {
          "leftOperand": "odrl:deliveryChannel",
          "operator": "odrl:isNoneOf",
          "rightOperand": [
            "courier"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:confidenceLevel",
          "operator": "odrl:lt",
          "rightOperand": 0.45
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:eq",
          "rightOperand": "RDF"
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:timeInterval",
          "operator": "odrl:lteq",
          "rightOperand": "P19DT10H43M33.893S"
        },
        {
          "leftOperand": "odrl:media",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "internal-wiki",
            "print"
          ]
        }
      ]
    }
  ]
}