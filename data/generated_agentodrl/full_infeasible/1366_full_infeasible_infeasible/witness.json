{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Agreement",
  "@id": "urn:witness",
  "assigner": "did:party:data-controller",
  "assignee": [
    "did:party:legal-guardian"
  ],
  "target": [
    "urn:asset:user-account",
    "urn:asset:legal-guardian"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:confidenceLevel",
          "operator": "odrl:eq",
          "rightOperand": 0.5
        },
        {
          "leftOperand": "odrl:relativeTemporalPosition",
          "operator": "odrl:eq",
          "rightOperand": "2025-02-27"
        },
        {
          "leftOperand": "odrl:event",
          "operator": "odrl:eq",
          "rightOperand": "termination"
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:resolution",
          "operator": "odrl:eq",
          "rightOperand": 37
        },
        {
          "leftOperand": "odrl:recipient",
          "operator": "odrl:eq",
          "rightOperand": "internal-only"
        },
        {
          "leftOperand": "odrl:systemDevice",
          "operator": "odrl:eq",
          "rightOperand": "vm"
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:unitOfCount",
          "operator": "odrl:eq",
          "rightOperand": 2173
        },
        {
          "leftOperand": "odrl:industry",
          "operator": "odrl:eq",
          "rightOperand": "public"
        }
      ]
    }
  ]
}