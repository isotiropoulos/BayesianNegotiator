{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1749_full_infeasible:consumer:aspiration",
  "assigner": "did:party:policy-owner",
  "assignee": [
    "did:party:data-user"
  ],
  "target": [
    "urn:asset:soil-sensor-data",
    "urn:asset:drone-imagery-data"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:spatialResolution",
          "operator": "odrl:lteq",
          "rightOperand": 0
        },
        {
          "leftOperand": "odrl:version",
          "operator": "odrl:lteq",
          "rightOperand": 0
        },
        {
          "leftOperand": "odrl:event",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "breach",
            "renewal"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:rights",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "cropYields",
            "external-content-sharing",
            "user-initiated-recording"
          ]
        },
        {
          "leftOperand": "odrl:confidenceLevel",
          "operator": "odrl:lteq",
          "rightOperand": 0.0
        },
        {
          "leftOperand": "odrl:industry",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "mobility",
            "retail",
            "energy"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:payAmount",
          "operator": "odrl:lteq",
          "rightOperand": 0
        },
        {
          "leftOperand": "odrl:recipient",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "affiliate",
            "CarOwner",
            "ResponsiblePersonnel"
          ]
        }
      ]
    }
  ]
}