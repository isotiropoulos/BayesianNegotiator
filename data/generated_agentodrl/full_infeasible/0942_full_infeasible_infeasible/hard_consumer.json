{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0942_full_infeasible:consumer:hard",
  "assigner": "did:party:policy-owner",
  "assignee": [
    "did:party:authorized-party",
    "did:party:system"
  ],
  "target": [
    "urn:asset:medical-data-space",
    "urn:asset:blockchain-audit-trail",
    "urn:asset:process-traceability"
  ],
  "permission": [
    {
      "action": "distribute",
      "constraint": [
        {
          "leftOperand": "odrl:dateTime",
          "operator": "odrl:lteq",
          "rightOperand": 0
        },
        {
          "leftOperand": "odrl:virtualLocation",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "hybrid"
          ]
        },
        {
          "leftOperand": "odrl:industry",
          "operator": "odrl:isNoneOf",
          "rightOperand": [
            "defence"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:media",
          "operator": "odrl:isNoneOf",
          "rightOperand": [
            "internal-wiki"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "leaveAuditTrail",
      "constraint": [
        {
          "leftOperand": "odrl:dateTime",
          "operator": "odrl:lteq",
          "rightOperand": 2
        },
        {
          "leftOperand": "odrl:recipient",
          "operator": "odrl:neq",
          "rightOperand": "regulator"
        }
      ]
    },
    {
      "action": "storeImmutable",
      "constraint": [
        {
          "leftOperand": "odrl:dateTime",
          "operator": "odrl:lt",
          "rightOperand": 2
        }
      ]
    },
    {
      "action": "ensureTraceability",
      "constraint": [
        {
          "leftOperand": "odrl:dateTime",
          "operator": "odrl:lt",
          "rightOperand": 2
        }
      ]
    }
  ]
}