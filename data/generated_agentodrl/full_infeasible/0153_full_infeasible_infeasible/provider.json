{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0153_full_infeasible:provider:aspiration",
  "assigner": "did:party:policy-issuer",
  "assignee": [
    "did:party:user",
    "did:party:asset-manager"
  ],
  "target": [
    "urn:asset:image-asset",
    "urn:asset:licensing-cost"
  ],
  "permission": [
    {
      "action": "print",
      "constraint": [
        {
          "leftOperand": "odrl:resolutionDPI",
          "operator": "odrl:gt",
          "rightOperand": 600
        },
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "EU",
            "US",
            "global"
          ]
        },
        {
          "leftOperand": "odrl:media",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "internal-wiki",
            "print",
            "web"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "distribute",
      "constraint": [
        {
          "leftOperand": "odrl:resolutionDPI",
          "operator": "odrl:gt",
          "rightOperand": 600
        },
        {
          "leftOperand": "odrl:systemDevice",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "bare-metal",
            "hsm",
            "tee"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "requestApproval",
      "constraint": [
        {
          "leftOperand": "odrl:resolutionDPI",
          "operator": "odrl:gt",
          "rightOperand": 600
        },
        {
          "leftOperand": "odrl:purpose",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "statistics",
            "education",
            "journalism"
          ]
        }
      ]
    },
    {
      "action": "pay",
      "constraint": [
        {
          "leftOperand": "odrl:resolutionDPI",
          "operator": "odrl:gt",
          "rightOperand": 600
        }
      ]
    }
  ]
}