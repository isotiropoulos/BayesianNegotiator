        {
          "leftOperand": "odrl:relativeTemporalPosition",
          "operator": "odrl:lteq",
          "rightOperand": "2026-03-13"
        },
        {
          "leftOperand": "odrl:resolution",
          "operator": "odrl:lteq",
          "rightOperand": 61
        }
      ]
    }
  ],
  "prohibition": [
    {
