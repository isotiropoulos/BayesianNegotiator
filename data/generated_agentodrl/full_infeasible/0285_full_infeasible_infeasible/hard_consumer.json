{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0285_full_infeasible:consumer:hard",
  "assigner": "did:party:policy-owner",
  "assignee": [
    "did:party:environmental-ngos"
  ],
  "target": [
    "urn:asset:heatmaps",
    "urn:asset:wildlife-tracker-logs"
  ],
  "permission": [
    {
      "action": "anonymize",
      "constraint": [
        {
          "leftOperand": "odrl:proximitySignal",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "RiskTier4"
          ]
        },
        {
          "leftOperand": "odrl:relativeTemporalPosition",
          "operator": "odrl:lteq",
          "rightOperand": "2024-10-25"
        },
        {
          "leftOperand": "odrl:resolution",
          "operator": "odrl:lt",
          "rightOperand": 49
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "retrieveGranularLogs",
      "constraint": [
        {
          "leftOperand": "odrl:signalEndangeredSpeciesProximity",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "RiskTier4"
          ]
        },
        {
          "leftOperand": "odrl:payAmount",
          "operator": "odrl:lt",
          "rightOperand": 4652
        },
        {
          "leftOperand": "odrl:purpose",
          "operator": "odrl:eq",
          "rightOperand": "audit"
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:count",
          "operator": "odrl:gt",
          "rightOperand": 365772
        },
        {
          "leftOperand": "odrl:deliveryChannel",
          "operator": "odrl:neq",
          "rightOperand": "courier"
        }
      ]
    }
  ]
}