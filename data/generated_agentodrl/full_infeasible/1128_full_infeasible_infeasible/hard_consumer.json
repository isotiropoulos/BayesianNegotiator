      "constraint": [
        {
          "leftOperand": "odrl:revenueType",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "subscription"
          ]
        },
        {
          "leftOperand": "odrl:spatialResolution",
          "operator": "odrl:lt",
          "rightOperand": 115
        },
        {
          "leftOperand": "odrl:relativeTemporalPosition",
          "operator": "odrl:lt",
          "rightOperand": "2025-11-04"
        },
        {
          "leftOperand": "odrl:deliveryChannel",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "s3",
            "SupportChannel",
            "courier"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:unitOfCount",
          "operator": "odrl:gteq",
          "rightOperand": 1819
        },
        {
          "leftOperand": "odrl:systemDevice",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "container"
          ]
        }
      ]
    }
  ],
  "obligation": [
