{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1383_full_infeasible:consumer:hard",
  "assigner": "did:party:policy-assigner",
  "assignee": [
    "did:party:data-space-admin"
  ],
  "target": [
    "urn:asset:content",
    "urn:asset:account"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:absoluteTemporalPosition",
          "operator": "odrl:gteq",
          "rightOperand": "2026-11-07"
        },
        {
          "leftOperand": "odrl:resolution",
          "operator": "odrl:lt",
          "rightOperand": 16
        },
        {
          "leftOperand": "odrl:purpose",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "marketing"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:confidenceLevel",
          "operator": "odrl:lt",
          "rightOperand": 0.45
        },
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:neq",
          "rightOperand": "global"
        },
        {
          "leftOperand": "odrl:media",
          "operator": "odrl:isNoneOf",
          "rightOperand": [
            "internal-wiki"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:samplingRate",
          "operator": "odrl:gteq",
          "rightOperand": 0.24
        },
        {
          "leftOperand": "odrl:systemDevice",
          "operator": "odrl:isNoneOf",
          "rightOperand": [
            "container"
          ]
        }
      ]
    }
  ]
}