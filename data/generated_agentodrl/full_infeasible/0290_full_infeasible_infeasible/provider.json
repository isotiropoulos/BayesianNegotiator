{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0290_full_infeasible:provider:aspiration",
  "assigner": "did:party:aggregated-irrigation-advisories",
  "assignee": [
    "did:party:counterparty"
  ],
  "target": [
    "urn:asset:aggregated-irrigation-advisories",
    "urn:asset:field-level-sensor-data",
    "urn:asset:regional-farm-cooperatives"
  ],
  "permission": [
    {
      "action": "read",
      "constraint": [
        {
          "leftOperand": "odrl:accessLevel",
          "operator": "odrl:eq",
          "rightOperand": "aggregated"
        },
        {
          "leftOperand": "odrl:samplingRate",
          "operator": "odrl:lteq",
          "rightOperand": 0.12
        },
        {
          "leftOperand": "odrl:deliveryChannel",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "courier",
            "s3",
            "kafka"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:resolution",
          "operator": "odrl:lteq",
          "rightOperand": 63
        },
        {
          "leftOperand": "odrl:event",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "audit",
            "renewal",
            "breach"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "limitAccess",
      "constraint": [
        {
          "leftOperand": "odrl:soilMoisture",
          "operator": "odrl:lt",
          "rightOperand": 10
        },
        {
          "leftOperand": "odrl:delayPeriod",
          "operator": "odrl:lteq",
          "rightOperand": "P10DT4H29M2.601S"
        },
        {
          "leftOperand": "odrl:virtualLocation",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "us-cloud",
            "hybrid",
            "edge"
          ]
        }
      ]
    }
  ]
}