{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0335_full_infeasible:consumer:aspiration",
  "assigner": "did:party:health-authority",
  "assignee": [
    "did:party:authorized-hospital-networks"
  ],
  "target": [
    "urn:asset:clinical-decision-support-api",
    "urn:asset:medication-warnings"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:version",
          "operator": "odrl:lteq",
          "rightOperand": 0
        },
        {
          "leftOperand": "odrl:timeInterval",
          "operator": "odrl:lteq",
          "rightOperand": "PT0S"
        },
        {
          "leftOperand": "odrl:recipient",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "third-party",
            "//example.org/parties/patient",
            "Farmers"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:relativeTemporalPosition",
          "operator": "odrl:lteq",
          "rightOperand": "2023-12-15"
        },
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "CH",
            "ASEAN",
            "Gaia-X Trusted Zone"
          ]
        },
        {
          "leftOperand": "odrl:purpose",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "education",
            "bias surveillance",
            "analyzingPurchasingBehavior"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:meteredTime",
          "operator": "odrl:gteq",
          "rightOperand": "P26DT16H41M53.991S"
        },
        {
          "leftOperand": "odrl:virtualLocation",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "us-cloud",
            "certified_archival_workstation",
            "eu-cloud"
          ]
        }
      ]
    }
  ]
}