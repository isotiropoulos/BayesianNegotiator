{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0065_full_infeasible:consumer:hard",
  "assigner": "did:party:policy-issuer",
  "assignee": [
    "did:party:data-controller"
  ],
  "target": [
    "urn:asset:swiss-private-bank-transaction-samples-logs"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:timeInterval",
          "operator": "odrl:lteq",
          "rightOperand": "P3DT19H8M40.182S"
        },
        {
          "leftOperand": "odrl:virtualLocation",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "hybrid"
          ]
        },
        {
          "leftOperand": "odrl:recipient",
          "operator": "odrl:isNoneOf",
          "rightOperand": [
            "regulator"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:confidenceLevel",
          "operator": "odrl:lt",
          "rightOperand": 0.45
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "CSV",
            "RDF",
            "anonymized"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "retain",
      "constraint": [
        {
          "leftOperand": "odrl:delayPeriod",
          "operator": "odrl:lt",
          "rightOperand": "P2920D"
        },
        {
          "leftOperand": "odrl:count",
          "operator": "odrl:gteq",
          "rightOperand": 233331
        },
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:neq",
          "rightOperand": "global"
        }
      ]
    }
  ]
