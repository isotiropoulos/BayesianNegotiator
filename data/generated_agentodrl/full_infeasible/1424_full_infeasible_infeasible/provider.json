      "action": "distribute",
      "constraint": [
        {
          "leftOperand": "odrl:payAmount",
          "operator": "odrl:eq",
          "rightOperand": "per-site data access fee"
        },
        {
          "leftOperand": "odrl:percentage",
          "operator": "odrl:lteq",
          "rightOperand": 12
        },
        {
          "leftOperand": "odrl:unitOfCount",
          "operator": "odrl:lteq",
          "rightOperand": 550
        },
        {
          "leftOperand": "odrl:systemDevice",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "container",
            "vm",
            "hsm"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:delayPeriod",
          "operator": "odrl:lteq",
          "rightOperand": "P9DT19H49M35.856S"
        },
        {
          "leftOperand": "odrl:media",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "broadcast",
            "web",
            "internal-wiki"
          ]
