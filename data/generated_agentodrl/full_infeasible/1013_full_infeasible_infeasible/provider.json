{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1013_full_infeasible:provider:aspiration",
  "assigner": "did:party:policy-issuer",
  "assignee": [
    "did:party:data-recipient",
    "did:party:unauthorized-party",
    "did:party:data-processor"
  ],
  "target": [
    "urn:asset:statistical-data",
    "urn:asset:personal-financial-data"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:version",
          "operator": "odrl:lteq",
          "rightOperand": 3
        },
        {
          "leftOperand": "odrl:event",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "breach",
            "renewal",
            "audit"
          ]
        },
        {
          "leftOperand": "odrl:virtualLocation",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "edge",
            "air-gapped",
            "us-cloud"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:samplingRate",
          "operator": "odrl:lteq",
          "rightOperand": 0.09
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "PARQUET",
            "XLSX",
            "XML"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "applyDifferentialPrivacy",
      "constraint": [
        {
          "leftOperand": "odrl:privacyParameterEpsilon",
          "operator": "odrl:lteq",
          "rightOperand": 1.3
        },
        {
          "leftOperand": "odrl:confidenceLevel",
          "operator": "odrl:lteq",
          "rightOperand": 0.55
        },
        {
          "leftOperand": "odrl:recipient",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "regulator",
            "third-party",
            "public"
          ]
        }
      ]
    }
  ]
}