{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1416_full_infeasible:provider:hard",
  "assigner": "did:party:municipal-authority",
  "assignee": [
    "did:party:municipal-planner"
  ],
  "target": [
    "urn:asset:traffic-flow-data-asset",
    "urn:asset:data-access-notification"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:purpose",
          "operator": "odrl:neq",
          "rightOperand": "audit"
        },
        {
          "leftOperand": "odrl:absoluteTemporalPosition",
          "operator": "odrl:lteq",
          "rightOperand": "2025-09-04"
        },
        {
          "leftOperand": "odrl:confidenceLevel",
          "operator": "odrl:gteq",
          "rightOperand": 1.0
        },
        {
          "leftOperand": "odrl:event",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "audit",
            "termination",
            "breach"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:timeInterval",
          "operator": "odrl:gt",
          "rightOperand": "P4DT21H17M11.889S"
        },
        {
          "leftOperand": "odrl:systemDevice",
          "operator": "odrl:neq",
          "rightOperand": "bare-metal"
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:absoluteTemporalPosition",
          "operator": "odrl:lt",
          "rightOperand": "2025-09-04"
        },
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "CH",
            "global",
            "UK"
          ]
        }
      ]
    }
  ]
}