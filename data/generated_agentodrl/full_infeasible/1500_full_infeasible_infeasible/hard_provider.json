{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1500_full_infeasible:provider:hard",
  "assigner": "did:party:system-entity",
  "assignee": [
    "did:party:all-users"
  ],
  "target": [
    "urn:asset:satellite-crop-imaging-data",
    "urn:asset:all-users"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:confidenceLevel",
          "operator": "odrl:gt",
          "rightOperand": 1.0
        },
        {
          "leftOperand": "odrl:version",
          "operator": "odrl:gt",
          "rightOperand": 0
        },
        {
          "leftOperand": "odrl:purpose",
          "operator": "odrl:isNoneOf",
          "rightOperand": [
            "audit"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:delayPeriod",
          "operator": "odrl:gt",
          "rightOperand": "P1DT4H10M12.068S"
        },
        {
          "leftOperand": "odrl:systemDevice",
          "operator": "odrl:eq",
          "rightOperand": "tee"
        },
        {
          "leftOperand": "odrl:media",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "internal-wiki",
            "print",
            "web"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:percentage",
          "operator": "odrl:lt",
          "rightOperand": 73
        },
        {
          "leftOperand": "odrl:deliveryChannel",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "s3",
            "sftp",
            "https"
          ]
        }
      ]
    }
  ]
}