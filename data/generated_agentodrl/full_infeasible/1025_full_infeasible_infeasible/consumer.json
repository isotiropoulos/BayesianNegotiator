{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1025_full_infeasible:consumer:aspiration",
  "assigner": "did:party:steward-of-cu-j-498",
  "assignee": [
    "did:party:user"
  ],
  "target": [
    "urn:asset:crop-yield-forecasting-services"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:userAge",
          "operator": "odrl:lteq",
          "rightOperand": 0
        },
        {
          "leftOperand": "odrl:countryDigitalConsentAge",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "CountryDigitalConsentMinimumAge"
          ]
        },
        {
          "leftOperand": "odrl:version",
          "operator": "odrl:lteq",
          "rightOperand": 0
        },
        {
          "leftOperand": "odrl:language",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "en",
            "fr",
            "de"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:percentage",
          "operator": "odrl:gteq",
          "rightOperand": 93
        },
        {
          "leftOperand": "odrl:virtualLocation",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "edge",
            "on-prem",
            "certified_archival_workstation"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:absoluteTemporalPosition",
          "operator": "odrl:gteq",
          "rightOperand": "2028-11-02"
        },
        {
          "leftOperand": "odrl:event",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "termination",
            "audit"
          ]
        }
      ]
    }
  ]
}