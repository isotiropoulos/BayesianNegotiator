{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1195_full_infeasible:provider:hard",
  "assigner": "did:party:policy-issuer",
  "assignee": [
    "did:party:counterparty"
  ],
  "target": [
    "urn:asset:model"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:version",
          "operator": "odrl:gt",
          "rightOperand": 0
        },
        {
          "leftOperand": "odrl:resolution",
          "operator": "odrl:gt",
          "rightOperand": 28
        },
        {
          "leftOperand": "odrl:deliveryChannel",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "s3",
            "https",
            "kafka"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "deploy",
      "constraint": [
        {
          "leftOperand": "odrl:deploymentStatus",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "postDeployment"
          ]
        },
        {
          "leftOperand": "odrl:meteredTime",
          "operator": "odrl:lteq",
          "rightOperand": "P21DT16H44M17.677S"
        },
        {
          "leftOperand": "odrl:media",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "internal-wiki",
            "print",
            "web"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:percentage",
          "operator": "odrl:lt",
          "rightOperand": 73
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "PARQUET",
            "CSV",
            "RDF"
          ]
        }
      ]
    }
  ]
}