{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1661_full_infeasible:consumer:aspiration",
  "assigner": "did:party:policy-issuer",
  "assignee": [
    "did:party:subscriber",
    "did:party:streaming-service-provider"
  ],
  "target": [
    "urn:asset:subscriber-rights",
    "urn:asset:privacy-information"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:spatialResolution",
          "operator": "odrl:lteq",
          "rightOperand": 0
        },
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "CH",
            "GaiaXTrustedZone",
            "跨区域联合查询"
          ]
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "CSV",
            "RDF",
            "anonymized"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:resolution",
          "operator": "odrl:lteq",
          "rightOperand": 0
        },
        {
          "leftOperand": "odrl:event",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "termination",
            "renewal"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "update",
      "constraint": [
        {
          "leftOperand": "odrl:dateTime",
          "operator": "odrl:gteq",
          "rightOperand": "P936D"
        },
        {
          "leftOperand": "odrl:delayPeriod",
          "operator": "odrl:lteq",
          "rightOperand": "PT0S"
        },
        {
          "leftOperand": "odrl:media",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "internal-wiki",
            "broadcast"
          ]
        }
      ]
    }
  ]
}