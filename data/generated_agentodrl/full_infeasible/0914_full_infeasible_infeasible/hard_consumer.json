{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0914_full_infeasible:consumer:hard",
  "assigner": "did:party:traffic-data-provider",
  "assignee": [
    "did:party:counterparty"
  ],
  "target": [
    "urn:asset:traffic-live2025-data",
    "urn:asset:usage-effectiveness-report",
    "urn:asset:public-data-maintenance-fund"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:relativeTemporalPosition",
          "operator": "odrl:lt",
          "rightOperand": "2024-10-26"
        },
        {
          "leftOperand": "odrl:industry",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "health"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:media",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "print",
            "broadcast"
          ]
        },
        {
          "leftOperand": "odrl:language",
          "operator": "odrl:neq",
          "rightOperand": "es"
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "report",
      "constraint": [
        {
          "leftOperand": "odrl:timeInterval",
          "operator": "odrl:lteq",
          "rightOperand": "P72D"
        },
        {
          "leftOperand": "odrl:deliveryChannel",
          "operator": "odrl:neq",
          "rightOperand": "s3"
        }
      ]
    },
    {
      "action": "contribute",
      "constraint": [
        {
          "leftOperand": "odrl:payAmount",
          "operator": "odrl:lteq",
          "rightOperand": 0.01
        }
      ]
    },
    {
      "action": "pay",
      "constraint": [
        {
          "leftOperand": "odrl:payAmount",
          "operator": "odrl:gteq",
          "rightOperand": -1
        }
      ]
    }
  ]
}