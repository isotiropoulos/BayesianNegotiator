{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1374_full_infeasible:consumer:hard",
  "assigner": "did:party:policy-assigner",
  "assignee": [
    "did:party:user-on-behalf"
  ],
  "target": [
    "urn:asset:distributed-manufacturing-schedules"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:version",
          "operator": "odrl:lt",
          "rightOperand": 2
        },
        {
          "leftOperand": "odrl:absoluteTemporalPosition",
          "operator": "odrl:gteq",
          "rightOperand": "2027-12-07"
        },
        {
          "leftOperand": "odrl:systemDevice",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "vm"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:count",
          "operator": "odrl:gteq",
          "rightOperand": 191737
        },
        {
          "leftOperand": "odrl:event",
          "operator": "odrl:neq",
          "rightOperand": "termination"
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:neq",
          "rightOperand": "XLSX"
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:percentage",
          "operator": "odrl:gt",
          "rightOperand": 23
        },
        {
          "leftOperand": "odrl:language",
          "operator": "odrl:eq",
          "rightOperand": "en"
        }
      ]
    }
  ]
}