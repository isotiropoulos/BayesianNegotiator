{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0812_full_infeasible:provider:hard",
  "assigner": "did:party:european-digital-art-exchange-owner",
  "assignee": [
    "did:party:aiplatform"
  ],
  "target": [
    "urn:asset:generated-artwork"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:timeInterval",
          "operator": "odrl:gteq",
          "rightOperand": "P2DT23H16M20.779S"
        },
        {
          "leftOperand": "odrl:delayPeriod",
          "operator": "odrl:gt",
          "rightOperand": "P8DT7H12M0.228S"
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "JSON"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:absoluteTemporalPosition",
          "operator": "odrl:lt",
          "rightOperand": "2028-05-10"
        },
        {
          "leftOperand": "odrl:recipient",
          "operator": "odrl:neq",
          "rightOperand": "regulator"
        },
        {
          "leftOperand": "odrl:language",
          "operator": "odrl:neq",
          "rightOperand": "es"
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:samplingRate",
          "operator": "odrl:lt",
          "rightOperand": 0.77
        },
        {
          "leftOperand": "odrl:media",
          "operator": "odrl:isNoneOf",
          "rightOperand": [
            "internal-wiki"
          ]
        }
      ]
    }
  ]
}