{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1752_full_infeasible:provider:hard",
  "assigner": "did:party:data-controller",
  "assignee": [
    "did:party:passenger"
  ],
  "target": [
    "urn:asset:passenger-travel-history-data",
    "urn:asset:monthly-subscription-contract",
    "urn:asset:pre-contract-actions"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:unitOfCount",
          "operator": "odrl:lteq",
          "rightOperand": 1764
        },
        {
          "leftOperand": "odrl:spatialResolution",
          "operator": "odrl:gteq",
          "rightOperand": 120
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:eq",
          "rightOperand": "CSV"
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:absoluteTemporalPosition",
          "operator": "odrl:lteq",
          "rightOperand": "2028-03-30"
        },
        {
          "leftOperand": "odrl:media",
          "operator": "odrl:eq",
          "rightOperand": "print"
        },
        {
          "leftOperand": "odrl:event",
          "operator": "odrl:eq",
          "rightOperand": "termination"
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:version",
          "operator": "odrl:gt",
          "rightOperand": 0
        },
        {
          "leftOperand": "odrl:purpose",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "statistics"
          ]
        }
      ]
    }
  ]
