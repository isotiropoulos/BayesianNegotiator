{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1318_full_infeasible:consumer:hard",
  "assigner": "did:party:bank-alliance",
  "assignee": [
    "did:party:data-provider",
    "did:party:user",
    "did:party:data-recipient",
    "did:party:unauthorized-party",
    "did:party:all-parties",
    "did:party:privacy-framework",
    "did:party:data-sender"
  ],
  "target": [
    "urn:asset:credit-data",
    "urn:asset:sensitive-credit-data"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:relativeTemporalPosition",
          "operator": "odrl:lt",
          "rightOperand": "2024-12-15"
        },
        {
          "leftOperand": "odrl:systemDevice",
          "operator": "odrl:neq",
          "rightOperand": "bare-metal"
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "send",
      "constraint": [
        {
          "leftOperand": "odrl:transmissionMethod",
          "operator": "odrl:eq",
          "rightOperand": "encryption"
        },
        {
          "leftOperand": "odrl:spatialResolution",
          "operator": "odrl:lt",
          "rightOperand": 430
        },
        {
          "leftOperand": "odrl:media",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "internal-wiki",
            "broadcast"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "transmit",
      "constraint": [
        {
          "leftOperand": "odrl:transmissionMethod",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "encryption",
            "plaintext"
          ]
        },
        {
          "leftOperand": "odrl:sensitivityLevel",
          "operator": "odrl:gteq",
          "rightOperand": 5
        },
        {
          "leftOperand": "odrl:count",
          "operator": "odrl:gt",
          "rightOperand": 350016
        }
      ]
    }
  ]
}