{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1481_full_infeasible:consumer:aspiration",
  "assigner": "did:party:policy-issuer",
  "assignee": [
    "did:party:analyst-party",
    "did:party:catena-x-auditing-node"
  ],
  "target": [
    "urn:asset:supply-chain-traceability-dataset",
    "urn:asset:user-activity-logs"
  ],
  "permission": [
    {
      "action": "stream",
      "constraint": [
        {
          "leftOperand": "odrl:analystReviewedAndRegistered",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "True"
          ]
        },
        {
          "leftOperand": "odrl:spatialResolution",
          "operator": "odrl:lteq",
          "rightOperand": 0
        },
        {
          "leftOperand": "odrl:resolution",
          "operator": "odrl:lteq",
          "rightOperand": 0
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:percentage",
          "operator": "odrl:gteq",
          "rightOperand": 87
        },
        {
          "leftOperand": "odrl:language",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "el",
            "fr",
            "en"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "stream",
      "constraint": [
        {
          "leftOperand": "odrl:realTimeStreaming",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "True"
          ]
        },
        {
          "leftOperand": "odrl:elapsedTime",
          "operator": "odrl:gteq",
          "rightOperand": "P81DT11H59M8.987S"
        },
        {
          "leftOperand": "odrl:industry",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "health",
            "医院数据提供方",
            "public"
          ]
        }
      ]
    }
  ]
}