{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0204_full_infeasible:consumer:hard",
  "assigner": "did:party:policy-owner",
  "assignee": [
    "did:party:insurance-provider"
  ],
  "target": [
    "urn:asset:vehicle-maintenance-records",
    "urn:asset:insurance-provider"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:version",
          "operator": "odrl:lteq",
          "rightOperand": 0
        },
        {
          "leftOperand": "odrl:percentage",
          "operator": "odrl:gt",
          "rightOperand": 23
        },
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "US",
            "inside the territory of the International Financial Data Network",
            "CentralEuropeanCountries"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:payAmount",
          "operator": "odrl:lteq",
          "rightOperand": 5360
        },
        {
          "leftOperand": "odrl:virtualLocation",
          "operator": "odrl:isNoneOf",
          "rightOperand": [
            "edge"
          ]
        },
        {
          "leftOperand": "odrl:media",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "internal-wiki"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:absoluteTemporalPosition",
          "operator": "odrl:gt",
          "rightOperand": "2027-02-19"
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:isNoneOf",
          "rightOperand": [
            "RDF"
          ]
        }
      ]
    }
  ]
}