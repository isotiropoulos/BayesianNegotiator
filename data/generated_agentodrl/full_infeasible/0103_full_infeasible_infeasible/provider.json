{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0103_full_infeasible:provider:aspiration",
  "assigner": "did:party:policy-owner",
  "assignee": [
    "did:party:urban-planning-consultants"
  ],
  "target": [
    "urn:asset:traffic-sensor-event-logs-asset"
  ],
  "permission": [
    {
      "action": "view",
      "constraint": [
        {
          "leftOperand": "odrl:authenticity",
          "operator": "odrl:eq",
          "rightOperand": "authenticated"
        },
        {
          "leftOperand": "odrl:delayPeriod",
          "operator": "odrl:lteq",
          "rightOperand": "P10DT10H59M41.888S"
        },
        {
          "leftOperand": "odrl:meteredTime",
          "operator": "odrl:lteq",
          "rightOperand": "P3DT8H10M32.103S"
        }
      ]
    },
    {
      "action": "download",
      "constraint": [
        {
          "leftOperand": "odrl:authenticity",
          "operator": "odrl:eq",
          "rightOperand": "authenticated"
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:unitOfCount",
          "operator": "odrl:lteq",
          "rightOperand": 965
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "JSON",
            "XLSX",
            "CSV"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:timeInterval",
          "operator": "odrl:lteq",
          "rightOperand": "P19DT3H3M2.268S"
        },
        {
          "leftOperand": "odrl:systemDevice",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "bare-metal",
            "container",
            "hsm"
          ]
        }
      ]
    }
  ]
}