{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1371_full_infeasible:consumer:aspiration",
  "assigner": "did:party:policy-owner",
  "assignee": [
    "did:party:users"
  ],
  "target": [
    "urn:asset:distributed-manufacturing-schedules"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:age",
          "operator": "odrl:gteq",
          "rightOperand": 47
        },
        {
          "leftOperand": "odrl:resource",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "urn:gaia-x:distributed-manufacturing-schedules",
            "Satellite Imagery Archives",
            "Digitized Renaissance Paintings"
          ]
        },
        {
          "leftOperand": "odrl:version",
          "operator": "odrl:lteq",
          "rightOperand": 0
        },
        {
          "leftOperand": "odrl:industry",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "finance",
            "state credit industry administrative department",
            "health"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:samplingRate",
          "operator": "odrl:gteq",
          "rightOperand": 0.86
        },
        {
          "leftOperand": "odrl:language",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "en",
            "de",
            "fr"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:delayPeriod",
          "operator": "odrl:lteq",
          "rightOperand": "PT0S"
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "CSV",
            "HourlyPollutionSensorReadings",
            "XML"
          ]
        }
      ]
    }
  ]
}