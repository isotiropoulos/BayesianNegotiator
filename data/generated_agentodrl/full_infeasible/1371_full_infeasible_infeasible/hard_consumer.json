{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1371_full_infeasible:consumer:hard",
  "assigner": "did:party:policy-owner",
  "assignee": [
    "did:party:users"
  ],
  "target": [
    "urn:asset:distributed-manufacturing-schedules"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:age",
          "operator": "odrl:gteq",
          "rightOperand": 35
        },
        {
          "leftOperand": "odrl:resource",
          "operator": "odrl:isNoneOf",
          "rightOperand": [
            "drk:SensitiveTrafficData"
          ]
        },
        {
          "leftOperand": "odrl:version",
          "operator": "odrl:lteq",
          "rightOperand": 3
        },
        {
          "leftOperand": "odrl:industry",
          "operator": "odrl:neq",
          "rightOperand": "defence"
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:samplingRate",
          "operator": "odrl:gteq",
          "rightOperand": 0.22
        },
        {
          "leftOperand": "odrl:language",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "en"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:delayPeriod",
          "operator": "odrl:lt",
          "rightOperand": "P4DT59M51.726S"
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "CSV"
          ]
        }
      ]
    }
  ]
