{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0803_full_infeasible:provider:hard",
  "assigner": "did:party:policy-owner",
  "assignee": [
    "did:party:party-owner"
  ],
  "target": [
    "urn:asset:stream-asset"
  ],
  "permission": [
    {
      "action": "distribute",
      "constraint": [
        {
          "leftOperand": "odrl:hasSourceIdentification",
          "operator": "odrl:eq",
          "rightOperand": "visible"
        },
        {
          "leftOperand": "odrl:relativeTemporalPosition",
          "operator": "odrl:gteq",
          "rightOperand": "2024-04-02"
        },
        {
          "leftOperand": "odrl:samplingRate",
          "operator": "odrl:lteq",
          "rightOperand": 0.0
        },
        {
          "leftOperand": "odrl:virtualLocation",
          "operator": "odrl:neq",
          "rightOperand": "edge"
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:count",
          "operator": "odrl:lt",
          "rightOperand": 470747
        },
        {
          "leftOperand": "odrl:deliveryChannel",
          "operator": "odrl:neq",
          "rightOperand": "courier"
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:payAmount",
          "operator": "odrl:gt",
          "rightOperand": 613
        },
        {
          "leftOperand": "odrl:recipient",
          "operator": "odrl:isNoneOf",
          "rightOperand": [
            "regulator"
          ]
        }
      ]
    }
  ]
}