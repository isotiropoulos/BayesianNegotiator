        {
          "leftOperand": "odrl:useScope",
          "operator": "odrl:eq",
          "rightOperand": "Energy Grid Data Space"
        },
        {
          "leftOperand": "odrl:timeInterval",
          "operator": "odrl:lteq",
          "rightOperand": "P11DT10H6M6.531S"
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "JSON",
            "CSV",
            "PARQUET"
