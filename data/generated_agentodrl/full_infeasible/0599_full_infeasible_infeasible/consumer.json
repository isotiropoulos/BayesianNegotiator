{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0599_full_infeasible:consumer:aspiration",
  "assigner": "did:party:steward-of-su-319",
  "assignee": [
    "did:party:agri-tech-startups"
  ],
  "target": [
    "urn:asset:satellite-crop-imagery-repository",
    "urn:asset:payment"
  ],
  "permission": [
    {
      "action": "distribute",
      "constraint": [
        {
          "leftOperand": "odrl:paymentModel",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "per download"
          ]
        },
        {
          "leftOperand": "odrl:delayPeriod",
          "operator": "odrl:lteq",
          "rightOperand": "PT0S"
        },
        {
          "leftOperand": "odrl:industry",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "defence",
            "health",
            "国家工业安全"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:payAmount",
          "operator": "odrl:lteq",
          "rightOperand": 0
        },
        {
          "leftOperand": "odrl:virtualLocation",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "edge",
            "air-gapped",
            "hybrid"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "pay",
      "constraint": [
        {
          "leftOperand": "odrl:downloadCount",
          "operator": "odrl:gteq",
          "rightOperand": 1
        },
        {
          "leftOperand": "odrl:spatialResolution",
          "operator": "odrl:lteq",
          "rightOperand": 0
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "RDF",
            "PARQUET",
            "passenger name record data"
          ]
        }
      ]
    }
  ]
}