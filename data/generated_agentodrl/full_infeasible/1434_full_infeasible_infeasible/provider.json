{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1434_full_infeasible:provider:aspiration",
  "assigner": "did:party:data-owner-party",
  "assignee": [
    "did:party:data-owner"
  ],
  "target": [
    "urn:asset:data"
  ],
  "permission": [
    {
      "action": "delete",
      "constraint": [
        {
          "leftOperand": "odrl:deletionType",
          "operator": "odrl:eq",
          "rightOperand": "permanent"
        },
        {
          "leftOperand": "odrl:unitOfCount",
          "operator": "odrl:lteq",
          "rightOperand": 935
        },
        {
          "leftOperand": "odrl:relativeTemporalPosition",
          "operator": "odrl:lteq",
          "rightOperand": "2026-03-23"
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "delete",
      "constraint": [
        {
          "leftOperand": "odrl:deletionReversibility",
          "operator": "odrl:eq",
          "rightOperand": "reversible"
        },
        {
          "leftOperand": "odrl:percentage",
          "operator": "odrl:lteq",
          "rightOperand": 15
        },
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "UK",
            "EU",
            "EEA"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:resolution",
          "operator": "odrl:lteq",
          "rightOperand": 39
        },
        {
          "leftOperand": "odrl:media",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "print",
            "web",
            "internal-wiki"
          ]
        }
      ]
    }
  ]
}