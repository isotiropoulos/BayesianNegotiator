{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Agreement",
  "@id": "urn:witness",
  "assigner": "did:party:gaia-xauthority",
  "assignee": [
    "did:party:disaster-relief-agency"
  ],
  "target": [
    "urn:asset:coastal-flood-risk-maps"
  ],
  "permission": [
    {
      "action": "overrideAccess",
      "constraint": [
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:eq",
          "rightOperand": "CatenaXDataSpace"
        },
        {
          "leftOperand": "odrl:confidenceLevel",
          "operator": "odrl:eq",
          "rightOperand": 0.28
        },
        {
          "leftOperand": "odrl:payAmount",
          "operator": "odrl:eq",
          "rightOperand": 2019
        },
        {
          "leftOperand": "odrl:media",
          "operator": "odrl:eq",
          "rightOperand": "web"
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:samplingRate",
          "operator": "odrl:eq",
          "rightOperand": 0.49
        },
        {
          "leftOperand": "odrl:purpose",
          "operator": "odrl:eq",
          "rightOperand": "academic research"
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:spatialResolution",
          "operator": "odrl:eq",
          "rightOperand": 140
        },
        {
          "leftOperand": "odrl:event",
          "operator": "odrl:eq",
          "rightOperand": "termination"
        }
      ]
    }
  ]
}