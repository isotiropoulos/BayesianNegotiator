{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0099_full_infeasible:consumer:hard",
  "assigner": "did:party:policy-owner",
  "assignee": [
    "did:party:museum-research-partners"
  ],
  "target": [
    "urn:asset:digitized-manuscript-collections"
  ],
  "permission": [
    {
      "action": "view",
      "constraint": [
        {
          "leftOperand": "odrl:dateTime",
          "operator": "odrl:gt",
          "rightOperand": "2024-04-26"
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "secure research terminal"
          ]
        },
        {
          "leftOperand": "odrl:relativeTemporalPosition",
          "operator": "odrl:lt",
          "rightOperand": "2024-12-20"
        },
        {
          "leftOperand": "odrl:purpose",
          "operator": "odrl:isNoneOf",
          "rightOperand": [
            "statistics"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:neq",
          "rightOperand": "XLSX"
        },
        {
          "leftOperand": "odrl:samplingRate",
          "operator": "odrl:gt",
          "rightOperand": 0.26
        },
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:eq",
          "rightOperand": "global"
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:percentage",
          "operator": "odrl:gteq",
          "rightOperand": 24
        }
      ]
    }
  ]
}