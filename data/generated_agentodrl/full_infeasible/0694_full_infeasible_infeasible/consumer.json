{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0694_full_infeasible:consumer:aspiration",
  "assigner": "did:party:policy-issuer",
  "assignee": [
    "did:party:researcher"
  ],
  "target": [
    "urn:asset:genomics-data-asset",
    "urn:asset:ethics-credentials-asset"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:confidenceLevel",
          "operator": "odrl:lteq",
          "rightOperand": 0.0
        },
        {
          "leftOperand": "odrl:version",
          "operator": "odrl:lteq",
          "rightOperand": 0
        },
        {
          "leftOperand": "odrl:media",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "web",
            "broadcast"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:delayPeriod",
          "operator": "odrl:lteq",
          "rightOperand": "PT0S"
        },
        {
          "leftOperand": "odrl:event",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "breach",
            "audit"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "maintain",
      "constraint": [
        {
          "leftOperand": "odrl:annualEthicsCredentials",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "up-to-date"
          ]
        },
        {
          "leftOperand": "odrl:percentage",
          "operator": "odrl:gteq",
          "rightOperand": 96
        },
        {
          "leftOperand": "odrl:purpose",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "commercial",
            "差分隐私（ε≤1.2）",
            "legitimate interests of Research Institution or pharmaceutical agency"
          ]
        }
      ]
    }
  ]
}