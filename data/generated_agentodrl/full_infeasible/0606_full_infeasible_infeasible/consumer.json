{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0606_full_infeasible:consumer:aspiration",
  "assigner": "did:party:health-data-space-owner",
  "assignee": [
    "did:party:public-health-authority"
  ],
  "target": [
    "urn:asset:clinical-guidelines-api"
  ],
  "permission": [
    {
      "action": "distribute",
      "constraint": [
        {
          "leftOperand": "odrl:accessMode",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "real-time",
            "no registration required",
            "without standard authentication"
          ]
        },
        {
          "leftOperand": "odrl:samplingRate",
          "operator": "odrl:gteq",
          "rightOperand": 0.9
        },
        {
          "leftOperand": "odrl:payAmount",
          "operator": "odrl:lteq",
          "rightOperand": 0
        },
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "US",
            "Greater Berlin Area",
            "CentralEuropeanCountries"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:count",
          "operator": "odrl:gteq",
          "rightOperand": 360402
        },
        {
          "leftOperand": "odrl:purpose",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "commercial",
            "VirtualExhibitionCreation",
            "PurposeReputationOrMarketing"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:relativeTemporalPosition",
          "operator": "odrl:lteq",
          "rightOperand": "2023-11-23"
        },
        {
          "leftOperand": "odrl:language",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "de",
            "el",
            "en"
          ]
        }
      ]
    }
  ]
}