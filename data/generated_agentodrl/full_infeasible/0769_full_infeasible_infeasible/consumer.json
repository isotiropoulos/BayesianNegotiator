{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0769_full_infeasible:consumer:aspiration",
  "assigner": "did:party:steward-of-su-402",
  "assignee": [
    "did:party:all-parties",
    "did:party:network-administrator"
  ],
  "target": [
    "urn:asset:battery-traceability-records",
    "urn:asset:audit-trails"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:timeInterval",
          "operator": "odrl:lteq",
          "rightOperand": "PT0S"
        },
        {
          "leftOperand": "odrl:virtualLocation",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "eu-cloud",
            "certified_archival_workstation",
            "EU Claims Aggregates"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "export",
      "constraint": [
        {
          "leftOperand": "odrl:destination",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "NonMemberCountries",
            "within the network"
          ]
        },
        {
          "leftOperand": "odrl:spatialResolution",
          "operator": "odrl:lteq",
          "rightOperand": 0
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "XML",
            "image/jpeg",
            "low-resolution images"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "maintainAuditTrail",
      "constraint": [
        {
          "leftOperand": "odrl:elapsedTime",
          "operator": "odrl:gteq",
          "rightOperand": "P34D"
        },
        {
          "leftOperand": "odrl:version",
          "operator": "odrl:lteq",
          "rightOperand": 0
        },
        {
          "leftOperand": "odrl:industry",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "energy",
            "defence",
            "国家工业安全"
          ]
        }
      ]
    }
  ]
}