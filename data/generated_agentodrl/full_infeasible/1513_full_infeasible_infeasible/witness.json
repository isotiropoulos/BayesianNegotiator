{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Agreement",
  "@id": "urn:witness",
  "assigner": "did:party:supply-chain-authority",
  "assignee": [
    "did:party:supply-chain-monitoring-team"
  ],
  "target": [
    "urn:asset:data-provider",
    "urn:asset:monitoring-list"
  ],
  "permission": [
    {
      "action": "monitor",
      "constraint": [
        {
          "leftOperand": "odrl:count",
          "operator": "odrl:eq",
          "rightOperand": 7
        },
        {
          "leftOperand": "odrl:absoluteTemporalPosition",
          "operator": "odrl:eq",
          "rightOperand": "2027-07-13"
        },
        {
          "leftOperand": "odrl:virtualLocation",
          "operator": "odrl:eq",
          "rightOperand": "us-cloud"
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:spatialResolution",
          "operator": "odrl:eq",
          "rightOperand": 362
        },
        {
          "leftOperand": "odrl:language",
          "operator": "odrl:eq",
          "rightOperand": "de"
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:count",
          "operator": "odrl:eq",
          "rightOperand": 7
        },
        {
          "leftOperand": "odrl:industry",
          "operator": "odrl:eq",
          "rightOperand": "energy"
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:eq",
          "rightOperand": "CSV"
        }
      ]
    }
  ]
}