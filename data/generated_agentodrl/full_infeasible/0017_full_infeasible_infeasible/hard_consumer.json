{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0017_full_infeasible:consumer:hard",
  "assigner": "did:party:policy-owner",
  "assignee": [
    "did:party:historians"
  ],
  "target": [
    "urn:asset:17th-century-nautical-logs"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:purpose",
          "operator": "odrl:isNoneOf",
          "rightOperand": [
            "audit"
          ]
        },
        {
          "leftOperand": "odrl:download",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "//example.org/watermark"
          ]
        },
        {
          "leftOperand": "odrl:elapsedTime",
          "operator": "odrl:gteq",
          "rightOperand": "P64DT23H31M23.04S"
        },
        {
          "leftOperand": "odrl:confidenceLevel",
          "operator": "odrl:lt",
          "rightOperand": 0.0
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:unitOfCount",
          "operator": "odrl:gteq",
          "rightOperand": 818
        },
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "US",
            "UserCountry",
            "Region"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:absoluteTemporalPosition",
          "operator": "odrl:gt",
          "rightOperand": "2026-11-30"
        },
        {
          "leftOperand": "odrl:media",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "broadcast",
            "web"
          ]
        }
      ]
    }
  ]
}