{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1496_full_infeasible:consumer:aspiration",
  "assigner": "did:party:smart-agriculture-data-exchange-owner",
  "assignee": [
    "did:party:platform-member"
  ],
  "target": [
    "urn:asset:satellite-crop-imaging-data"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:samplingRate",
          "operator": "odrl:gteq",
          "rightOperand": 0.92
        },
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "US",
            "Region",
            "跨区域联合查询"
          ]
        },
        {
          "leftOperand": "odrl:industry",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "health",
            "state credit industry administrative department",
            "energy"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:percentage",
          "operator": "odrl:gteq",
          "rightOperand": 88
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "CSV",
            "XML",
            "Farm-to-Fork Shipment Data"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "report",
      "constraint": [
        {
          "leftOperand": "odrl:elapsedTime",
          "operator": "odrl:gteq",
          "rightOperand": "P24DT12M"
        },
        {
          "leftOperand": "odrl:payAmount",
          "operator": "odrl:lteq",
          "rightOperand": 0
        },
        {
          "leftOperand": "odrl:virtualLocation",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "on-prem",
            "us-cloud",
            "certified_archival_workstation"
          ]
        }
      ]
    }
  ]
}