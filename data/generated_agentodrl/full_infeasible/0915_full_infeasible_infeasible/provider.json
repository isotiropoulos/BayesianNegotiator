{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0915_full_infeasible:provider:aspiration",
  "assigner": "did:party:traffic-data-provider",
  "assignee": [
    "did:party:active-users"
  ],
  "target": [
    "urn:asset:traffic-live2025"
  ],
  "permission": [
    {
      "action": "submitImpactLogs",
      "constraint": [
        {
          "leftOperand": "odrl:elapsedTime",
          "operator": "odrl:gt",
          "rightOperand": "P2D"
        },
        {
          "leftOperand": "odrl:samplingRate",
          "operator": "odrl:lteq",
          "rightOperand": 0.15
        },
        {
          "leftOperand": "odrl:deliveryChannel",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "s3",
            "https",
            "kafka"
          ]
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "RDF",
            "CSV",
            "XLSX"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:percentage",
          "operator": "odrl:lteq",
          "rightOperand": 11
        },
        {
          "leftOperand": "odrl:event",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "audit",
            "renewal",
            "termination"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:absoluteTemporalPosition",
          "operator": "odrl:lteq",
          "rightOperand": "2026-04-15"
        },
        {
          "leftOperand": "odrl:language",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "es",
            "en",
            "el"
          ]
        }
      ]
    }
  ]
}