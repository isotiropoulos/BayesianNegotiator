{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Agreement",
  "@id": "urn:witness",
  "assigner": "did:party:sensor-data",
  "assignee": [
    "did:party:user"
  ],
  "target": [
    "urn:asset:sensor-data"
  ],
  "permission": [
    {
      "action": "distribute",
      "constraint": [
        {
          "leftOperand": "odrl:userConsent",
          "operator": "odrl:eq",
          "rightOperand": "True"
        },
        {
          "leftOperand": "odrl:percentage",
          "operator": "odrl:eq",
          "rightOperand": 52
        },
        {
          "leftOperand": "odrl:count",
          "operator": "odrl:eq",
          "rightOperand": 314757
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:version",
          "operator": "odrl:eq",
          "rightOperand": 1
        },
        {
          "leftOperand": "odrl:virtualLocation",
          "operator": "odrl:eq",
          "rightOperand": "air-gapped"
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "provide",
      "constraint": [
        {
          "leftOperand": "odrl:sensorDataResolution",
          "operator": "odrl:eq",
          "rightOperand": "high"
        },
        {
          "leftOperand": "odrl:elapsedTime",
          "operator": "odrl:eq",
          "rightOperand": "P41DT20H24M52.033S"
        },
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:eq",
          "rightOperand": "UK"
        }
      ]
    }
  ]
}