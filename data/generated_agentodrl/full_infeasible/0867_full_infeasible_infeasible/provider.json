{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0867_full_infeasible:provider:aspiration",
  "assigner": "did:party:policy-issuer",
  "assignee": [
    "did:party:data-service-provider",
    "did:party:unauthorized-party"
  ],
  "target": [
    "urn:asset:personal-sensitive-data",
    "urn:asset:third-party-report"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:privacyParameter",
          "operator": "odrl:lteq",
          "rightOperand": 1.5
        },
        {
          "leftOperand": "odrl:resolution",
          "operator": "odrl:lteq",
          "rightOperand": 71
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "PARQUET",
            "XLSX",
            "XML"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "distribute",
      "constraint": [
        {
          "leftOperand": "odrl:privacyParameter",
          "operator": "odrl:lteq",
          "rightOperand": 1.5
        },
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "EU",
            "US",
            "global"
          ]
        },
        {
          "leftOperand": "odrl:language",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "de",
            "es",
            "en"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "submitReport",
      "constraint": [
        {
          "leftOperand": "odrl:privacyParameter",
          "operator": "odrl:lteq",
          "rightOperand": 1.5
        },
        {
          "leftOperand": "odrl:media",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "internal-wiki",
            "print",
            "broadcast"
          ]
        }
      ]
    }
  ]
}