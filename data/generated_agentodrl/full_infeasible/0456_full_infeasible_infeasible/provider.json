{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0456_full_infeasible:provider:aspiration",
  "assigner": "did:party:health-authority-party",
  "assignee": [
    "did:party:user-access-party"
  ],
  "target": [
    "urn:asset:pandemic-response"
  ],
  "permission": [
    {
      "action": "read",
      "constraint": [
        {
          "leftOperand": "odrl:healthEmergencyStatus",
          "operator": "odrl:eq",
          "rightOperand": "ended"
        },
        {
          "leftOperand": "odrl:healthEmergencyEndDate",
          "operator": "odrl:gteq",
          "rightOperand": "2023-10-01T00:00:00Z"
        },
        {
          "leftOperand": "odrl:spatialResolution",
          "operator": "odrl:lteq",
          "rightOperand": 482
        },
        {
          "leftOperand": "odrl:purpose",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "education",
            "statistics",
            "audit"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:absoluteTemporalPosition",
          "operator": "odrl:lteq",
          "rightOperand": "2026-04-25"
        },
        {
          "leftOperand": "odrl:media",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "web",
            "broadcast",
            "internal-wiki"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:resolution",
          "operator": "odrl:lteq",
          "rightOperand": 88
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "PARQUET",
            "CSV",
            "XLSX"
          ]
        }
      ]
    }
  ]
}