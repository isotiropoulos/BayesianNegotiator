{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1538_full_infeasible:provider:hard",
  "assigner": "did:party:smart-city-environmental-alliance",
  "assignee": [
    "did:party:counterparty"
  ],
  "target": [
    "urn:asset:urban-air-quality-dataset"
  ],
  "permission": [
    {
      "action": "distribute",
      "constraint": [
        {
          "leftOperand": "odrl:attribution",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "Attribution"
          ]
        },
        {
          "leftOperand": "odrl:shareAlike",
          "operator": "odrl:eq",
          "rightOperand": "ShareAlike"
        },
        {
          "leftOperand": "odrl:relativeTemporalPosition",
          "operator": "odrl:gteq",
          "rightOperand": "2024-06-21"
        },
        {
          "leftOperand": "odrl:resolution",
          "operator": "odrl:gt",
          "rightOperand": 30
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:percentage",
          "operator": "odrl:lteq",
          "rightOperand": 80
        },
        {
          "leftOperand": "odrl:virtualLocation",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "eu-cloud",
            "hybrid",
            "edge"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:spatialResolution",
          "operator": "odrl:gteq",
          "rightOperand": 111
        },
        {
          "leftOperand": "odrl:purpose",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "journalism",
            "statistics",
            "marketing"
          ]
        }
      ]
    }
  ]
}