{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1770_close_narrow:consumer:aspiration",
  "assigner": "did:party:policy-issuer",
  "assignee": [
    "did:party:research-participant"
  ],
  "target": [
    "urn:asset:research-participant-rights",
    "urn:asset:privacy-policy"
  ],
  "permission": [
    {
      "action": "rightToKnow",
      "constraint": [
        {
          "leftOperand": "odrl:dateTime",
          "operator": "odrl:gteq",
          "rightOperand": "2025-05-11"
        },
        {
          "leftOperand": "odrl:event",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "breach",
            "audit"
          ]
        },
        {
          "leftOperand": "odrl:language",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "el",
            "fr",
            "en"
          ]
        }
      ]
    },
    {
      "action": "rightToAccess",
      "constraint": [
        {
          "leftOperand": "odrl:dateTime",
          "operator": "odrl:gteq",
          "rightOperand": "2025-05-11"
        }
      ]
    },
    {
      "action": "rightToOptOut",
      "constraint": [
        {
          "leftOperand": "odrl:dateTime",
          "operator": "odrl:gteq",
          "rightOperand": "2025-05-11"
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "global",
            "UserCountry",
            "SchengenArea"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "optOut",
      "constraint": [
        {
          "leftOperand": "odrl:dateTime",
          "operator": "odrl:gteq",
          "rightOperand": "2025-05-11"
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "PARQUET",
            "XLSX",
            "SubstationOperationData"
          ]
        }
      ]
    }
  ]
}