{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0905_close_narrow:consumer:hard",
  "assigner": "did:party:user-account",
  "assignee": [
    "did:party:system"
  ],
  "target": [
    "urn:asset:user-account"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:relativeTemporalPosition",
          "operator": "odrl:lteq",
          "rightOperand": "2026-01-24"
        },
        {
          "leftOperand": "odrl:resolution",
          "operator": "odrl:lt",
          "rightOperand": 30
        },
        {
          "leftOperand": "odrl:systemDevice",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "hsm",
            "DesignatedXREquipment",
            "authorized_mixed_reality_headset"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:count",
          "operator": "odrl:gteq",
          "rightOperand": 273790
        },
        {
          "leftOperand": "odrl:virtualLocation",
          "operator": "odrl:neq",
          "rightOperand": "edge"
        },
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "global"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:version",
          "operator": "odrl:lt",
          "rightOperand": 2
        },
        {
          "leftOperand": "odrl:media",
          "operator": "odrl:isNoneOf",
          "rightOperand": [
            "broadcast"
          ]
        }
      ]
    }
  ]
