{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1449_close_narrow:provider:hard",
  "assigner": "did:party:policy-owner",
  "assignee": [
    "did:party:platform-api"
  ],
  "target": [
    "urn:asset:gn-energy-usage-peak-load-score"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:absoluteSpatialPosition",
          "operator": "odrl:neq",
          "rightOperand": "domestic"
        },
        {
          "leftOperand": "odrl:version",
          "operator": "odrl:gteq",
          "rightOperand": 1
        },
        {
          "leftOperand": "odrl:samplingRate",
          "operator": "odrl:lt",
          "rightOperand": 0.19
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "distribute",
      "constraint": [
        {
          "leftOperand": "odrl:bulkExport",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "False"
          ]
        },
        {
          "leftOperand": "odrl:share",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "False"
          ]
        },
        {
          "leftOperand": "odrl:absoluteTemporalPosition",
          "operator": "odrl:lteq",
          "rightOperand": "2026-10-23"
        },
        {
          "leftOperand": "odrl:systemDevice",
          "operator": "odrl:isNoneOf",
          "rightOperand": [
            "bare-metal"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:unitOfCount",
          "operator": "odrl:lteq",
          "rightOperand": 1280
        }
      ]
    }
  ]
}