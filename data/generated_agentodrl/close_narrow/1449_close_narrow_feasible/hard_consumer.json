{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1449_close_narrow:consumer:hard",
  "assigner": "did:party:policy-owner",
  "assignee": [
    "did:party:platform-api"
  ],
  "target": [
    "urn:asset:gn-energy-usage-peak-load-score"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:absoluteSpatialPosition",
          "operator": "odrl:eq",
          "rightOperand": "Gaia-X Trusted Zone"
        },
        {
          "leftOperand": "odrl:version",
          "operator": "odrl:lt",
          "rightOperand": 3
        },
        {
          "leftOperand": "odrl:samplingRate",
          "operator": "odrl:gt",
          "rightOperand": 0.17
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "distribute",
      "constraint": [
        {
          "leftOperand": "odrl:bulkExport",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "False"
          ]
        },
        {
          "leftOperand": "odrl:share",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "False"
          ]
        },
        {
          "leftOperand": "odrl:absoluteTemporalPosition",
          "operator": "odrl:gt",
          "rightOperand": "2026-09-28"
        },
        {
          "leftOperand": "odrl:systemDevice",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "vm",
            "hsm",
            "Australia Spatial Data Hub"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:unitOfCount",
          "operator": "odrl:gt",
          "rightOperand": 1231
        }
      ]
    }
  ]
}