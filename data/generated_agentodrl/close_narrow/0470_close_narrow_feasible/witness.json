          "operator": "odrl:eq",
          "rightOperand": 70
        },
        {
          "leftOperand": "odrl:event",
          "operator": "odrl:eq",
          "rightOperand": "audit"
        },
        {
          "leftOperand": "odrl:purpose",
          "operator": "odrl:eq",
          "rightOperand": "//w3id.org/drk/AITrainingAllowed"
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:percentage",
          "operator": "odrl:eq",
          "rightOperand": 18
        },
        {
          "leftOperand": "odrl:systemDevice",
