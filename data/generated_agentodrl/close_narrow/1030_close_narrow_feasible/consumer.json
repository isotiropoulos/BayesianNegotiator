{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1030_close_narrow:consumer:aspiration",
  "assigner": "did:party:policy-owner-party",
  "assignee": [
    "did:party:user",
    "did:party:parent-guardian"
  ],
  "target": [
    "urn:asset:user-account",
    "urn:asset:user"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:userAge",
          "operator": "odrl:gteq",
          "rightOperand": 25
        },
        {
          "leftOperand": "odrl:elapsedTime",
          "operator": "odrl:gteq",
          "rightOperand": "P40DT20H50M25.926S"
        },
        {
          "leftOperand": "odrl:systemDevice",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "tee",
            "consortium-approved",
            "Australia Spatial Data Hub"
          ]
        },
        {
          "leftOperand": "odrl:industry",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "defence",
            "医院数据提供方",
            "mobility"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:confidenceLevel",
          "operator": "odrl:lteq",
          "rightOperand": 0.36
        },
        {
          "leftOperand": "odrl:language",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "el",
            "de",
            "fr"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:spatialResolution",
          "operator": "odrl:lteq",
          "rightOperand": 341
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "XML",
            "passenger name record data",
            "structured, commonly used, machine-readable"
          ]
        }
      ]
    }
  ]
}