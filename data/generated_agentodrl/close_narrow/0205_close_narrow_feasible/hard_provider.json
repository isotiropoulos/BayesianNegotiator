{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0205_close_narrow:provider:hard",
  "assigner": "did:party:energy-provider",
  "assignee": [
    "did:party:self"
  ],
  "target": [
    "urn:asset:residential-consumption-profiles"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:unitOfCount",
          "operator": "odrl:lteq",
          "rightOperand": 760
        },
        {
          "leftOperand": "odrl:absoluteTemporalPosition",
          "operator": "odrl:lteq",
          "rightOperand": "2026-10-31"
        },
        {
          "leftOperand": "odrl:systemDevice",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "bare-metal"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:relativeTemporalPosition",
          "operator": "odrl:gt",
          "rightOperand": "2025-12-26"
        },
        {
          "leftOperand": "odrl:purpose",
          "operator": "odrl:neq",
          "rightOperand": "audit"
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "PARQUET",
            "RDF",
            "XML"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:samplingRate",
          "operator": "odrl:lt",
          "rightOperand": 0.18
        },
        {
          "leftOperand": "odrl:language",
          "operator": "odrl:eq",
          "rightOperand": "de"
        }
      ]
    }
  ]
}