  "assigner": "did:party:policy-to-delete-account-assigner",
  "assignee": [
    "did:party:counterparty"
  ],
  "target": [
    "urn:asset:account"
  ],
  "permission": [
    {
      "action": "delete",
      "constraint": [
        {
          "leftOperand": "odrl:link",
          "operator": "odrl:isAnyOf",
