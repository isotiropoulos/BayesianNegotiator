{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1805_close_narrow:consumer:hard",
  "assigner": "did:party:credit-report-asset",
  "assignee": [
    "did:party:credit-reporting-agency"
  ],
  "target": [
    "urn:asset:credit-report-asset",
    "urn:asset:transfer-mechanism"
  ],
  "permission": [
    {
      "action": "transfer",
      "constraint": [
        {
          "leftOperand": "odrl:requestingIndividual",
          "operator": "odrl:eq",
          "rightOperand": "true"
        },
        {
          "leftOperand": "odrl:count",
          "operator": "odrl:gteq",
          "rightOperand": 263305
        },
        {
          "leftOperand": "odrl:absoluteTemporalPosition",
          "operator": "odrl:gt",
          "rightOperand": "2026-10-02"
        },
        {
          "leftOperand": "odrl:industry",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "public",
            "finance",
            "医院数据提供方"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:spatialResolution",
          "operator": "odrl:lteq",
          "rightOperand": 242
        },
        {
          "leftOperand": "odrl:media",
          "operator": "odrl:isNoneOf",
          "rightOperand": [
            "internal-wiki"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:samplingRate",
          "operator": "odrl:gt",
          "rightOperand": 0.19
        },
        {
          "leftOperand": "odrl:purpose",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "commercial"
          ]
        }
      ]
    }
  ]
