{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1462_close_narrow:consumer:aspiration",
  "assigner": "did:party:city-infra-owner",
  "assignee": [
    "did:party:urban-sense"
  ],
  "target": [
    "urn:asset:ci-traffic-sensors"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:payAmount",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "PerQueryFee",
            "free",
            "per-use"
          ]
        },
        {
          "leftOperand": "odrl:meteredTime",
          "operator": "odrl:gteq",
          "rightOperand": "P7DT22H44M10.694S"
        },
        {
          "leftOperand": "odrl:timeInterval",
          "operator": "odrl:lteq",
          "rightOperand": "P11DT22H5M5.582S"
        },
        {
          "leftOperand": "odrl:recipient",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "affiliate",
            "authorized_dealership",
            "Party:LegalAuthority"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:percentage",
          "operator": "odrl:gteq",
          "rightOperand": 30
        },
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "EEA",
            "Gaia-X Trusted Zone",
            "EU"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:spatialResolution",
          "operator": "odrl:lteq",
          "rightOperand": 192
        },
        {
          "leftOperand": "odrl:media",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "print",
            "broadcast"
          ]
        }
      ]
    }
  ]
}