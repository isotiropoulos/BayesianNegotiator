  "assigner": "did:party:shipping-authority",
  "assignee": [
    "did:party:shipping-company"
  ],
  "target": [
    "urn:asset:asset-email",
    "urn:asset:asset-imo"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:timeInterval",
          "operator": "odrl:lteq",
          "rightOperand": "P7DT12H56M55.537S"
        },
        {
          "leftOperand": "odrl:relativeTemporalPosition",
          "operator": "odrl:lteq",
          "rightOperand": "2025-10-11"
        },
        {
          "leftOperand": "odrl:event",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "termination",
            "breach"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:resolution",
          "operator": "odrl:lteq",
          "rightOperand": 43
        },
        {
          "leftOperand": "odrl:recipient",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "third-party",
            "MaaSOperator",
            "ValidatedNetherlandsIP"
          ]
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "JSON",
            "HourlyPollutionSensorReadings",
            "low-resolution images"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:confidenceLevel",
          "operator": "odrl:lteq",
          "rightOperand": 0.35
        },
        {
          "leftOperand": "odrl:language",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "de",
            "el",
            "en"
          ]
        }
      ]
