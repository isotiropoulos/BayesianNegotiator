          "leftOperand": "odrl:floodAlertLevel",
          "operator": "odrl:lteq",
          "rightOperand": 2
        },
        {
          "leftOperand": "odrl:timeInterval",
          "operator": "odrl:lt",
          "rightOperand": "P6DT10H23M41.683S"
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "JSON"
          ]
        },
        {
          "leftOperand": "odrl:industry",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "energy",
            "医院数据提供方",
            "mobility"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:delayPeriod",
          "operator": "odrl:lt",
          "rightOperand": "P9DT11H55M26.092S"
        },
        {
          "leftOperand": "odrl:media",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "print",
            "broadcast"
          ]
        }
