{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0219_close_narrow:consumer:aspiration",
  "assigner": "did:party:european-data-authority",
  "assignee": [
    "did:party:agri-tech-startups"
  ],
  "target": [
    "urn:asset:european-agri-data-space-crop-yield-api"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:percentage",
          "operator": "odrl:gteq",
          "rightOperand": 34
        },
        {
          "leftOperand": "odrl:confidenceLevel",
          "operator": "odrl:lteq",
          "rightOperand": 0.36
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "RDF",
            "image/jpeg",
            "SubstationOperationData"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:resolution",
          "operator": "odrl:lteq",
          "rightOperand": 39
        },
        {
          "leftOperand": "odrl:systemDevice",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "container",
            "tee",
            "Australia Spatial Data Hub"
          ]
        },
        {
          "leftOperand": "odrl:event",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "renewal",
            "termination"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:timeInterval",
          "operator": "odrl:lteq",
          "rightOperand": "P3DT9H52M54.51S"
        },
        {
          "leftOperand": "odrl:virtualLocation",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "edge",
            "http://example.org/servers",
            "FrenchIP"
          ]
        }
      ]
    }
