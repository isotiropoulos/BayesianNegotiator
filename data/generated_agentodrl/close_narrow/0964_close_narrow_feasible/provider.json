{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0964_close_narrow:provider:aspiration",
  "assigner": "did:party:policy-owner",
  "assignee": [
    "did:party:party"
  ],
  "target": [
    "urn:asset:data-authorization-proof",
    "urn:asset:data",
    "urn:asset:arbitration-result",
    "urn:asset:city-security-report",
    "urn:asset:data-flow"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:percentage",
          "operator": "odrl:lteq",
          "rightOperand": 14
        },
        {
          "leftOperand": "odrl:samplingRate",
          "operator": "odrl:lteq",
          "rightOperand": 0.08
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "XLSX",
            "JSON",
            "XML"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:elapsedTime",
          "operator": "odrl:lteq",
          "rightOperand": "P50DT42M7.067S"
        },
        {
          "leftOperand": "odrl:industry",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "defence",
            "finance",
            "retail"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "freezeDataFlow",
      "constraint": [
        {
          "leftOperand": "odrl:involvedInCitySecurity",
          "operator": "odrl:eq",
          "rightOperand": "true"
        },
        {
          "leftOperand": "odrl:spatialResolution",
          "operator": "odrl:lteq",
          "rightOperand": 377
        },
        {
          "leftOperand": "odrl:virtualLocation",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "edge",
            "eu-cloud",
            "air-gapped"
          ]
        }
      ]
    }
  ]
