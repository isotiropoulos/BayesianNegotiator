{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1010_close_narrow:provider:hard",
  "assigner": "did:party:data-service-provider",
  "assignee": [
    "did:party:platform-operator"
  ],
  "target": [
    "urn:asset:asset",
    "urn:asset:technical-compliance",
    "urn:asset:third-party-report"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:delayPeriod",
          "operator": "odrl:gt",
          "rightOperand": "P3DT5H5M20.153S"
        },
        {
          "leftOperand": "odrl:meteredTime",
          "operator": "odrl:lt",
          "rightOperand": "P6DT10H57M30.753S"
        },
        {
          "leftOperand": "odrl:systemDevice",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "bare-metal",
            "tee",
            "hsm"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:percentage",
          "operator": "odrl:lt",
          "rightOperand": 25
        },
        {
          "leftOperand": "odrl:recipient",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "third-party"
          ]
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:eq",
          "rightOperand": "PARQUET"
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:version",
          "operator": "odrl:gt",
          "rightOperand": 0
        },
        {
          "leftOperand": "odrl:deliveryChannel",
          "operator": "odrl:neq",
          "rightOperand": "courier"
        }
      ]
    }
  ]
}