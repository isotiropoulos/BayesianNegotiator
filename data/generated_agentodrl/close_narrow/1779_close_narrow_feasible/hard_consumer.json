{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1779_close_narrow:consumer:hard",
  "assigner": "did:party:policy-issuer",
  "assignee": [
    "did:party:platform-operator"
  ],
  "target": [
    "urn:asset:social-graph-data"
  ],
  "permission": [
    {
      "action": "distribute",
      "constraint": [
        {
          "leftOperand": "odrl:recipient",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "drk:registeredUser",
            "DesignatedDataServiceProvider",
            "Party:LegalAuthority"
          ]
        },
        {
          "leftOperand": "odrl:confidenceLevel",
          "operator": "odrl:lteq",
          "rightOperand": 0.44
        },
        {
          "leftOperand": "odrl:samplingRate",
          "operator": "odrl:gt",
          "rightOperand": 0.18
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "distribute",
      "constraint": [
        {
          "leftOperand": "odrl:recipient",
          "operator": "odrl:isNoneOf",
          "rightOperand": [
            "regulator"
          ]
        },
        {
          "leftOperand": "odrl:absoluteTemporalPosition",
          "operator": "odrl:gteq",
          "rightOperand": "2026-09-13"
        },
        {
          "leftOperand": "odrl:industry",
          "operator": "odrl:neq",
          "rightOperand": "defence"
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:version",
          "operator": "odrl:lteq",
          "rightOperand": 4
        },
        {
          "leftOperand": "odrl:systemDevice",
          "operator": "odrl:eq",
          "rightOperand": "bare-metal"
        }
      ]
    }
  ]
