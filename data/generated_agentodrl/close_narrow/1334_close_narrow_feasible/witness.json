{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Agreement",
  "@id": "urn:witness",
  "assigner": "did:party:audit-process",
  "assignee": [
    "did:party:counterparty"
  ],
  "target": [
    "urn:asset:audit-process",
    "urn:asset:all-participants"
  ],
  "permission": [
    {
      "action": "update",
      "constraint": [
        {
          "leftOperand": "odrl:legalRegulationOrStandardRevisionOrRelease",
          "operator": "odrl:eq",
          "rightOperand": "null"
        },
        {
          "leftOperand": "odrl:spatialResolution",
          "operator": "odrl:eq",
          "rightOperand": 318
        },
        {
          "leftOperand": "odrl:purpose",
          "operator": "odrl:eq",
          "rightOperand": "commercial"
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:payAmount",
          "operator": "odrl:eq",
          "rightOperand": 2072
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:legalRegulationOrStandardRevisionOrRelease",
          "operator": "odrl:eq",
          "rightOperand": "null"
        },
        {
          "leftOperand": "odrl:samplingRate",
          "operator": "odrl:eq",
          "rightOperand": 0.2
        }
      ]
    },
    {
      "action": "update",
      "constraint": [
        {
          "leftOperand": "odrl:delayPeriod",
          "operator": "odrl:eq",
          "rightOperand": "P24D"
        },
        {
          "leftOperand": "odrl:legalRegulationOrStandardRevisionOrRelease",
          "operator": "odrl:eq",
          "rightOperand": "null"
        }
      ]
    }
  ]
}