{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0262_close_narrow:provider:aspiration",
  "assigner": "did:party:data-owner",
  "assignee": [
    "did:party:open-research-portal",
    "did:party:unauthorized-entity"
  ],
  "target": [
    "urn:asset:genomic-sequencing-results"
  ],
  "permission": [
    {
      "action": "distribute",
      "constraint": [
        {
          "leftOperand": "odrl:elapsedTime",
          "operator": "odrl:lt",
          "rightOperand": "P10D"
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "JSON",
            "PARQUET",
            "XLSX"
          ]
        },
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "CH",
            "UK",
            "US"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "distribute",
      "constraint": [
        {
          "leftOperand": "odrl:elapsedTime",
          "operator": "odrl:lt",
          "rightOperand": "P10D"
        },
        {
          "leftOperand": "odrl:deliveryChannel",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "courier",
            "https",
            "kafka"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "delay",
      "constraint": [
        {
          "leftOperand": "odrl:delay",
          "operator": "odrl:lt",
          "rightOperand": 48
        },
        {
          "leftOperand": "odrl:elapsedTime",
          "operator": "odrl:lt",
          "rightOperand": "P10D"
        },
        {
          "leftOperand": "odrl:media",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "broadcast",
            "print",
            "internal-wiki"
          ]
        }
      ]
    }
  ]
}