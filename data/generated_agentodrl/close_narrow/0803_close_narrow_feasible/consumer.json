{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0803_close_narrow:consumer:aspiration",
  "assigner": "did:party:policy-owner",
  "assignee": [
    "did:party:party-owner"
  ],
  "target": [
    "urn:asset:stream-asset"
  ],
  "permission": [
    {
      "action": "distribute",
      "constraint": [
        {
          "leftOperand": "odrl:hasSourceIdentification",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "visible"
          ]
        },
        {
          "leftOperand": "odrl:relativeTemporalPosition",
          "operator": "odrl:lteq",
          "rightOperand": "2025-07-28"
        },
        {
          "leftOperand": "odrl:samplingRate",
          "operator": "odrl:gteq",
          "rightOperand": 0.33
        },
        {
          "leftOperand": "odrl:virtualLocation",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "air-gapped",
            "us-cloud",
            "eu-cloud"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:count",
          "operator": "odrl:gteq",
          "rightOperand": 289055
        },
        {
          "leftOperand": "odrl:deliveryChannel",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "kafka",
            "s3",
            "SupportChannel"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:payAmount",
          "operator": "odrl:lteq",
          "rightOperand": 1838
        },
        {
          "leftOperand": "odrl:recipient",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "public",
            "ResponsiblePersonnel",
            "DesignatedDataServiceProvider"
          ]
        }
      ]
    }
  ]
}