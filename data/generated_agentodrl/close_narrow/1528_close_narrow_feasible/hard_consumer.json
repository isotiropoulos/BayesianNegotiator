{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1528_close_narrow:consumer:hard",
  "assigner": "did:party:policy-issuer",
  "assignee": [
    "did:party:network-operator"
  ],
  "target": [
    "urn:asset:asset1",
    "urn:asset:deployment-rights"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:version",
          "operator": "odrl:lt",
          "rightOperand": 3
        },
        {
          "leftOperand": "odrl:absoluteTemporalPosition",
          "operator": "odrl:gt",
          "rightOperand": "2026-12-07"
        },
        {
          "leftOperand": "odrl:purpose",
          "operator": "odrl:neq",
          "rightOperand": "audit"
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:count",
          "operator": "odrl:gt",
          "rightOperand": 311600
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:neq",
          "rightOperand": "XLSX"
        },
        {
          "leftOperand": "odrl:media",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "broadcast"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:elapsedTime",
          "operator": "odrl:gt",
          "rightOperand": "P33DT17H20M17.64S"
        },
        {
          "leftOperand": "odrl:language",
          "operator": "odrl:neq",
          "rightOperand": "es"
        }
      ]
    }
  ]
}