{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1689_close_narrow:consumer:hard",
  "assigner": "did:party:steward-of-cu-p-704",
  "assignee": [
    "did:party:credit-reporting-agency"
  ],
  "target": [
    "urn:asset:credit-report",
    "urn:asset:enterprise"
  ],
  "permission": [
    {
      "action": "process",
      "constraint": [
        {
          "leftOperand": "odrl:legalOrRegulatoryRequirement",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "confidential",
            "notification",
            "true"
          ]
        },
        {
          "leftOperand": "odrl:version",
          "operator": "odrl:lt",
          "rightOperand": 3
        },
        {
          "leftOperand": "odrl:payAmount",
          "operator": "odrl:lt",
          "rightOperand": 5001
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "inform",
      "constraint": [
        {
          "leftOperand": "odrl:legalOrRegulatoryRequirement",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "confidential"
          ]
        },
        {
          "leftOperand": "odrl:confidenceLevel",
          "operator": "odrl:lt",
          "rightOperand": 0.45
        },
        {
          "leftOperand": "odrl:event",
          "operator": "odrl:neq",
          "rightOperand": "renewal"
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:absoluteTemporalPosition",
          "operator": "odrl:gteq",
          "rightOperand": "2026-11-04"
        },
        {
          "leftOperand": "odrl:industry",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "defence"
          ]
        }
      ]
    }
  ]
}