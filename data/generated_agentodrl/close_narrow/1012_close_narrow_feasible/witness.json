{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Agreement",
  "@id": "urn:witness",
  "assigner": "did:party:policy-issuer",
  "assignee": [
    "did:party:policy-issuer",
    "did:party:data-operator",
    "did:party:log-manager",
    "did:party:zkpservice"
  ],
  "target": [
    "urn:asset:financial-blockchain",
    "urn:asset:sensitive-financial-fields",
    "urn:asset:all-data-operations",
    "urn:asset:logs-retention",
    "urn:asset:sensitive-financial-fields-or-cross-border",
    "urn:asset:zkpcontent"
  ],
  "permission": [
    {
      "action": "hashAndAnchor",
      "constraint": [
        {
          "leftOperand": "odrl:dateTime",
          "operator": "odrl:eq",
          "rightOperand": "P2044D"
        },
        {
          "leftOperand": "odrl:recipient",
          "operator": "odrl:eq",
          "rightOperand": "//example.org/parties/agriTechCompany"
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "crossBorderTransfer",
      "constraint": [
        {
          "leftOperand": "odrl:dateTime",
          "operator": "odrl:eq",
          "rightOperand": "P2044D"
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:eq",
          "rightOperand": "RDF"
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "recordLogs",
      "constraint": [
        {
          "leftOperand": "odrl:dateTime",
          "operator": "odrl:eq",
          "rightOperand": "P2044D"
        }
      ]
    },
    {
      "action": "retainLogs",
      "constraint": [
        {
          "leftOperand": "odrl:dateTime",
          "operator": "odrl:eq",
          "rightOperand": "P2044D"
        }
      ]
    },
    {
      "action": "applyZKP",
      "constraint": [
        {
          "leftOperand": "odrl:dateTime",
          "operator": "odrl:eq",
          "rightOperand": "P2044D"
        }
      ]
    },
    {
      "action": "hashAndAnchor",
      "constraint": [
        {
          "leftOperand": "odrl:dateTime",
          "operator": "odrl:eq",
          "rightOperand": "P2044D"
        }
      ]
    }
  ]
}