      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:version",
          "operator": "odrl:eq",
          "rightOperand": 2
        },
        {
          "leftOperand": "odrl:resolution",
          "operator": "odrl:eq",
          "rightOperand": 72
        },
        {
          "leftOperand": "odrl:virtualLocation",
          "operator": "odrl:eq",
          "rightOperand": "us-cloud"
