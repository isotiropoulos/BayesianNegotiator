      ]
    }
  ],
  "prohibition": [
    {
      "action": "distribute",
      "constraint": [
        {
          "leftOperand": "odrl:absoluteSpatialPosition",
          "operator": "odrl:eq",
          "rightOperand": "Germany"
        },
        {
          "leftOperand": "odrl:meteredTime",
          "operator": "odrl:eq",
          "rightOperand": "P7DT10H55M55.895S"
        },
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:eq",
          "rightOperand": "ASEAN"
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:delayPeriod",
          "operator": "odrl:eq",
          "rightOperand": "P7DT6H1M42.279S"
        },
        {
          "leftOperand": "odrl:language",
          "operator": "odrl:eq",
          "rightOperand": "en"
        }
      ]
    }
  ]
