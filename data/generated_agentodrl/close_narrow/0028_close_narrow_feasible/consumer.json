{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0028_close_narrow:consumer:aspiration",
  "assigner": "did:party:archive-owner-party",
  "assignee": [
    "did:party:researcher-party"
  ],
  "target": [
    "urn:asset:stockholm-nobel-archive-manuscripts"
  ],
  "permission": [
    {
      "action": "quote",
      "constraint": [
        {
          "leftOperand": "odrl:extractedWords",
          "operator": "odrl:gteq",
          "rightOperand": 700
        },
        {
          "leftOperand": "odrl:confidenceLevel",
          "operator": "odrl:lteq",
          "rightOperand": 0.35
        },
        {
          "leftOperand": "odrl:industry",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "mobility",
            "retail",
            "finance"
          ]
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "JSON",
            "image/jpeg",
            "low-resolution images"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:resolution",
          "operator": "odrl:lteq",
          "rightOperand": 41
        },
        {
          "leftOperand": "odrl:recipient",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "third-party",
            "authorized_dealership",
            "CarOwner"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:timeInterval",
          "operator": "odrl:lteq",
          "rightOperand": "P11DT13H30M0.874S"
        },
        {
          "leftOperand": "odrl:language",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "fr",
            "es",
            "de"
          ]
        }
      ]
    }
  ]
}