{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1522_close_narrow:consumer:hard",
  "assigner": "did:party:policy-owner",
  "assignee": [
    "did:party:independent-gaia-xsandbox-environment"
  ],
  "target": [
    "urn:asset:demand-forecast-model"
  ],
  "permission": [
    {
      "action": "evaluate",
      "constraint": [
        {
          "leftOperand": "odrl:purpose",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "BiasRobustnessEvaluation"
          ]
        },
        {
          "leftOperand": "odrl:confidenceLevel",
          "operator": "odrl:lt",
          "rightOperand": 0.45
        },
        {
          "leftOperand": "odrl:relativeTemporalPosition",
          "operator": "odrl:lt",
          "rightOperand": "2026-01-02"
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "develop",
      "constraint": [
        {
          "leftOperand": "odrl:purpose",
          "operator": "odrl:isNoneOf",
          "rightOperand": [
            "audit"
          ]
        },
        {
          "leftOperand": "odrl:percentage",
          "operator": "odrl:gteq",
          "rightOperand": 16
        },
        {
          "leftOperand": "odrl:media",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "broadcast",
            "print"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "evaluate",
      "constraint": [
        {
          "leftOperand": "odrl:purpose",
          "operator": "odrl:eq",
          "rightOperand": "BiasRobustnessEvaluation"
        },
        {
          "leftOperand": "odrl:count",
          "operator": "odrl:gt",
          "rightOperand": 180707
        }
      ]
    }
  ]
}