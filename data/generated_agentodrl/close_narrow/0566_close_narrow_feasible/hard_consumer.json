{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0566_close_narrow:consumer:hard",
  "assigner": "did:party:french-national-art-repository",
  "assignee": [
    "did:party:authenticated-art-historians"
  ],
  "target": [
    "urn:asset:digitized-impressionist-paintings"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:environment",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "drk:OpenScienceCloud",
            "ENISA-compliant secure environments",
            "ISO 27701"
          ]
        },
        {
          "leftOperand": "odrl:watermark",
          "operator": "odrl:eq",
          "rightOperand": "True"
        },
        {
          "leftOperand": "odrl:confidenceLevel",
          "operator": "odrl:lt",
          "rightOperand": 0.47
        },
        {
          "leftOperand": "odrl:absoluteTemporalPosition",
          "operator": "odrl:gteq",
          "rightOperand": "2026-11-16"
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "download",
      "constraint": [
        {
          "leftOperand": "odrl:watermark",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "True"
          ]
        },
        {
          "leftOperand": "odrl:elapsedTime",
          "operator": "odrl:gt",
          "rightOperand": "P27DT18H12M52.627S"
        },
        {
          "leftOperand": "odrl:language",
          "operator": "odrl:neq",
          "rightOperand": "es"
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:payAmount",
          "operator": "odrl:lt",
          "rightOperand": 4856
        }
      ]
    }
  ]
}