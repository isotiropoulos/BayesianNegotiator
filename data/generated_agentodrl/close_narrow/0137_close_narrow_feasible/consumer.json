    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:elapsedTime",
          "operator": "odrl:gteq",
          "rightOperand": "P63DT3H56M6.321S"
        },
        {
          "leftOperand": "odrl:event",
