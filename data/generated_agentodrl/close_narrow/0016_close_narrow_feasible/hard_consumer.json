      "action": "distribute",
      "constraint": [
        {
          "leftOperand": "odrl:payAmount",
          "operator": "odrl:gt",
          "rightOperand": -1
        },
        {
          "leftOperand": "odrl:purpose",
          "operator": "odrl:eq",
          "rightOperand": "PurposeReputationOrMarketing"
        },
        {
          "leftOperand": "odrl:timeInterval",
          "operator": "odrl:lteq",
          "rightOperand": "P10DT4H9M20.167S"
        },
        {
          "leftOperand": "odrl:virtualLocation",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "eu-cloud",
            "hybrid",
            "EU Claims Aggregates"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:version",
          "operator": "odrl:lteq",
          "rightOperand": 4
        },
        {
          "leftOperand": "odrl:media",
          "operator": "odrl:eq",
          "rightOperand": "internal-wiki"
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
