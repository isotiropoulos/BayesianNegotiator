{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1178_close_narrow:consumer:hard",
  "assigner": "did:party:policy-owner",
  "assignee": [
    "did:party:research-institution"
  ],
  "target": [
    "urn:asset:clinical-trial-results"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:confidenceLevel",
          "operator": "odrl:lt",
          "rightOperand": 0.45
        },
        {
          "leftOperand": "odrl:event",
          "operator": "odrl:neq",
          "rightOperand": "termination"
        },
        {
          "leftOperand": "odrl:recipient",
          "operator": "odrl:eq",
          "rightOperand": "internal-only"
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:timeInterval",
          "operator": "odrl:lteq",
          "rightOperand": "P22DT5H41M28.573S"
        },
        {
          "leftOperand": "odrl:virtualLocation",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "us-cloud",
            "certified_archival_workstation",
            "http://example.org/servers"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "fileIncidentReport",
      "constraint": [
        {
          "leftOperand": "odrl:dateTime",
          "operator": "odrl:gteq",
          "rightOperand": "2024-01-06"
        },
        {
          "leftOperand": "odrl:delayPeriod",
          "operator": "odrl:lt",
          "rightOperand": "P6DT9H24M11.803S"
        },
        {
          "leftOperand": "odrl:language",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "en",
            "de",
            "es"
          ]
        }
      ]
    }
  ]
}