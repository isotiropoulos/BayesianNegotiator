{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0572_close_narrow:provider:hard",
  "assigner": "did:party:policy-owner",
  "assignee": [
    "did:party:research-institutes"
  ],
  "target": [
    "urn:asset:digital-archive-blueprints",
    "urn:asset:derivatives"
  ],
  "permission": [
    {
      "action": "transform",
      "constraint": [
        {
          "leftOperand": "odrl:purpose",
          "operator": "odrl:neq",
          "rightOperand": "audit"
        },
        {
          "leftOperand": "odrl:samplingRate",
          "operator": "odrl:lteq",
          "rightOperand": 0.21
        },
        {
          "leftOperand": "odrl:resolution",
          "operator": "odrl:gteq",
          "rightOperand": 28
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:purpose",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "publicExhibition",
            "commercialExploitation",
            "researchSeminar"
          ]
        },
        {
          "leftOperand": "odrl:absoluteTemporalPosition",
          "operator": "odrl:lt",
          "rightOperand": "2026-11-25"
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:neq",
          "rightOperand": "XLSX"
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:timeInterval",
          "operator": "odrl:gt",
          "rightOperand": "P6DT10H32M9.53S"
        },
        {
          "leftOperand": "odrl:event",
          "operator": "odrl:isNoneOf",
          "rightOperand": [
            "termination"
          ]
        }
      ]
    }
  ]
}