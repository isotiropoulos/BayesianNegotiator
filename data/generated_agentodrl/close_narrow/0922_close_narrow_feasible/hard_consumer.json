{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0922_close_narrow:consumer:hard",
  "assigner": "did:party:policy-issuer",
  "assignee": [
    "did:party:logistics-partner"
  ],
  "target": [
    "urn:asset:logi-fleet-data-asset",
    "urn:asset:logistics-association"
