{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0244_close_narrow:consumer:hard",
  "assigner": "did:party:archive-administrator",
  "assignee": [
    "did:party:user"
  ],
  "target": [
    "urn:asset:digital-poetry-manuscript-archive"
  ],
  "permission": [
    {
      "action": "download",
      "constraint": [
        {
          "leftOperand": "odrl:purpose",
          "operator": "odrl:eq",
          "rightOperand": "ExplicitWrittenConsent"
        },
        {
          "leftOperand": "odrl:delayPeriod",
          "operator": "odrl:lteq",
          "rightOperand": "P4DT22H1M49.663S"
        },
        {
          "leftOperand": "odrl:timeInterval",
          "operator": "odrl:lt",
          "rightOperand": "P10DT18H4M14.384S"
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "distribute",
      "constraint": [
        {
          "leftOperand": "odrl:purpose",
          "operator": "odrl:neq",
          "rightOperand": "audit"
        },
        {
          "leftOperand": "odrl:samplingRate",
          "operator": "odrl:gt",
          "rightOperand": 0.24
        },
        {
          "leftOperand": "odrl:virtualLocation",
          "operator": "odrl:eq",
          "rightOperand": "hybrid"
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:resolution",
          "operator": "odrl:lt",
          "rightOperand": 50
        },
        {
          "leftOperand": "odrl:language",
          "operator": "odrl:neq",
          "rightOperand": "fr"
        }
      ]
    }
  ]
}