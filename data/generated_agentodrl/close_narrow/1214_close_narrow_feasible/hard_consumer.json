{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1214_close_narrow:consumer:hard",
  "assigner": "did:party:medical-ethics-board",
  "assignee": [
    "did:party:researcher-group"
  ],
  "target": [
    "urn:asset:cardio-scan-dataset",
    "urn:asset:research-articles"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:purpose",
          "operator": "odrl:neq",
          "rightOperand": "audit"
        },
        {
          "leftOperand": "odrl:timeInterval",
          "operator": "odrl:lt",
          "rightOperand": "P12DT4H40M13.279S"
        },
        {
          "leftOperand": "odrl:confidenceLevel",
          "operator": "odrl:lt",
          "rightOperand": 0.44
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "modify",
      "constraint": [
        {
          "leftOperand": "odrl:purpose",
          "operator": "odrl:isNoneOf",
          "rightOperand": [
            "audit"
          ]
        },
        {
          "leftOperand": "odrl:meteredTime",
          "operator": "odrl:gteq",
          "rightOperand": "P4DT22H24M56.028S"
        },
        {
          "leftOperand": "odrl:event",
          "operator": "odrl:isNoneOf",
          "rightOperand": [
            "termination"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:relativeTemporalPosition",
          "operator": "odrl:lteq",
          "rightOperand": "2025-12-08"
        },
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "CH"
          ]
        }
      ]
    }
  ]
