{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0004_close_narrow:consumer:aspiration",
  "assigner": "did:party:policy-issuer",
  "assignee": [
    "did:party:user"
  ],
  "target": [
    "urn:asset:digital-repository-access"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:registrationStatus",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "registered"
          ]
        },
        {
          "leftOperand": "odrl:elapsedTime",
          "operator": "odrl:gteq",
          "rightOperand": "P65DT8H12M3.18S"
        },
        {
          "leftOperand": "odrl:absoluteTemporalPosition",
          "operator": "odrl:gteq",
          "rightOperand": "2026-11-20"
        },
        {
          "leftOperand": "odrl:purpose",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "statistics",
            "educational purposes",
            "EnvironmentalComplianceReport"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:unitOfCount",
          "operator": "odrl:gteq",
          "rightOperand": 778
        },
        {
          "leftOperand": "odrl:event",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "audit",
            "termination"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:payAmount",
          "operator": "odrl:lteq",
          "rightOperand": 4481
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "PARQUET",
            "JSON",
            "image/jpeg"
          ]
        }
      ]
    }
  ]
}