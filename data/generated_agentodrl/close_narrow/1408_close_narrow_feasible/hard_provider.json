{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1408_close_narrow:provider:hard",
  "assigner": "did:party:platform-owner",
  "assignee": [
    "did:party:user"
  ],
  "target": [
    "urn:asset:platform"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:userAccountEstablished",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "true"
          ]
        },
        {
          "leftOperand": "odrl:version",
          "operator": "odrl:gteq",
          "rightOperand": 1
        },
        {
          "leftOperand": "odrl:spatialResolution",
          "operator": "odrl:gt",
          "rightOperand": 272
        },
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:eq",
          "rightOperand": "global"
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:relativeTemporalPosition",
          "operator": "odrl:gt",
          "rightOperand": "2026-01-17"
        },
        {
          "leftOperand": "odrl:recipient",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "affiliate",
            "third-party",
            "regulator"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:payAmount",
          "operator": "odrl:gteq",
          "rightOperand": 3144
        },
        {
          "leftOperand": "odrl:deliveryChannel",
          "operator": "odrl:isNoneOf",
          "rightOperand": [
            "courier"
          ]
        }
      ]
    }
  ]
}