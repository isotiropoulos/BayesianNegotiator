{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1669_close_narrow:provider:hard",
  "assigner": "did:party:party-policy-owner",
  "assignee": [
    "did:party:online-travel-agency"
  ],
  "target": [
    "urn:asset:personal-information",
    "urn:asset:traveler"
  ],
  "permission": [
    {
      "action": "distribute",
      "constraint": [
        {
          "leftOperand": "odrl:parentOrGuardianAuthorization",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "True"
          ]
        },
        {
          "leftOperand": "odrl:travelerAge",
          "operator": "odrl:lt",
          "rightOperand": 20
        },
        {
          "leftOperand": "odrl:payAmount",
          "operator": "odrl:gt",
          "rightOperand": 4359
        },
        {
          "leftOperand": "odrl:recipient",
          "operator": "odrl:neq",
          "rightOperand": "regulator"
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "distribute",
      "constraint": [
        {
          "leftOperand": "odrl:travelerAge",
          "operator": "odrl:lt",
          "rightOperand": 20
        },
        {
          "leftOperand": "odrl:resolution",
          "operator": "odrl:gt",
          "rightOperand": 70
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:isNoneOf",
          "rightOperand": [
            "XLSX"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:systemDevice",
          "operator": "odrl:isNoneOf",
          "rightOperand": [
            "bare-metal"
          ]
        }
      ]
    }
  ]
}