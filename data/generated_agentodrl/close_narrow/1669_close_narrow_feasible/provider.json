{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1669_close_narrow:provider:aspiration",
  "assigner": "did:party:party-policy-owner",
  "assignee": [
    "did:party:online-travel-agency"
  ],
  "target": [
    "urn:asset:personal-information",
    "urn:asset:traveler"
  ],
  "permission": [
    {
      "action": "distribute",
      "constraint": [
        {
          "leftOperand": "odrl:parentOrGuardianAuthorization",
          "operator": "odrl:eq",
          "rightOperand": true
        },
        {
          "leftOperand": "odrl:travelerAge",
          "operator": "odrl:lt",
          "rightOperand": 16
        },
        {
          "leftOperand": "odrl:payAmount",
          "operator": "odrl:lteq",
          "rightOperand": 5639
        },
        {
          "leftOperand": "odrl:recipient",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "affiliate",
            "consortium",
            "public"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "distribute",
      "constraint": [
        {
          "leftOperand": "odrl:travelerAge",
          "operator": "odrl:lt",
          "rightOperand": 16
        },
        {
          "leftOperand": "odrl:resolution",
          "operator": "odrl:lteq",
          "rightOperand": 91
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "JSON",
            "PARQUET",
            "CSV"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:systemDevice",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "container",
            "hsm",
            "bare-metal"
          ]
        }
      ]
    }
  ]
}