{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0585_close_narrow:consumer:hard",
  "assigner": "did:party:policy-issuer",
  "assignee": [
    "did:party:car-owner"
  ],
  "target": [
    "urn:asset:vehicle-maintenance-history-records"
  ],
  "permission": [
    {
      "action": "view",
      "constraint": [
        {
          "leftOperand": "odrl:recipient",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "CarOwner",
            "True",
            "drk:registeredUser"
          ]
        },
        {
          "leftOperand": "odrl:samplingRate",
          "operator": "odrl:gt",
          "rightOperand": 0.18
        },
        {
          "leftOperand": "odrl:meteredTime",
          "operator": "odrl:gteq",
          "rightOperand": "P4DT18H6M31.304S"
        },
        {
          "leftOperand": "odrl:media",
          "operator": "odrl:neq",
          "rightOperand": "internal-wiki"
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:delayPeriod",
          "operator": "odrl:lt",
          "rightOperand": "P8DT22H22M46.485S"
        },
        {
          "leftOperand": "odrl:purpose",
          "operator": "odrl:isNoneOf",
          "rightOperand": [
            "audit"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:elapsedTime",
          "operator": "odrl:gt",
          "rightOperand": "P24DT11H22M43.66S"
        },
        {
          "leftOperand": "odrl:industry",
          "operator": "odrl:neq",
          "rightOperand": "defence"
        }
      ]
    }
  ]
