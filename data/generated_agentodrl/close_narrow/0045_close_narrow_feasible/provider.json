{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0045_close_narrow:provider:aspiration",
  "assigner": "did:party:data-owner-organization",
  "assignee": [
    "did:party:astronomer-party"
  ],
  "target": [
    "urn:asset:exoplanet-atmosphere-spectra-database"
  ],
  "permission": [
    {
      "action": "download",
      "constraint": [
        {
          "leftOperand": "odrl:purpose",
          "operator": "odrl:isA",
          "rightOperand": "peer-reviewed research"
        },
        {
          "leftOperand": "odrl:timeInterval",
          "operator": "odrl:lteq",
          "rightOperand": "P9DT15H23M45.033S"
        },
        {
          "leftOperand": "odrl:delayPeriod",
          "operator": "odrl:lteq",
          "rightOperand": "P4DT21H31M59.732S"
        },
        {
          "leftOperand": "odrl:event",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "termination",
            "breach",
            "renewal"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:resolution",
          "operator": "odrl:lteq",
          "rightOperand": 72
        },
        {
          "leftOperand": "odrl:systemDevice",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "vm",
            "tee",
            "hsm"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:absoluteTemporalPosition",
          "operator": "odrl:lteq",
          "rightOperand": "2026-05-27"
        },
        {
          "leftOperand": "odrl:language",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "de",
            "en",
            "fr"
          ]
        }
      ]
    }
  ]
}