{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0468_close_narrow:consumer:aspiration",
  "assigner": "did:party:policy-issuer",
  "assignee": [
    "did:party:sensor-operator"
  ],
  "target": [
    "urn:asset:paris-noise-sensor-readings"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:elapsedTime",
          "operator": "odrl:gteq",
          "rightOperand": "P30DT2H35M26.669S"
        },
        {
          "leftOperand": "odrl:media",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "print",
            "broadcast"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "publish",
      "constraint": [
        {
          "leftOperand": "odrl:noiseCompliant",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "true"
          ]
        },
        {
          "leftOperand": "odrl:payAmount",
          "operator": "odrl:lteq",
          "rightOperand": 4505
        },
        {
          "leftOperand": "odrl:event",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "renewal",
            "audit"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "hold",
      "constraint": [
        {
          "leftOperand": "odrl:publicationHoldDurationHours",
          "operator": "odrl:gteq",
          "rightOperand": "100.8"
        },
        {
          "leftOperand": "odrl:samplingRate",
          "operator": "odrl:gteq",
          "rightOperand": 0.35
        },
        {
          "leftOperand": "odrl:deliveryChannel",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "s3",
            "courier",
            "kafka"
          ]
        }
      ]
    }
  ]
