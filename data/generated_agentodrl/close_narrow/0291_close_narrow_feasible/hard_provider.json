        },
        {
          "leftOperand": "odrl:delayPeriod",
          "operator": "odrl:gteq",
          "rightOperand": "P2DT16H50M52.237S"
        },
        {
          "leftOperand": "odrl:virtualLocation",
          "operator": "odrl:neq",
          "rightOperand": "edge"
