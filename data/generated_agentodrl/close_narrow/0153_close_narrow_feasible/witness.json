{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Agreement",
  "@id": "urn:witness",
  "assigner": "did:party:policy-issuer",
  "assignee": [
    "did:party:user",
    "did:party:asset-manager"
  ],
  "target": [
    "urn:asset:image-asset",
    "urn:asset:licensing-cost"
  ],
  "permission": [
    {
      "action": "print",
      "constraint": [
        {
          "leftOperand": "odrl:resolutionDPI",
          "operator": "odrl:eq",
          "rightOperand": 480
        },
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:eq",
          "rightOperand": "EU"
        },
        {
          "leftOperand": "odrl:media",
          "operator": "odrl:eq",
          "rightOperand": "internal-wiki"
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "distribute",
      "constraint": [
        {
          "leftOperand": "odrl:resolutionDPI",
          "operator": "odrl:eq",
          "rightOperand": 480
        },
        {
          "leftOperand": "odrl:systemDevice",
          "operator": "odrl:eq",
          "rightOperand": "bare-metal"
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "requestApproval",
      "constraint": [
        {
          "leftOperand": "odrl:resolutionDPI",
          "operator": "odrl:eq",
          "rightOperand": 480
        },
        {
          "leftOperand": "odrl:purpose",
          "operator": "odrl:eq",
          "rightOperand": "//w3id.org/drk/AITrainingAllowed"
        }
      ]
    },
    {
      "action": "pay",
      "constraint": [
        {
          "leftOperand": "odrl:resolutionDPI",
          "operator": "odrl:eq",
          "rightOperand": 480
        }
      ]
    }
  ]
}