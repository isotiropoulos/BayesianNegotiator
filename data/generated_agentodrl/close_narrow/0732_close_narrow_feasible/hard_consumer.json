{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0732_close_narrow:consumer:hard",
  "assigner": "did:party:policy-assigner",
  "assignee": [
    "did:party:clinician"
  ],
  "target": [
    "urn:asset:clinical-summaries",
    "urn:asset:raw-outputs"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:meteredTime",
          "operator": "odrl:gt",
          "rightOperand": "P5DT13H1M35.104S"
        },
        {
          "leftOperand": "odrl:elapsedTime",
          "operator": "odrl:gt",
          "rightOperand": "P21DT16H44M7.117S"
        },
        {
          "leftOperand": "odrl:virtualLocation",
          "operator": "odrl:eq",
          "rightOperand": "us-cloud"
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "show",
      "constraint": [
        {
          "leftOperand": "odrl:recipient",
          "operator": "odrl:isNoneOf",
          "rightOperand": [
            "regulator"
          ]
        },
        {
          "leftOperand": "odrl:timeInterval",
          "operator": "odrl:lt",
          "rightOperand": "P20DT13H3M0.098S"
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:isNoneOf",
          "rightOperand": [
            "XLSX"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:relativeTemporalPosition",
          "operator": "odrl:lt",
          "rightOperand": "2026-01-15"
        },
        {
          "leftOperand": "odrl:deliveryChannel",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "s3",
            "kafka",
            "courier"
          ]
        }
      ]
    }
  ]
