{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0928_close_narrow:provider:aspiration",
  "assigner": "did:party:city-building-energy-saving-center",
  "assignee": [
    "did:party:design-institute-members"
  ],
  "target": [
    "urn:asset:green-building-data",
    "urn:asset:building-or-household-identity",
    "urn:asset:data-usage"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:unitOfCount",
          "operator": "odrl:lteq",
          "rightOperand": 810
        },
        {
          "leftOperand": "odrl:elapsedTime",
          "operator": "odrl:lteq",
          "rightOperand": "P48DT11H46M3.799S"
        },
        {
          "leftOperand": "odrl:virtualLocation",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "hybrid",
            "air-gapped",
            "eu-cloud"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:relativeTemporalPosition",
          "operator": "odrl:lteq",
          "rightOperand": "2026-04-09"
        },
        {
          "leftOperand": "odrl:systemDevice",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "bare-metal",
            "container",
            "vm"
          ]
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "JSON",
            "XML",
            "CSV"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:spatialResolution",
          "operator": "odrl:lteq",
          "rightOperand": 536
        },
        {
          "leftOperand": "odrl:language",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "de",
            "es",
            "fr"
          ]
        }
      ]
    }
  ]
}