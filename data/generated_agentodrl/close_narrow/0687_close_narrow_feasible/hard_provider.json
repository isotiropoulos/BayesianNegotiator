{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0687_close_narrow:provider:hard",
  "assigner": "did:party:policy-owner",
  "assignee": [
    "did:party:author"
  ],
  "target": [
    "urn:asset:deep-sea-biodiversity-records"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:timeInterval",
          "operator": "odrl:gt",
          "rightOperand": "P17DT22H35M13.632S"
        },
        {
          "leftOperand": "odrl:delayPeriod",
          "operator": "odrl:gt",
          "rightOperand": "P2DT8H33M51.126S"
        },
        {
          "leftOperand": "odrl:industry",
          "operator": "odrl:isNoneOf",
          "rightOperand": [
            "defence"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:relativeTemporalPosition",
          "operator": "odrl:gteq",
          "rightOperand": "2025-12-16"
        },
        {
          "leftOperand": "odrl:event",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "audit"
          ]
        },
        {
          "leftOperand": "odrl:language",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "es",
            "fr",
            "en"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:absoluteTemporalPosition",
          "operator": "odrl:lt",
          "rightOperand": "2026-10-31"
        },
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:isNoneOf",
          "rightOperand": [
