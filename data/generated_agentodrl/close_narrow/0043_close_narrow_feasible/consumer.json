{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0043_close_narrow:consumer:aspiration",
  "assigner": "did:party:bioethics-repository-owner",
  "assignee": [
    "did:party:accredited-medical-researcher"
  ],
  "target": [
    "urn:asset:anonymized-datasets"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:researcherQualification",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "annualEthicsCertification"
          ]
        },
        {
          "leftOperand": "odrl:spatialResolution",
          "operator": "odrl:lteq",
          "rightOperand": 200
        },
        {
          "leftOperand": "odrl:timeInterval",
          "operator": "odrl:lteq",
          "rightOperand": "P14DT1H15M36.875S"
        },
        {
          "leftOperand": "odrl:virtualLocation",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "hybrid",
            "http://example.org/servers",
            "edge"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:absoluteTemporalPosition",
          "operator": "odrl:gteq",
          "rightOperand": "2027-01-30"
        },
        {
          "leftOperand": "odrl:deliveryChannel",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "courier",
            "SupportChannel",
            "s3"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:resolution",
          "operator": "odrl:lteq",
          "rightOperand": 33
        },
        {
          "leftOperand": "odrl:industry",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "finance",
            "国家工业安全",
            "state credit industry administrative department"
          ]
        }
      ]
    }
  ]
}