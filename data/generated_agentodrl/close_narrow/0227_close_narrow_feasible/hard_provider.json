          "rightOperand": 1
        },
        {
          "leftOperand": "odrl:elapsedTime",
          "operator": "odrl:lt",
          "rightOperand": "P61DT20H21M30.504S"
        },
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:neq",
