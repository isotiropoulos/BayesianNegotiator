      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:resolution",
          "operator": "odrl:lteq",
          "rightOperand": 45
        },
        {
          "leftOperand": "odrl:systemDevice",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "container"
          ]
        },
        {
          "leftOperand": "odrl:language",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "el"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:relativeTemporalPosition",
          "operator": "odrl:lteq",
          "rightOperand": "2025-12-06"
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:isNoneOf",
          "rightOperand": [
            "XLSX"
