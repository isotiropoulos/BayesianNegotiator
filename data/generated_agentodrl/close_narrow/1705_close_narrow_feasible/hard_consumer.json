{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1705_close_narrow:consumer:hard",
  "assigner": "did:party:statescybersecurity",
  "assignee": [
    "did:party:operator-critical-infrastructure",
    "did:party:data-processor"
