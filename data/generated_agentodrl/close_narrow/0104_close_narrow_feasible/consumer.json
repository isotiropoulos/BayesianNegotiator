{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0104_close_narrow:consumer:aspiration",
  "assigner": "did:party:data-space-owner",
  "assignee": [
    "did:party:registered-curators"
  ],
  "target": [
    "urn:asset:restoration-documentation-files",
    "urn:asset:all-servers"
  ],
  "permission": [
    {
      "action": "retrieve",
      "constraint": [
        {
          "leftOperand": "odrl:dateTime",
          "operator": "odrl:gteq",
          "rightOperand": "2024-06-10"
        },
        {
          "leftOperand": "odrl:accessLocation",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "certifiedArchivalServers",
            "Gaia-X Trusted Zone"
          ]
        },
        {
          "leftOperand": "odrl:percentage",
          "operator": "odrl:gteq",
          "rightOperand": 26
        },
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "global",
            "EFTA",
            "CentralEuropeanCountries"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "access",
      "constraint": [
        {
          "leftOperand": "odrl:accessLocation",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "Gaia-X Trusted Zone",
            "certifiedArchivalServers"
          ]
        },
        {
          "leftOperand": "odrl:version",
          "operator": "odrl:lteq",
          "rightOperand": 0
        },
        {
          "leftOperand": "odrl:deliveryChannel",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "kafka",
            "s3",
            "SupportChannel"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:samplingRate",
          "operator": "odrl:gteq",
          "rightOperand": 0.33
        }
      ]
    }
  ]
}