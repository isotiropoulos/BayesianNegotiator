        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:timeInterval",
          "operator": "odrl:eq",
          "rightOperand": "P19DT3H38M4.137S"
        },
        {
          "leftOperand": "odrl:systemDevice",
          "operator": "odrl:eq",
