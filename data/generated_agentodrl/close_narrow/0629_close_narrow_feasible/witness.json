          "operator": "odrl:eq",
          "rightOperand": "2025-12-22"
        },
        {
          "leftOperand": "odrl:media",
          "operator": "odrl:eq",
          "rightOperand": "print"
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:eq",
