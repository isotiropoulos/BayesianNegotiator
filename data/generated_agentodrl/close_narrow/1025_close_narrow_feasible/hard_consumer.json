{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1025_close_narrow:consumer:hard",
  "assigner": "did:party:steward-of-cu-j-498",
  "assignee": [
    "did:party:user"
  ],
  "target": [
    "urn:asset:crop-yield-forecasting-services"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:userAge",
          "operator": "odrl:lt",
          "rightOperand": 13
        },
        {
          "leftOperand": "odrl:countryDigitalConsentAge",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "CountryDigitalConsentMinimumAge"
          ]
        },
        {
          "leftOperand": "odrl:version",
          "operator": "odrl:lt",
          "rightOperand": 3
        },
        {
          "leftOperand": "odrl:language",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "en",
            "fr",
            "de"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:percentage",
          "operator": "odrl:gt",
          "rightOperand": 22
        },
        {
          "leftOperand": "odrl:virtualLocation",
          "operator": "odrl:eq",
          "rightOperand": "edge"
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:absoluteTemporalPosition",
          "operator": "odrl:gt",
          "rightOperand": "2026-09-12"
        },
        {
          "leftOperand": "odrl:event",
          "operator": "odrl:eq",
          "rightOperand": "termination"
        }
      ]
    }
  ]
}