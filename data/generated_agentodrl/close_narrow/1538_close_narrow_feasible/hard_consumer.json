{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1538_close_narrow:consumer:hard",
  "assigner": "did:party:smart-city-environmental-alliance",
  "assignee": [
    "did:party:counterparty"
  ],
  "target": [
    "urn:asset:urban-air-quality-dataset"
  ],
  "permission": [
    {
      "action": "distribute",
      "constraint": [
        {
          "leftOperand": "odrl:attribution",
          "operator": "odrl:neq",
          "rightOperand": "Explicit attribution of data source and contributors in all reports and publications"
        },
        {
          "leftOperand": "odrl:shareAlike",
          "operator": "odrl:neq",
          "rightOperand": "true"
        },
        {
          "leftOperand": "odrl:relativeTemporalPosition",
          "operator": "odrl:lt",
          "rightOperand": "2026-02-16"
        },
        {
          "leftOperand": "odrl:resolution",
          "operator": "odrl:lt",
          "rightOperand": 40
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:percentage",
          "operator": "odrl:gteq",
          "rightOperand": 25
        },
        {
          "leftOperand": "odrl:virtualLocation",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "eu-cloud"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:spatialResolution",
          "operator": "odrl:lteq",
          "rightOperand": 459
        },
        {
          "leftOperand": "odrl:purpose",
          "operator": "odrl:eq",
          "rightOperand": "journalism"
        }
      ]
    }
  ]
}