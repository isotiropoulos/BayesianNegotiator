{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0372_close_narrow:consumer:hard",
  "assigner": "did:party:asset-owner",
  "assignee": [
    "did:party:traffic-data-user"
  ],
  "target": [
    "urn:asset:urban-traffic-sensor-feeds"
  ],
  "permission": [
    {
      "action": "distribute",
      "constraint": [
        {
          "leftOperand": "odrl:authorizationLevel",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "gold"
          ]
        },
        {
          "leftOperand": "odrl:samplingRate",
          "operator": "odrl:gt",
          "rightOperand": 0.18
        },
        {
          "leftOperand": "odrl:spatialResolution",
          "operator": "odrl:lt",
          "rightOperand": 213
        }
      ]
    },
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:authorizationLevel",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "gold"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:percentage",
          "operator": "odrl:gteq",
          "rightOperand": 18
        },
        {
          "leftOperand": "odrl:language",
          "operator": "odrl:isNoneOf",
          "rightOperand": [
            "es"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:confidenceLevel",
          "operator": "odrl:lt",
          "rightOperand": 0.46
        },
        {
          "leftOperand": "odrl:deliveryChannel",
          "operator": "odrl:eq",
          "rightOperand": "courier"
        }
      ]
    }
  ]
}