{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0372_close_narrow:provider:aspiration",
  "assigner": "did:party:asset-owner",
  "assignee": [
    "did:party:traffic-data-user"
  ],
  "target": [
    "urn:asset:urban-traffic-sensor-feeds"
  ],
  "permission": [
    {
      "action": "distribute",
      "constraint": [
        {
          "leftOperand": "odrl:authorizationLevel",
          "operator": "odrl:eq",
          "rightOperand": "gold"
        },
        {
          "leftOperand": "odrl:samplingRate",
          "operator": "odrl:lteq",
          "rightOperand": 0.09
        },
        {
          "leftOperand": "odrl:spatialResolution",
          "operator": "odrl:lteq",
          "rightOperand": 262
        }
      ]
    },
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:authorizationLevel",
          "operator": "odrl:eq",
          "rightOperand": "gold"
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:percentage",
          "operator": "odrl:lteq",
          "rightOperand": 9
        },
        {
          "leftOperand": "odrl:language",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "el",
            "es",
            "en"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:confidenceLevel",
          "operator": "odrl:lteq",
          "rightOperand": 0.55
        },
        {
          "leftOperand": "odrl:deliveryChannel",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "courier",
            "kafka",
            "s3"
          ]
        }
      ]
    }
  ]
}