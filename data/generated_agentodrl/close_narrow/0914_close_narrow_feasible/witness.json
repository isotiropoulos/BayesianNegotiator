{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Agreement",
  "@id": "urn:witness",
  "assigner": "did:party:traffic-data-provider",
  "assignee": [
    "did:party:counterparty"
  ],
  "target": [
    "urn:asset:traffic-live2025-data",
    "urn:asset:usage-effectiveness-report",
    "urn:asset:public-data-maintenance-fund"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:relativeTemporalPosition",
          "operator": "odrl:eq",
          "rightOperand": "2025-11-24"
        },
        {
          "leftOperand": "odrl:industry",
          "operator": "odrl:eq",
          "rightOperand": "health"
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:media",
          "operator": "odrl:eq",
          "rightOperand": "print"
        },
        {
          "leftOperand": "odrl:language",
          "operator": "odrl:eq",
          "rightOperand": "de"
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "report",
      "constraint": [
        {
          "leftOperand": "odrl:timeInterval",
          "operator": "odrl:eq",
          "rightOperand": "P72D"
        },
        {
          "leftOperand": "odrl:deliveryChannel",
          "operator": "odrl:eq",
          "rightOperand": "courier"
        }
      ]
    },
    {
      "action": "contribute",
      "constraint": [
        {
          "leftOperand": "odrl:payAmount",
          "operator": "odrl:eq",
          "rightOperand": 0.01
        }
      ]
    },
    {
      "action": "pay",
      "constraint": [
        {
          "leftOperand": "odrl:payAmount",
          "operator": "odrl:eq",
          "rightOperand": 0
        }
      ]
    }
  ]
}