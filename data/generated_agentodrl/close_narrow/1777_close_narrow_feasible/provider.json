{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1777_close_narrow:provider:aspiration",
  "assigner": "did:party:policy-owner",
  "assignee": [
    "did:party:data-broker"
  ],
  "target": [
    "urn:asset:browsing-history-data"
  ],
  "permission": [
    {
      "action": "optOut",
      "constraint": [
        {
          "leftOperand": "odrl:actionType",
          "operator": "odrl:neq",
          "rightOperand": "sell"
        },
        {
          "leftOperand": "odrl:meteredTime",
          "operator": "odrl:lteq",
          "rightOperand": "P3DT17H43M20.948S"
        },
        {
          "leftOperand": "odrl:samplingRate",
          "operator": "odrl:lteq",
          "rightOperand": 0.1
        },
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "EEA",
            "UK",
            "CH"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:resolution",
          "operator": "odrl:lteq",
          "rightOperand": 63
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "XLSX",
            "PARQUET",
            "RDF"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:version",
          "operator": "odrl:lteq",
          "rightOperand": 4
        },
        {
          "leftOperand": "odrl:recipient",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "public",
            "affiliate",
            "internal-only"
          ]
        }
      ]
    }
  ]
}