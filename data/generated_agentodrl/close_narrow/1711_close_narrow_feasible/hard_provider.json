{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1711_close_narrow:provider:hard",
  "assigner": "did:party:policy-issuer",
  "assignee": [
    "did:party:critical-infrastructure-operator",
    "did:party:other-data-processor"
  ],
  "target": [
    "urn:asset:flight-slot-data",
    "urn:asset:passenger-name-record-data"
  ],
  "permission": [
    {
      "action": "distribute",
      "constraint": [
        {
          "leftOperand": "odrl:absoluteTemporalPosition",
          "operator": "odrl:lt",
          "rightOperand": "2024-04-28"
        },
        {
          "leftOperand": "odrl:percentage",
          "operator": "odrl:lt",
          "rightOperand": 23
        },
        {
          "leftOperand": "odrl:systemDevice",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "tee"
          ]
        },
        {
          "leftOperand": "odrl:language",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "el",
            "de",
            "en"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:resolution",
          "operator": "odrl:gt",
          "rightOperand": 59
        },
        {
          "leftOperand": "odrl:media",
          "operator": "odrl:neq",
          "rightOperand": "internal-wiki"
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:count",
          "operator": "odrl:lteq",
          "rightOperand": 168948
        },
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:neq",
          "rightOperand": "global"
        }
      ]
    }
  ]
