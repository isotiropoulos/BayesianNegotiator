{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Agreement",
  "@id": "urn:witness",
  "assigner": "did:party:data-space",
  "assignee": [
    "did:party:counterparty"
  ],
  "target": [
    "urn:asset:data-space",
    "urn:asset:public-notice",
    "urn:asset:approval-list"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:resolution",
          "operator": "odrl:eq",
          "rightOperand": 50
        },
        {
          "leftOperand": "odrl:relativeTemporalPosition",
          "operator": "odrl:eq",
          "rightOperand": "2025-11-28"
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:samplingRate",
          "operator": "odrl:eq",
          "rightOperand": 0.17
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:eq",
          "rightOperand": "CSV"
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "publish",
      "constraint": [
        {
          "leftOperand": "odrl:approvalList",
          "operator": "odrl:eq",
          "rightOperand": "Asset:PublicNoticePeriod"
        },
        {
          "leftOperand": "odrl:meteredTime",
          "operator": "odrl:eq",
          "rightOperand": "P5DT16H30M50.887S"
        },
        {
          "leftOperand": "odrl:industry",
          "operator": "odrl:eq",
          "rightOperand": "health"
        }
      ]
    },
    {
      "action": "wait",
      "constraint": [
        {
          "leftOperand": "odrl:publicNoticeStatus",
          "operator": "odrl:eq",
          "rightOperand": "no_objection"
        }
      ]
    }
  ]
}