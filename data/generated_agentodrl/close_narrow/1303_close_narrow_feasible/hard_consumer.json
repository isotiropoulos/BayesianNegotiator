{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1303_close_narrow:consumer:hard",
  "assigner": "did:party:policy-issuer",
  "assignee": [
    "did:party:smart-contract",
    "did:party:system"
  ],
  "target": [
    "urn:asset:smart-contract",
    "urn:asset:data-asset"
  ],
  "permission": [
    {
      "action": "execute",
      "constraint": [
        {
          "leftOperand": "odrl:executionTrigger",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "automatic"
          ]
        },
        {
          "leftOperand": "odrl:confidenceLevel",
          "operator": "odrl:lt",
          "rightOperand": 0.47
        },
        {
          "leftOperand": "odrl:relativeTemporalPosition",
          "operator": "odrl:lteq",
          "rightOperand": "2025-11-19"
        }
      ]
    },
    {
      "action": "delete",
      "constraint": [
        {
          "leftOperand": "odrl:violationDetected",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "true"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:payAmount",
          "operator": "odrl:lt",
          "rightOperand": 3111
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:isNoneOf",
          "rightOperand": [
            "XLSX"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:unitOfCount",
          "operator": "odrl:gteq",
          "rightOperand": 1039
        },
        {
          "leftOperand": "odrl:deliveryChannel",
          "operator": "odrl:eq",
          "rightOperand": "courier"
        }
      ]
    }
  ]
}