{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0686_close_narrow:consumer:hard",
  "assigner": "did:party:policy-owner",
  "assignee": [
    "did:party:counterparty"
  ],
  "target": [
    "urn:asset:deep-sea-biodiversity-records"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:meteredTime",
          "operator": "odrl:gt",
          "rightOperand": "P5DT11H59M52.611S"
        },
        {
          "leftOperand": "odrl:delayPeriod",
          "operator": "odrl:lt",
          "rightOperand": "P3DT14H58M6.41S"
        },
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:isNoneOf",
          "rightOperand": [
            "global"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "distribute",
      "constraint": [
        {
          "leftOperand": "odrl:purpose",
          "operator": "odrl:neq",
          "rightOperand": "audit"
        },
        {
          "leftOperand": "odrl:samplingRate",
          "operator": "odrl:gt",
          "rightOperand": 0.2
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:eq",
          "rightOperand": "RDF"
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:resolution",
          "operator": "odrl:lteq",
          "rightOperand": 61
        },
        {
          "leftOperand": "odrl:media",
          "operator": "odrl:isNoneOf",
          "rightOperand": [
            "internal-wiki"
          ]
        }
      ]
    }
  ]
}