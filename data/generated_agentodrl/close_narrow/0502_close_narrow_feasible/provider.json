{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0502_close_narrow:provider:aspiration",
  "assigner": "did:party:policy-owner",
  "assignee": [
    "did:party:analyst"
  ],
  "target": [
    "urn:asset:asset"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:payAmount",
          "operator": "odrl:lteq",
          "rightOperand": 6964
        },
        {
          "leftOperand": "odrl:percentage",
          "operator": "odrl:lteq",
          "rightOperand": 7
        },
        {
          "leftOperand": "odrl:deliveryChannel",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "kafka",
            "https",
            "sftp"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:samplingRate",
          "operator": "odrl:lteq",
          "rightOperand": 0.14
        },
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "EEA",
            "US",
            "UK"
          ]
        },
        {
          "leftOperand": "odrl:event",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "termination",
            "breach",
            "renewal"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:elapsedTime",
          "operator": "odrl:lteq",
          "rightOperand": "P18DT15H40.186S"
        },
        {
          "leftOperand": "odrl:language",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "en",
            "el",
            "es"
          ]
        }
      ]
    }
  ]
}