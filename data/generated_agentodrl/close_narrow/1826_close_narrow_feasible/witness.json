{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Agreement",
  "@id": "urn:witness",
  "assigner": "did:party:policy-owner",
  "assignee": [
    "did:party:counterparty"
  ],
  "target": [
    "urn:asset:critical-power-grid-data"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:resolution",
          "operator": "odrl:eq",
          "rightOperand": 65
        },
        {
          "leftOperand": "odrl:count",
          "operator": "odrl:eq",
          "rightOperand": 194554
        },
        {
          "leftOperand": "odrl:systemDevice",
          "operator": "odrl:eq",
          "rightOperand": "container"
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:percentage",
          "operator": "odrl:eq",
          "rightOperand": 20
        },
        {
          "leftOperand": "odrl:virtualLocation",
          "operator": "odrl:eq",
          "rightOperand": "us-cloud"
        },
        {
          "leftOperand": "odrl:recipient",
          "operator": "odrl:eq",
          "rightOperand": "//example.org/parties/agriTechCompany"
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:samplingRate",
          "operator": "odrl:eq",
          "rightOperand": 0.24
        },
        {
          "leftOperand": "odrl:purpose",
          "operator": "odrl:eq",
          "rightOperand": "commercial"
        }
      ]
    }
  ]
}