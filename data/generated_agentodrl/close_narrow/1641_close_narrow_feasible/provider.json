{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1641_close_narrow:provider:aspiration",
  "assigner": "did:party:policy-issuer",
  "assignee": [
    "did:party:job-seeker"
  ],
  "target": [
    "urn:asset:personal-resume-data",
    "urn:asset:recruitment-platform-a"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:purpose",
          "operator": "odrl:eq",
          "rightOperand": "Consent"
        },
        {
          "leftOperand": "odrl:system",
          "operator": "odrl:eq",
          "rightOperand": "automated"
        },
        {
          "leftOperand": "odrl:unitOfCount",
          "operator": "odrl:lteq",
          "rightOperand": 1208
        },
        {
          "leftOperand": "odrl:samplingRate",
          "operator": "odrl:lteq",
          "rightOperand": 0.1
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "block",
      "constraint": [
        {
          "leftOperand": "odrl:agent",
          "operator": "odrl:neq",
          "rightOperand": "RecruitmentPlatformA"
        },
        {
          "leftOperand": "odrl:payAmount",
          "operator": "odrl:lteq",
          "rightOperand": 7353
        },
        {
          "leftOperand": "odrl:event",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "breach",
            "audit",
            "termination"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:percentage",
          "operator": "odrl:lteq",
          "rightOperand": 7
        }
      ]
    }
  ]
}