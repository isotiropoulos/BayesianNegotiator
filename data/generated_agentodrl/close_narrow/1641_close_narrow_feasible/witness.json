{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Agreement",
  "@id": "urn:witness",
  "assigner": "did:party:policy-issuer",
  "assignee": [
    "did:party:job-seeker"
  ],
  "target": [
    "urn:asset:personal-resume-data",
    "urn:asset:recruitment-platform-a"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:purpose",
          "operator": "odrl:eq",
          "rightOperand": "Consent"
        },
        {
          "leftOperand": "odrl:system",
          "operator": "odrl:eq",
          "rightOperand": "automated"
        },
        {
          "leftOperand": "odrl:unitOfCount",
          "operator": "odrl:eq",
          "rightOperand": 1450
        },
        {
          "leftOperand": "odrl:samplingRate",
          "operator": "odrl:eq",
          "rightOperand": 0.2
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "block",
      "constraint": [
        {
          "leftOperand": "odrl:agent",
          "operator": "odrl:eq",
          "rightOperand": "organization"
        },
        {
          "leftOperand": "odrl:payAmount",
          "operator": "odrl:eq",
          "rightOperand": 5882
        },
        {
          "leftOperand": "odrl:event",
          "operator": "odrl:eq",
          "rightOperand": "breach"
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:percentage",
          "operator": "odrl:eq",
          "rightOperand": 17
        }
      ]
    }
  ]
}