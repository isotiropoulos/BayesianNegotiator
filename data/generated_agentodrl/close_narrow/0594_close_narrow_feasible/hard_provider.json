  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:version",
          "operator": "odrl:gt",
          "rightOperand": 1
        },
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:eq",
