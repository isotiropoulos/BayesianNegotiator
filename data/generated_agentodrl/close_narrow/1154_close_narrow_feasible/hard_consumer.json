{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1154_close_narrow:consumer:hard",
  "assigner": "did:party:policy-owner",
  "assignee": [
    "did:party:platform"
  ],
  "target": [
    "urn:asset:energy-consumption-metrics"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:percentage",
          "operator": "odrl:gt",
          "rightOperand": 25
        },
        {
          "leftOperand": "odrl:resolution",
          "operator": "odrl:lteq",
          "rightOperand": 51
        },
        {
          "leftOperand": "odrl:systemDevice",
          "operator": "odrl:isNoneOf",
          "rightOperand": [
            "container"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:spatialResolution",
          "operator": "odrl:lteq",
          "rightOperand": 455
        },
        {
          "leftOperand": "odrl:industry",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "defence"
          ]
        },
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:isNoneOf",
          "rightOperand": [
            "global"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:confidenceLevel",
          "operator": "odrl:lteq",
          "rightOperand": 0.48
        },
        {
          "leftOperand": "odrl:media",
          "operator": "odrl:neq",
          "rightOperand": "broadcast"
        }
      ]
    }
  ]
}