{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1154_close_narrow:provider:hard",
  "assigner": "did:party:policy-owner",
  "assignee": [
    "did:party:platform"
  ],
  "target": [
    "urn:asset:energy-consumption-metrics"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:percentage",
          "operator": "odrl:lteq",
          "rightOperand": 27
        },
        {
          "leftOperand": "odrl:resolution",
          "operator": "odrl:gteq",
          "rightOperand": 48
        },
        {
          "leftOperand": "odrl:systemDevice",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "bare-metal",
            "hsm",
            "container"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:spatialResolution",
          "operator": "odrl:gt",
          "rightOperand": 433
        },
        {
          "leftOperand": "odrl:industry",
          "operator": "odrl:isNoneOf",
          "rightOperand": [
            "retail"
          ]
        },
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:isNoneOf",
          "rightOperand": [
            "global"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:confidenceLevel",
          "operator": "odrl:gt",
          "rightOperand": 0.46
        },
        {
          "leftOperand": "odrl:media",
          "operator": "odrl:neq",
          "rightOperand": "broadcast"
        }
      ]
    }
  ]
