{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0942_close_narrow:consumer:aspiration",
  "assigner": "did:party:policy-owner",
  "assignee": [
    "did:party:authorized-party",
    "did:party:system"
  ],
  "target": [
    "urn:asset:medical-data-space",
    "urn:asset:blockchain-audit-trail",
    "urn:asset:process-traceability"
  ],
  "permission": [
    {
      "action": "distribute",
      "constraint": [
        {
          "leftOperand": "odrl:dateTime",
          "operator": "odrl:lteq",
          "rightOperand": 0
        },
        {
          "leftOperand": "odrl:virtualLocation",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "hybrid",
            "eu-cloud",
            "EU Claims Aggregates"
          ]
        },
        {
          "leftOperand": "odrl:industry",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "health",
            "国家工业安全",
            "public"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:media",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "web",
            "print"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "leaveAuditTrail",
      "constraint": [
        {
          "leftOperand": "odrl:dateTime",
          "operator": "odrl:lteq",
          "rightOperand": 0
        },
        {
          "leftOperand": "odrl:recipient",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "third-party",
            "affiliate",
            "businessID"
          ]
        }
      ]
    },
    {
      "action": "storeImmutable",
      "constraint": [
        {
          "leftOperand": "odrl:dateTime",
          "operator": "odrl:lteq",
          "rightOperand": 0
        }
      ]
    },
    {
      "action": "ensureTraceability",
      "constraint": [
        {
          "leftOperand": "odrl:dateTime",
          "operator": "odrl:lteq",
          "rightOperand": 0
        }
      ]
    }
  ]
}