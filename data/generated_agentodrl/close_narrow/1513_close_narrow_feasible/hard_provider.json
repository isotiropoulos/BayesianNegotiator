{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1513_close_narrow:provider:hard",
  "assigner": "did:party:supply-chain-authority",
  "assignee": [
    "did:party:supply-chain-monitoring-team"
  ],
  "target": [
    "urn:asset:data-provider",
    "urn:asset:monitoring-list"
  ],
  "permission": [
    {
      "action": "monitor",
      "constraint": [
        {
          "leftOperand": "odrl:count",
          "operator": "odrl:lteq",
          "rightOperand": 5
        },
        {
          "leftOperand": "odrl:absoluteTemporalPosition",
          "operator": "odrl:lteq",
          "rightOperand": "2026-08-26"
        },
        {
          "leftOperand": "odrl:virtualLocation",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "us-cloud",
            "on-prem",
            "hybrid"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:spatialResolution",
          "operator": "odrl:gteq",
          "rightOperand": 569
        },
        {
          "leftOperand": "odrl:language",
          "operator": "odrl:isNoneOf",
          "rightOperand": [
            "es"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:count",
          "operator": "odrl:lt",
          "rightOperand": 5
        },
        {
          "leftOperand": "odrl:industry",
          "operator": "odrl:neq",
          "rightOperand": "defence"
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:eq",
          "rightOperand": "CSV"
        }
      ]
    }
  ]
}