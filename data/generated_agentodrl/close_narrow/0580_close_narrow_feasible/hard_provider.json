      "constraint": [
        {
          "leftOperand": "odrl:meteredTime",
          "operator": "odrl:lt",
          "rightOperand": "P6DT2H34M46.827S"
        },
        {
          "leftOperand": "odrl:language",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "es"
          ]
        }
      ]
    }
  ],
  "obligation": [
