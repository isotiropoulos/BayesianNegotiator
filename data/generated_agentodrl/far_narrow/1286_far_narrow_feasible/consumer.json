{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1286_far_narrow:consumer:aspiration",
  "assigner": "did:party:data-sharing-operator",
  "assignee": [
    "did:party:audit-operator"
  ],
  "target": [
    "urn:asset:blockchain-evidence",
    "urn:asset:audit-records"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:version",
          "operator": "odrl:lteq",
          "rightOperand": 0
        },
        {
          "leftOperand": "odrl:timeInterval",
          "operator": "odrl:lteq",
          "rightOperand": "PT0S"
        },
        {
          "leftOperand": "odrl:deliveryChannel",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "sftp",
            "SupportChannel",
            "kafka"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "modify",
      "constraint": [
        {
          "leftOperand": "odrl:auditRecordsImmutable",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "true"
          ]
        },
        {
          "leftOperand": "odrl:elapsedTime",
          "operator": "odrl:gteq",
          "rightOperand": "P131DT1H8M35.121S"
        },
        {
          "leftOperand": "odrl:media",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "web",
            "print"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:count",
          "operator": "odrl:gteq",
          "rightOperand": 550051
        },
        {
          "leftOperand": "odrl:language",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "fr",
            "es",
            "el"
          ]
        }
      ]
    }
  ]
}