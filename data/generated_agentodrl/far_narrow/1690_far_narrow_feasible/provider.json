{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1690_far_narrow:provider:aspiration",
  "assigner": "did:party:policy-owner",
  "assignee": [
    "did:party:vehicle-owner",
    "did:party:auto-finance-company"
  ],
  "target": [
    "urn:asset:vehicle-mortgage-information"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:version",
          "operator": "odrl:lteq",
          "rightOperand": 3
        },
        {
          "leftOperand": "odrl:virtualLocation",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "edge",
            "hybrid",
            "air-gapped"
          ]
        },
        {
          "leftOperand": "odrl:recipient",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "regulator",
            "third-party",
            "internal-only"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "copy",
      "constraint": [
        {
          "leftOperand": "odrl:article",
          "operator": "odrl:eq",
          "rightOperand": "18"
        },
        {
          "leftOperand": "odrl:spatialResolution",
          "operator": "odrl:lteq",
          "rightOperand": 509
        },
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "CH",
            "US",
            "global"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:resolution",
          "operator": "odrl:lteq",
          "rightOperand": 71
        },
        {
          "leftOperand": "odrl:event",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "breach",
            "renewal",
            "termination"
          ]
        }
      ]
    }
  ]
}