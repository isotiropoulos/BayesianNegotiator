        },
        {
          "leftOperand": "odrl:virtualLocation",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "edge",
            "certified_archival_workstation",
            "on-prem"
          ]
        },
        {
          "leftOperand": "odrl:recipient",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "regulator",
            "NationalEnvironmentalAgency",
            "specificData"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "copy",
      "constraint": [
        {
          "leftOperand": "odrl:article",
          "operator": "odrl:gteq",
          "rightOperand": "46.8"
        },
        {
          "leftOperand": "odrl:spatialResolution",
          "operator": "odrl:lteq",
          "rightOperand": 0
        },
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
