{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0522_far_narrow:consumer:aspiration",
  "assigner": "did:party:policy-owner",
  "assignee": [
    "did:party:all-users"
  ],
  "target": [
    "urn:asset:asset-scan"
  ],
  "permission": [
    {
      "action": "distribute",
      "constraint": [
        {
          "leftOperand": "odrl:resolution",
          "operator": "odrl:lteq",
          "rightOperand": 0
        },
        {
          "leftOperand": "odrl:usePurpose",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "academic research",
            "commercial"
          ]
        },
        {
          "leftOperand": "odrl:spatialResolution",
          "operator": "odrl:lteq",
          "rightOperand": 0
        },
        {
          "leftOperand": "odrl:deliveryChannel",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "kafka",
            "s3",
            "courier"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:payAmount",
          "operator": "odrl:lteq",
          "rightOperand": 0
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "CSV",
            "PatientPrivacy",
            "XML"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:elapsedTime",
          "operator": "odrl:gteq",
          "rightOperand": "P80DT20H13M4.451S"
        },
        {
          "leftOperand": "odrl:systemDevice",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "vm",
            "container",
            "consortium-approved"
          ]
        }
      ]
    }
  ]
}