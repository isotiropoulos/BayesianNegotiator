{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0081_far_narrow:provider:hard",
  "assigner": "did:party:bavarian-archives-authority",
  "assignee": [
    "did:party:history-magazine-bavaria",
    "did:party:cultural-analytics-lab",
    "did:party:heritage-platform-munich"
  ],
  "target": [
    "urn:asset:historic-documents-api"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:isNoneOf",
          "rightOperand": [
            "global"
          ]
        },
        {
          "leftOperand": "odrl:delayPeriod",
          "operator": "odrl:gt",
          "rightOperand": "P5DT20H5M40.731S"
        },
        {
          "leftOperand": "odrl:timeInterval",
          "operator": "odrl:gt",
          "rightOperand": "P8DT9H25M3.61S"
        },
        {
          "leftOperand": "odrl:deliveryChannel",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "courier",
            "kafka",
            "s3"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:elapsedTime",
          "operator": "odrl:lt",
          "rightOperand": "P37DT12H53M10.088S"
        },
        {
          "leftOperand": "odrl:media",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "web"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:resolution",
          "operator": "odrl:gt",
          "rightOperand": 32
        },
        {
          "leftOperand": "odrl:language",
          "operator": "odrl:eq",
          "rightOperand": "fr"
        }
      ]
    }
  ]
