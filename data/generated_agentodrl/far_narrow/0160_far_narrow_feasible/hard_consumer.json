{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0160_far_narrow:consumer:hard",
  "assigner": "did:party:policy-issuer",
  "assignee": [
    "did:party:counterparty"
  ],
  "target": [
    "urn:asset:digitized-manuscript-records"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:relativeTemporalPosition",
          "operator": "odrl:lt",
          "rightOperand": "2025-04-18"
        },
        {
          "leftOperand": "odrl:percentage",
          "operator": "odrl:gt",
          "rightOperand": 50
        },
        {
          "leftOperand": "odrl:recipient",
          "operator": "odrl:isNoneOf",
          "rightOperand": [
            "regulator"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "distribute",
      "constraint": [
        {
          "leftOperand": "odrl:payAmount",
          "operator": "odrl:eq",
          "rightOperand": "fees"
        },
        {
          "leftOperand": "odrl:timeInterval",
          "operator": "odrl:lteq",
          "rightOperand": "P13DT11H53M37.921S"
        },
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "global",
            "中华人民共和国境内",
            "CH"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:confidenceLevel",
          "operator": "odrl:lt",
          "rightOperand": 0.29
        },
        {
          "leftOperand": "odrl:media",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "web"
          ]
        }
      ]
    }
  ]
}