        },
        {
          "leftOperand": "odrl:delayPeriod",
          "operator": "odrl:eq",
          "rightOperand": "P5DT14H21M8.064S"
        },
        {
          "leftOperand": "odrl:percentage",
          "operator": "odrl:eq",
          "rightOperand": 48
        },
        {
          "leftOperand": "odrl:virtualLocation",
          "operator": "odrl:eq",
