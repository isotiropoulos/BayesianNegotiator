{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0887_far_narrow:provider:hard",
  "assigner": "did:party:policy-owner",
  "assignee": [
    "did:party:data-user",
    "did:party:data-creator"
  ],
  "target": [
    "urn:asset:ocean-temperature-dataset",
    "urn:asset:derivative-data-product"
  ],
  "permission": [
    {
      "action": "distribute",
      "constraint": [
        {
          "leftOperand": "odrl:license",
          "operator": "odrl:eq",
          "rightOperand": "CC BY-SA"
        },
        {
          "leftOperand": "odrl:confidenceLevel",
          "operator": "odrl:gt",
          "rightOperand": 0.24
        },
        {
          "leftOperand": "odrl:resolution",
          "operator": "odrl:gteq",
          "rightOperand": 16
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:absoluteTemporalPosition",
          "operator": "odrl:lt",
          "rightOperand": "2027-10-30"
        },
        {
          "leftOperand": "odrl:deliveryChannel",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "sftp",
            "s3",
            "courier"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "license",
      "constraint": [
        {
          "leftOperand": "odrl:license",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "CC BY-SA"
          ]
        },
        {
          "leftOperand": "odrl:relativeTemporalPosition",
          "operator": "odrl:gteq",
          "rightOperand": "2025-01-18"
        },
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:eq",
          "rightOperand": "EU"
        }
      ]
    }
  ]
}