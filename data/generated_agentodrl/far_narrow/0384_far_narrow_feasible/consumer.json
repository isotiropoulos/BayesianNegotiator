            "Gaia-X Trusted Zone",
            "European Cultural Data Space",
            "ScopePublicInstallations"
          ]
        },
        {
          "leftOperand": "odrl:elapsedTime",
          "operator": "odrl:gteq",
          "rightOperand": "P9490D"
        },
        {
          "leftOperand": "odrl:confidenceLevel",
          "operator": "odrl:lteq",
          "rightOperand": 0.0
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "RDF",
            "low-resolution images",
            "CSV"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:version",
          "operator": "odrl:lteq",
