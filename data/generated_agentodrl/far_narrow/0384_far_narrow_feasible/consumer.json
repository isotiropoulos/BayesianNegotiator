            "Gaia-X Trusted Zone",
            "European Cultural Heritage Data Space",
            "HealthDataSpace"
          ]
        },
        {
          "leftOperand": "odrl:virtualLocation",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "eu-cloud",
            "us-cloud",
            "http://example.org/servers"
          ]
        }
      ]
    }
  ]
