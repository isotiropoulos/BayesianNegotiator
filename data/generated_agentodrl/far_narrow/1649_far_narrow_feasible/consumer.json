{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1649_far_narrow:consumer:aspiration",
  "assigner": "did:party:policy-issuer",
  "assignee": [
    "did:party:resident"
  ],
  "target": [
    "urn:asset:personal-health-code-status-data"
  ],
  "permission": [
    {
      "action": "objecting",
      "constraint": [
        {
          "leftOperand": "odrl:dateTime",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "anytime",
            "immediate",
            "quarterly"
          ]
        },
        {
          "leftOperand": "odrl:absoluteTemporalPosition",
          "operator": "odrl:gteq",
          "rightOperand": "2028-12-17"
        },
        {
          "leftOperand": "odrl:relativeTemporalPosition",
          "operator": "odrl:lteq",
          "rightOperand": "2023-10-21"
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "process",
      "constraint": [
        {
          "leftOperand": "odrl:legalRights",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "true"
          ]
        },
        {
          "leftOperand": "odrl:payAmount",
          "operator": "odrl:lteq",
          "rightOperand": 0
        },
        {
          "leftOperand": "odrl:event",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "renewal",
            "breach"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:resolution",
          "operator": "odrl:lteq",
          "rightOperand": 0
        },
        {
          "leftOperand": "odrl:industry",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "mobility",
            "医院数据提供方",
            "health"
          ]
        }
      ]
    }
  ]
}