{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1192_far_narrow:consumer:aspiration",
  "assigner": "did:party:satellite-imagery-data",
  "assignee": [
    "did:party:environmental-research-consortia"
  ],
  "target": [
    "urn:asset:satellite-imagery-data",
    "urn:asset:model-impact-disclosure",
    "urn:asset:fairness-index"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:fairnessIndex",
          "operator": "odrl:gteq",
          "rightOperand": 0.85
        },
        {
          "leftOperand": "odrl:purpose",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "research",
            "disclosure of patient's rights to request deletion of personal information",
            "stylistic research"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:fairnessIndex",
          "operator": "odrl:gteq",
          "rightOperand": 0.85
        },
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "EU",
            "NorthAmerica",
            "US"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "provide",
      "constraint": [
        {
          "leftOperand": "odrl:fairnessIndex",
          "operator": "odrl:gteq",
          "rightOperand": 0.85
        },
        {
          "leftOperand": "odrl:media",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "print",
            "broadcast"
          ]
        }
      ]
    },
    {
      "action": "check",
      "constraint": [
        {
          "leftOperand": "odrl:percentage",
          "operator": "odrl:gteq",
          "rightOperand": 80.05
        },
        {
          "leftOperand": "odrl:fairnessIndex",
          "operator": "odrl:gteq",
          "rightOperand": 0.85
        }
      ]
    }
  ]
}