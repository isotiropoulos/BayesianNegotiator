{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0899_far_narrow:consumer:aspiration",
  "assigner": "did:party:steward-of-cu-j-450",
  "assignee": [
    "did:party:counterparty"
  ],
  "target": [
    "urn:asset:cu-j-450"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:spatialResolution",
          "operator": "odrl:lteq",
          "rightOperand": 0
        },
        {
          "leftOperand": "odrl:version",
          "operator": "odrl:lteq",
          "rightOperand": 0
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:delayPeriod",
          "operator": "odrl:lteq",
          "rightOperand": "PT0S"
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "provide",
      "constraint": [
        {
          "leftOperand": "odrl:informationAccuracy",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "accurate",
            "True"
          ]
        },
        {
          "leftOperand": "odrl:absoluteTemporalPosition",
          "operator": "odrl:gteq",
          "rightOperand": "2028-10-07"
        }
      ]
    },
    {
      "action": "update",
      "constraint": [
        {
          "leftOperand": "odrl:informationCurrency",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "up-to-date"
          ]
        }
      ]
    },
    {
      "action": "maintain",
      "constraint": [
        {
          "leftOperand": "odrl:informationTimeliness",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "current"
          ]
        },
        {
          "leftOperand": "odrl:informationCompleteness",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "complete"
          ]
        }
      ]
    }
  ]
}