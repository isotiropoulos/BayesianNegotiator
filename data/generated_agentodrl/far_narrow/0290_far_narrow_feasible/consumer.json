{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0290_far_narrow:consumer:aspiration",
  "assigner": "did:party:aggregated-irrigation-advisories",
  "assignee": [
    "did:party:counterparty"
  ],
  "target": [
    "urn:asset:aggregated-irrigation-advisories",
    "urn:asset:field-level-sensor-data",
    "urn:asset:regional-farm-cooperatives"
  ],
  "permission": [
    {
      "action": "read",
      "constraint": [
        {
          "leftOperand": "odrl:accessLevel",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "aggregated",
            "open",
            "premium"
          ]
        },
        {
          "leftOperand": "odrl:samplingRate",
          "operator": "odrl:gteq",
          "rightOperand": 0.92
        },
        {
          "leftOperand": "odrl:deliveryChannel",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "courier",
            "https",
            "sftp"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:resolution",
          "operator": "odrl:lteq",
          "rightOperand": 0
        },
        {
          "leftOperand": "odrl:event",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "audit",
            "termination"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "limitAccess",
      "constraint": [
        {
          "leftOperand": "odrl:soilMoisture",
          "operator": "odrl:gteq",
          "rightOperand": 26
        },
        {
          "leftOperand": "odrl:delayPeriod",
          "operator": "odrl:lteq",
          "rightOperand": "PT0S"
        },
        {
          "leftOperand": "odrl:virtualLocation",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "us-cloud",
            "http://example.org/servers",
            "EU Claims Aggregates"
          ]
        }
      ]
    }
  ]
}