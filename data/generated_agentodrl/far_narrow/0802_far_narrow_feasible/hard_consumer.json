{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0802_far_narrow:consumer:hard",
  "assigner": "did:party:content-owner",
  "assignee": [
    "did:party:user"
  ],
  "target": [
    "urn:asset:alpine-traditional-music-database"
  ],
  "permission": [
    {
      "action": "play",
      "constraint": [
        {
          "leftOperand": "odrl:absoluteSpatialPosition",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "Eurozone"
          ]
        },
        {
          "leftOperand": "odrl:spatialPosition",
          "operator": "odrl:eq",
          "rightOperand": "Eurozone"
        },
        {
          "leftOperand": "odrl:meteredTime",
          "operator": "odrl:gt",
          "rightOperand": "P14DT4H41M32.252S"
        },
        {
          "leftOperand": "odrl:timeInterval",
          "operator": "odrl:lt",
          "rightOperand": "P12DT4H53M7.421S"
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:delayPeriod",
          "operator": "odrl:lt",
          "rightOperand": "P3DT10H16M49.056S"
        },
        {
          "leftOperand": "odrl:recipient",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "regulator",
            "European Union",
            "RegisteredShippingCompanies"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:spatialResolution",
          "operator": "odrl:lteq",
          "rightOperand": 170
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:eq",
          "rightOperand": "PARQUET"
        }
      ]
    }
  ]
}