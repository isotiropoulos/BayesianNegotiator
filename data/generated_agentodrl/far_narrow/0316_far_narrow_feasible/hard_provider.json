{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0316_far_narrow:provider:hard",
  "assigner": "did:party:policy-owner",
  "assignee": [
    "did:party:global-health-repository"
  ],
  "target": [
    "urn:asset:infectious-disease-datasets"
  ],
  "permission": [
    {
      "action": "distribute",
      "constraint": [
        {
          "leftOperand": "odrl:reIdentificationAction",
          "operator": "odrl:eq",
          "rightOperand": "re-identification"
        },
        {
          "leftOperand": "odrl:absoluteTemporalPosition",
          "operator": "odrl:lteq",
          "rightOperand": "2027-12-06"
        },
        {
          "leftOperand": "odrl:confidenceLevel",
          "operator": "odrl:gteq",
          "rightOperand": 0.24
        },
        {
          "leftOperand": "odrl:recipient",
          "operator": "odrl:neq",
          "rightOperand": "regulator"
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:resolution",
          "operator": "odrl:gt",
          "rightOperand": 20
        },
        {
          "leftOperand": "odrl:industry",
          "operator": "odrl:isNoneOf",
          "rightOperand": [
            "defence"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:samplingRate",
          "operator": "odrl:lteq",
          "rightOperand": 0.51
        },
        {
          "leftOperand": "odrl:deliveryChannel",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "https"
          ]
        }
      ]
    }
  ]
}