{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1599_far_narrow:provider:aspiration",
  "assigner": "did:party:policy-issuer",
  "assignee": [
    "did:party:business-entity"
  ],
  "target": [
    "urn:asset:personal-information",
    "urn:asset:consumer"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:samplingRate",
          "operator": "odrl:lteq",
          "rightOperand": 0.08
        },
        {
          "leftOperand": "odrl:industry",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "retail",
            "health",
            "public"
          ]
        },
        {
          "leftOperand": "odrl:language",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "es",
            "fr",
            "de"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "sell",
      "constraint": [
        {
          "leftOperand": "odrl:dateOfBirth",
          "operator": "odrl:lt",
          "rightOperand": 16
        },
        {
          "leftOperand": "odrl:spatialResolution",
          "operator": "odrl:lteq",
          "rightOperand": 666
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "XML",
            "XLSX",
            "RDF"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:unitOfCount",
          "operator": "odrl:lteq",
          "rightOperand": 745
        },
        {
          "leftOperand": "odrl:deliveryChannel",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "courier",
            "https",
            "sftp"
          ]
        }
      ]
    }
  ]
}