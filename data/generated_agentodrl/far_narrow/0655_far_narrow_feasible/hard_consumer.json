          "leftOperand": "odrl:percentage",
          "operator": "odrl:gteq",
          "rightOperand": 40
        },
        {
          "leftOperand": "odrl:resolution",
          "operator": "odrl:lt",
          "rightOperand": 22
        },
        {
          "leftOperand": "odrl:purpose",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "statistics",
            "educational use",
            "disclosure"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:delayPeriod",
          "operator": "odrl:lteq",
          "rightOperand": "P3DT23H1M39.855S"
        },
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:neq",
          "rightOperand": "US"
        },
        {
          "leftOperand": "odrl:media",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "web"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:absoluteTemporalPosition",
          "operator": "odrl:gt",
          "rightOperand": "2027-06-16"
        },
        {
          "leftOperand": "odrl:virtualLocation",
          "operator": "odrl:isAllOf",
