{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0959_far_narrow:consumer:hard",
  "assigner": "did:party:data-space",
  "assignee": [
    "did:party:counterparty"
  ],
  "target": [
    "urn:asset:data-space",
    "urn:asset:public-notice",
    "urn:asset:approval-list"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:resolution",
          "operator": "odrl:lt",
          "rightOperand": 33
        },
        {
          "leftOperand": "odrl:relativeTemporalPosition",
          "operator": "odrl:lt",
          "rightOperand": "2025-02-02"
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:samplingRate",
          "operator": "odrl:gteq",
          "rightOperand": 0.44
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "CSV",
            "anonymized",
            "granular, real-time consumption"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "publish",
      "constraint": [
        {
          "leftOperand": "odrl:approvalList",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "Asset:PublicNoticePeriod"
          ]
        },
        {
          "leftOperand": "odrl:meteredTime",
          "operator": "odrl:gteq",
          "rightOperand": "P13DT21H45M19.646S"
        },
        {
          "leftOperand": "odrl:industry",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "health",
            "state credit industry administrative department",
            "defence"
          ]
        }
      ]
    },
    {
      "action": "wait",
      "constraint": [
        {
          "leftOperand": "odrl:publicNoticeStatus",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "no_objection"
          ]
        }
      ]
    }
  ]
}