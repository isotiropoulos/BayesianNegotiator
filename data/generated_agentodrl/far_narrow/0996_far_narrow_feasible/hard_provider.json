{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0996_far_narrow:provider:hard",
  "assigner": "did:party:policy-owner",
  "assignee": [
    "did:party:data-access-party"
  ],
  "target": [
    "urn:asset:clinical-trial-results-data",
    "urn:asset:all-data"
  ],
  "permission": [
    {
      "action": "distribute",
      "constraint": [
        {
          "leftOperand": "odrl:failureRate",
          "operator": "odrl:gteq",
          "rightOperand": 2
        },
        {
          "leftOperand": "odrl:resolution",
          "operator": "odrl:gt",
          "rightOperand": 39
        },
        {
          "leftOperand": "odrl:event",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "termination",
            "breach",
            "audit"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "distribute",
      "constraint": [
        {
          "leftOperand": "odrl:failureRate",
          "operator": "odrl:gteq",
          "rightOperand": 2
        },
        {
          "leftOperand": "odrl:virtualLocation",
          "operator": "odrl:isNoneOf",
          "rightOperand": [
            "edge"
          ]
        },
        {
          "leftOperand": "odrl:language",
          "operator": "odrl:eq",
          "rightOperand": "fr"
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "resubmit",
      "constraint": [
        {
          "leftOperand": "odrl:failureRate",
          "operator": "odrl:gteq",
          "rightOperand": 2
        },
        {
          "leftOperand": "odrl:purpose",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "research"
          ]
        }
      ]
    }
  ]
}