{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0635_far_narrow:consumer:aspiration",
  "assigner": "did:party:repository-director",
  "assignee": [
    "did:party:counterparty"
  ],
  "target": [
    "urn:asset:historic-clinical-trial-reports-asset"
  ],
  "permission": [
    {
      "action": "reproduce",
      "constraint": [
        {
          "leftOperand": "odrl:approvalStatus",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "approved",
            "allow"
          ]
        },
        {
          "leftOperand": "odrl:confidenceLevel",
          "operator": "odrl:lteq",
          "rightOperand": 0.0
        },
        {
          "leftOperand": "odrl:timeInterval",
          "operator": "odrl:lteq",
          "rightOperand": "PT0S"
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "reproduce",
      "constraint": [
        {
          "leftOperand": "odrl:storageLocation",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "physically secured archive",
            "certified_medical_records_system"
          ]
        },
        {
          "leftOperand": "odrl:resolution",
          "operator": "odrl:lteq",
          "rightOperand": 0
        },
        {
          "leftOperand": "odrl:industry",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "health",
            "mobility",
            "public"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:unitOfCount",
          "operator": "odrl:gteq",
          "rightOperand": 2348
        },
        {
          "leftOperand": "odrl:language",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "es",
            "de",
            "el"
          ]
        }
      ]
    }
  ]
