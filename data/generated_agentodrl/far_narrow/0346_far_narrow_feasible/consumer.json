{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0346_far_narrow:consumer:aspiration",
  "assigner": "did:party:utility-regulator",
  "assignee": [
    "did:party:licensed-utility-provider"
  ],
  "target": [
    "urn:asset:local-grid-protocols"
  ],
  "permission": [
    {
      "action": "confirm",
      "constraint": [
        {
          "leftOperand": "odrl:usedTool",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "GridStabilityAlertAPI"
          ]
        },
        {
          "leftOperand": "odrl:timeInterval",
          "operator": "odrl:lteq",
          "rightOperand": "PT0S"
        },
        {
          "leftOperand": "odrl:elapsedTime",
          "operator": "odrl:gteq",
          "rightOperand": "P105DT4H33M43.118S"
        },
        {
          "leftOperand": "odrl:media",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "web",
            "broadcast"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:payAmount",
          "operator": "odrl:lteq",
          "rightOperand": 0
        },
        {
          "leftOperand": "odrl:virtualLocation",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "edge",
            "certified_archival_workstation",
            "on-prem"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:samplingRate",
          "operator": "odrl:gteq",
          "rightOperand": 0.92
        },
        {
          "leftOperand": "odrl:language",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "fr",
            "es",
            "el"
          ]
        }
      ]
    }
  ]
}