{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1227_far_narrow:consumer:aspiration",
  "assigner": "did:party:party-national-grid-authority",
  "assignee": [
    "did:party:nationalgrid"
  ],
  "target": [
    "urn:asset:2024"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:unitOfCount",
          "operator": "odrl:gteq",
          "rightOperand": 2090
        },
        {
          "leftOperand": "odrl:spatialResolution",
          "operator": "odrl:lteq",
          "rightOperand": 0
        },
        {
          "leftOperand": "odrl:event",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "breach",
            "audit"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:timeInterval",
          "operator": "odrl:lteq",
          "rightOperand": "PT0S"
        },
        {
          "leftOperand": "odrl:recipient",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "consortium",
            "regulator",
            "local_minimum_age_of_consent"
          ]
        },
        {
          "leftOperand": "odrl:deliveryChannel",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "kafka",
            "SupportChannel",
            "sftp"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:payAmount",
          "operator": "odrl:lteq",
          "rightOperand": 0
        },
        {
          "leftOperand": "odrl:industry",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "energy",
            "国家工业安全",
            "public"
          ]
        }
      ]
    }
  ]
}