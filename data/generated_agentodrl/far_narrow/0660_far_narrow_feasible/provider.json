{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0660_far_narrow:provider:aspiration",
  "assigner": "did:party:energy-data-owner",
  "assignee": [
    "did:party:public-data-feed"
  ],
  "target": [
    "urn:asset:wind-turbine-metrics",
    "urn:asset:aggregated-results"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:absoluteTemporalPosition",
          "operator": "odrl:lteq",
          "rightOperand": "2026-08-01"
        },
        {
          "leftOperand": "odrl:purpose",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "research",
            "audit",
            "education"
          ]
        },
        {
          "leftOperand": "odrl:virtualLocation",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "us-cloud",
            "eu-cloud",
            "hybrid"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:version",
          "operator": "odrl:lteq",
          "rightOperand": 2
        },
        {
          "leftOperand": "odrl:media",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "broadcast",
            "print",
            "web"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "delayedResult",
      "constraint": [
        {
          "leftOperand": "odrl:delayPeriod",
          "operator": "odrl:lteq",
          "rightOperand": "PT36H"
        },
        {
          "leftOperand": "odrl:samplingRate",
          "operator": "odrl:lteq",
          "rightOperand": 0.1
        },
        {
          "leftOperand": "odrl:language",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "es",
            "en",
            "el"
          ]
        }
      ]
    }
  ]
}