{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0867_far_narrow:consumer:aspiration",
  "assigner": "did:party:policy-issuer",
  "assignee": [
    "did:party:data-service-provider",
    "did:party:unauthorized-party"
  ],
  "target": [
    "urn:asset:personal-sensitive-data",
    "urn:asset:third-party-report"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:privacyParameter",
          "operator": "odrl:gteq",
          "rightOperand": 3.9
        },
        {
          "leftOperand": "odrl:resolution",
          "operator": "odrl:lteq",
          "rightOperand": 0
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "PARQUET",
            "passenger name record data",
            "RDF"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "distribute",
      "constraint": [
        {
          "leftOperand": "odrl:privacyParameter",
          "operator": "odrl:gteq",
          "rightOperand": 3.9
        },
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "EU",
            "Gaia-X Trusted Zone",
            "ASEAN"
          ]
        },
        {
          "leftOperand": "odrl:language",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "de",
            "fr",
            "el"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "submitReport",
      "constraint": [
        {
          "leftOperand": "odrl:privacyParameter",
          "operator": "odrl:gteq",
          "rightOperand": 3.9
        },
        {
          "leftOperand": "odrl:media",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "internal-wiki",
            "web"
          ]
        }
      ]
    }
  ]
}