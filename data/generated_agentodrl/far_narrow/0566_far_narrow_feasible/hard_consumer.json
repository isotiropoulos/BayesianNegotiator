{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0566_far_narrow:consumer:hard",
  "assigner": "did:party:french-national-art-repository",
  "assignee": [
    "did:party:authenticated-art-historians"
  ],
  "target": [
    "urn:asset:digitized-impressionist-paintings"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:environment",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "drk:OpenScienceCloud",
            "ENISA-compliant secure environments",
            "ISO 27701"
          ]
        },
        {
          "leftOperand": "odrl:watermark",
          "operator": "odrl:eq",
          "rightOperand": "True"
        },
        {
          "leftOperand": "odrl:confidenceLevel",
          "operator": "odrl:lteq",
          "rightOperand": 0.3
        },
        {
          "leftOperand": "odrl:absoluteTemporalPosition",
          "operator": "odrl:gt",
          "rightOperand": "2027-09-21"
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "download",
      "constraint": [
        {
          "leftOperand": "odrl:watermark",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "True"
          ]
        },
        {
          "leftOperand": "odrl:elapsedTime",
          "operator": "odrl:gteq",
          "rightOperand": "P40DT23H58M31.424S"
        },
        {
          "leftOperand": "odrl:language",
          "operator": "odrl:neq",
          "rightOperand": "es"
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:payAmount",
          "operator": "odrl:lteq",
          "rightOperand": 3170
        }
      ]
    }
  ]
}