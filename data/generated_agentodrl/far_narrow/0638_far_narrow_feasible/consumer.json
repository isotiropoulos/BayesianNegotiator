{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0638_far_narrow:consumer:aspiration",
  "assigner": "did:party:policy-owner",
  "assignee": [
    "did:party:museum-curators"
  ],
  "target": [
    "urn:asset:scanned-art-exhibition-catalogues"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:segmentLength",
          "operator": "odrl:gteq",
          "rightOperand": 1300
        },
        {
          "leftOperand": "odrl:timeInterval",
          "operator": "odrl:lteq",
          "rightOperand": "PT0S"
        },
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "CH",
            "EU",
            "DACH"
          ]
        },
        {
          "leftOperand": "odrl:systemDevice",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "vm",
            "bare-metal",
            "authorized_mixed_reality_headset"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:version",
          "operator": "odrl:lteq",
          "rightOperand": 0
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "JSON",
            "SubstationOperationData",
            "secure research terminal"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:resolution",
          "operator": "odrl:lteq",
          "rightOperand": 0
        },
        {
          "leftOperand": "odrl:purpose",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "commercial",
            "HistoricalLinguistics",
            "copyright ownership claim"
          ]
        }
      ]
    }
  ]
}