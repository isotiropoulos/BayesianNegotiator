          "operator": "odrl:lteq",
          "rightOperand": "P49DT5H57M35.156S"
        },
        {
          "leftOperand": "odrl:timeInterval",
          "operator": "odrl:lteq",
          "rightOperand": "P11DT7H25M53.521S"
        }
      ]
    }
  ],
  "prohibition": [
