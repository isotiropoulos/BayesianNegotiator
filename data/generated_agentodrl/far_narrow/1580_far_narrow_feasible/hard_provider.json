      "constraint": [
        {
          "leftOperand": "odrl:samplingRate",
          "operator": "odrl:lt",
          "rightOperand": 0.5
        },
        {
          "leftOperand": "odrl:timeInterval",
          "operator": "odrl:gteq",
          "rightOperand": "P9DT14H51M40.945S"
        },
        {
          "leftOperand": "odrl:virtualLocation",
          "operator": "odrl:eq",
          "rightOperand": "on-prem"
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:absoluteTemporalPosition",
          "operator": "odrl:lt",
          "rightOperand": "2027-09-30"
        },
        {
          "leftOperand": "odrl:recipient",
          "operator": "odrl:eq",
          "rightOperand": "regulator"
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:eq",
