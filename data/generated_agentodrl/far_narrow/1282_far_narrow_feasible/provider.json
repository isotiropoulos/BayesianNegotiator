{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1282_far_narrow:provider:aspiration",
  "assigner": "did:party:energy-data-platform-access",
  "assignee": [
    "did:party:counterparty"
  ],
  "target": [
    "urn:asset:energy-data-platform-access",
    "urn:asset:approval-process",
    "urn:asset:blockchain-evidence",
    "urn:asset:audit-traceability",
    "urn:asset:audit-immutability"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:samplingRate",
          "operator": "odrl:lteq",
          "rightOperand": 0.11
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "RDF",
            "PARQUET",
            "XLSX"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:elapsedTime",
          "operator": "odrl:lteq",
          "rightOperand": "P45DT3H32M17.425S"
        },
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "CH",
            "UK",
            "EU"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "wait",
      "constraint": [
        {
          "leftOperand": "odrl:dateTime",
          "operator": "odrl:lt",
          "rightOperand": "P1D"
        },
        {
          "leftOperand": "odrl:meteredTime",
          "operator": "odrl:lteq",
          "rightOperand": "P3DT21H38M28.349S"
        },
        {
          "leftOperand": "odrl:recipient",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "internal-only",
            "third-party",
            "public"
          ]
        }
      ]
    },
    {
      "action": "recordEvidence",
      "constraint": [
        {
          "leftOperand": "odrl:hasPart",
          "operator": "odrl:hasPart",
          "rightOperand": "BlockchainEvidence"
        }
      ]
    }
  ]
}