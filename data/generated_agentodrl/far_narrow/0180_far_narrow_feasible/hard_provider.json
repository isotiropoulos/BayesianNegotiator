{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0180_far_narrow:provider:hard",
  "assigner": "did:party:policy-owner",
  "assignee": [
    "did:party:stakeholder"
  ],
  "target": [
    "urn:asset:readings"
  ],
  "permission": [
    {
      "action": "distribute",
      "constraint": [
        {
          "leftOperand": "odrl:scope",
          "operator": "odrl:isNoneOf",
          "rightOperand": [
            "Healthcare Research Data Space"
          ]
        },
        {
          "leftOperand": "odrl:absoluteTemporalPosition",
          "operator": "odrl:lt",
          "rightOperand": "2027-10-20"
        },
        {
          "leftOperand": "odrl:confidenceLevel",
          "operator": "odrl:gteq",
          "rightOperand": 0.24
        },
        {
          "leftOperand": "odrl:deliveryChannel",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "https"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:relativeTemporalPosition",
          "operator": "odrl:gt",
          "rightOperand": "2024-12-21"
        },
        {
          "leftOperand": "odrl:systemDevice",
          "operator": "odrl:eq",
          "rightOperand": "vm"
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:spatialResolution",
          "operator": "odrl:gt",
          "rightOperand": 215
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:eq",
          "rightOperand": "RDF"
        }
      ]
    }
  ]
}