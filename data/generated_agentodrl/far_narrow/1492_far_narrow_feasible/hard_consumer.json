{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1492_far_narrow:consumer:hard",
  "assigner": "did:party:policy-owner",
  "assignee": [
    "did:party:system"
  ],
  "target": [
    "urn:asset:clinical-trial-results-dataset",
    "urn:asset:all-data-exports"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:confidenceLevel",
          "operator": "odrl:lt",
          "rightOperand": 0.32
        },
        {
          "leftOperand": "odrl:version",
          "operator": "odrl:lteq",
          "rightOperand": 2
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "distribute",
      "constraint": [
        {
          "leftOperand": "odrl:scope",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "Healthcare Research Data Space"
          ]
        },
        {
          "leftOperand": "odrl:delayPeriod",
          "operator": "odrl:lt",
          "rightOperand": "P6DT10H58M21.088S"
        },
        {
          "leftOperand": "odrl:industry",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "finance",
            "mobility",
            "defence"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "tag",
      "constraint": [
        {
          "leftOperand": "odrl:tag",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "Quality Check Pending"
          ]
        },
        {
          "leftOperand": "odrl:percentage",
          "operator": "odrl:gt",
          "rightOperand": 42
        },
        {
          "leftOperand": "odrl:media",
          "operator": "odrl:eq",
          "rightOperand": "print"
        }
      ]
    }
  ]
}