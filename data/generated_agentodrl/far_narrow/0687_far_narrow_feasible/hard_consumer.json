{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0687_far_narrow:consumer:hard",
  "assigner": "did:party:policy-owner",
  "assignee": [
    "did:party:author"
  ],
  "target": [
    "urn:asset:deep-sea-biodiversity-records"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:timeInterval",
          "operator": "odrl:lteq",
          "rightOperand": "P13DT1H17M56.997S"
        },
        {
          "leftOperand": "odrl:delayPeriod",
          "operator": "odrl:lt",
          "rightOperand": "P2DT21H11M37.896S"
        },
        {
          "leftOperand": "odrl:industry",
          "operator": "odrl:neq",
          "rightOperand": "defence"
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:relativeTemporalPosition",
          "operator": "odrl:lteq",
          "rightOperand": "2025-04-02"
        },
        {
          "leftOperand": "odrl:event",
          "operator": "odrl:neq",
          "rightOperand": "termination"
        },
        {
          "leftOperand": "odrl:language",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "es",
            "de",
            "el"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:absoluteTemporalPosition",
          "operator": "odrl:gteq",
          "rightOperand": "2027-07-16"
        },
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:isNoneOf",
          "rightOperand": [
            "global"
          ]
        }
      ]
    }
  ]
}