{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1702_far_narrow:consumer:hard",
  "assigner": "did:party:policy-issuer",
  "assignee": [
    "did:party:mining-company",
    "did:party:natural-resources-authority"
  ],
  "target": [
    "urn:asset:critical-mineral-supply-chain-data",
    "urn:asset:mining-company",
    "urn:asset:mining-business"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:percentage",
          "operator": "odrl:gt",
          "rightOperand": 50
        },
        {
          "leftOperand": "odrl:payAmount",
          "operator": "odrl:lt",
          "rightOperand": 2055
        },
        {
          "leftOperand": "odrl:systemDevice",
          "operator": "odrl:eq",
          "rightOperand": "vm"
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:absoluteTemporalPosition",
          "operator": "odrl:gt",
          "rightOperand": "2027-07-31"
        },
        {
          "leftOperand": "odrl:purpose",
          "operator": "odrl:neq",
          "rightOperand": "audit"
        },
        {
          "leftOperand": "odrl:language",
          "operator": "odrl:isNoneOf",
          "rightOperand": [
            "es"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:timeInterval",
          "operator": "odrl:lt",
          "rightOperand": "P10DT14H6M45.493S"
        },
        {
          "leftOperand": "odrl:industry",
          "operator": "odrl:isNoneOf",
          "rightOperand": [
            "defence"
          ]
        }
      ]
    }
  ]
