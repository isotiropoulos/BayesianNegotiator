  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:percentage",
          "operator": "odrl:eq",
          "rightOperand": 48
        },
        {
          "leftOperand": "odrl:industry",
          "operator": "odrl:eq",
