{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Agreement",
  "@id": "urn:witness",
  "assigner": "did:party:city-green-development-committee",
  "assignee": [
    "did:party:building-energy-solution-provider"
  ],
  "target": [
    "urn:asset:green-building-data",
    "urn:asset:usage-report"
  ],
  "permission": [
