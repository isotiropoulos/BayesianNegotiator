{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1409_far_narrow:consumer:aspiration",
  "assigner": "did:party:policy-owner",
  "assignee": [
    "did:party:user"
  ],
  "target": [
    "urn:asset:account-information"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:percentage",
          "operator": "odrl:gteq",
          "rightOperand": 96
        },
        {
          "leftOperand": "odrl:delayPeriod",
          "operator": "odrl:lteq",
          "rightOperand": "PT0S"
        },
        {
          "leftOperand": "odrl:fileFormat",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "JSON",
            "anonymized",
            "secure research terminal"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:relativeTemporalPosition",
          "operator": "odrl:lteq",
          "rightOperand": "2023-12-25"
        },
        {
          "leftOperand": "odrl:language",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "el",
            "es",
            "en"
          ]
        },
        {
          "leftOperand": "odrl:purpose",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "research",
            "TISAXCertifiedVaults",
            "precise vehicle location history"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:confidenceLevel",
          "operator": "odrl:lteq",
          "rightOperand": 0.0
        },
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "US",
            "European Digital Art Space",
            "Global Clinical Trial Data Platform"
          ]
        }
      ]
    }
  ]
}