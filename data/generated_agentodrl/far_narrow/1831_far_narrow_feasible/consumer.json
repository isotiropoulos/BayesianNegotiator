{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1831_far_narrow:consumer:aspiration",
  "assigner": "did:party:state-security-org",
  "assignee": [
    "did:party:public-security-org",
    "did:party:relevant-polluting-entities-and-individuals"
  ],
  "target": [
    "urn:asset:pollution-monitoring-data"
  ],
  "permission": [
    {
      "action": "retrieve",
      "constraint": [
        {
          "leftOperand": "odrl:purpose",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "lawful",
            "anti-violence campaigns",
            "closed-source machine learning models"
          ]
        },
        {
          "leftOperand": "odrl:approvalProcedures",
          "operator": "odrl:gteq",
          "rightOperand": 1
        },
        {
          "leftOperand": "odrl:resolution",
          "operator": "odrl:lteq",
          "rightOperand": 0
        },
        {
          "leftOperand": "odrl:media",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "print",
            "web"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:unitOfCount",
          "operator": "odrl:gteq",
          "rightOperand": 1508
        },
        {
          "leftOperand": "odrl:systemDevice",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "hsm",
            "Australia Spatial Data Hub",
            "authorized_mixed_reality_headset"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:timeInterval",
          "operator": "odrl:lteq",
          "rightOperand": "PT0S"
        },
        {
          "leftOperand": "odrl:deliveryChannel",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "sftp",
            "https",
            "courier"
          ]
        }
      ]
    }
  ]
}