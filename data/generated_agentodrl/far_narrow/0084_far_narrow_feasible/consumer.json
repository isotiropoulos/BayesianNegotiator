{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0084_far_narrow:consumer:aspiration",
  "assigner": "did:party:open-museum-network",
  "assignee": [
    "did:party:regional-art-educators-association"
  ],
  "target": [
    "urn:asset:silent-forest-artwork"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:absoluteTemporalPosition",
          "operator": "odrl:gteq",
          "rightOperand": "2029-01-15"
        },
        {
          "leftOperand": "odrl:systemDevice",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "hsm",
            "consortium-approved",
            "secure research terminals"
          ]
        },
        {
          "leftOperand": "odrl:industry",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "retail",
            "医院数据提供方",
            "finance"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:timeInterval",
          "operator": "odrl:lteq",
          "rightOperand": "PT0S"
        },
        {
          "leftOperand": "odrl:media",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "broadcast",
            "print"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "download",
      "constraint": [
        {
          "leftOperand": "odrl:count",
          "operator": "odrl:gteq",
          "rightOperand": 1300
        },
        {
          "leftOperand": "odrl:resolution",
          "operator": "odrl:lteq",
          "rightOperand": 0
        },
        {
          "leftOperand": "odrl:recipient",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "internal-only",
            "regulator",
            "//example.org/parties/agriTechCompany"
          ]
        }
      ]
    }
  ]
}