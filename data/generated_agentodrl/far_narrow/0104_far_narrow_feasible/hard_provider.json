{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0104_far_narrow:provider:hard",
  "assigner": "did:party:data-space-owner",
  "assignee": [
    "did:party:registered-curators"
  ],
  "target": [
    "urn:asset:restoration-documentation-files",
    "urn:asset:all-servers"
  ],
  "permission": [
    {
      "action": "retrieve",
      "constraint": [
        {
          "leftOperand": "odrl:dateTime",
          "operator": "odrl:lt",
          "rightOperand": "2025-02-12"
        },
        {
          "leftOperand": "odrl:accessLocation",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "certifiedArchivalServers"
          ]
        },
        {
          "leftOperand": "odrl:percentage",
          "operator": "odrl:lteq",
          "rightOperand": 49
        },
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "global"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "access",
      "constraint": [
        {
          "leftOperand": "odrl:accessLocation",
          "operator": "odrl:eq",
          "rightOperand": "Gaia-X Trusted Zone"
        },
        {
          "leftOperand": "odrl:version",
          "operator": "odrl:gt",
          "rightOperand": 0
        },
        {
          "leftOperand": "odrl:deliveryChannel",
          "operator": "odrl:eq",
          "rightOperand": "kafka"
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:samplingRate",
          "operator": "odrl:lteq",
          "rightOperand": 0.56
        }
      ]
    }
  ]
}