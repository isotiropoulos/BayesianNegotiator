      "action": "report",
      "constraint": [
        {
          "leftOperand": "odrl:dateTime",
          "operator": "odrl:eq",
          "rightOperand": "P12DT15M"
        },
        {
          "leftOperand": "odrl:confidenceLevel",
          "operator": "odrl:eq",
          "rightOperand": 0.28
        },
        {
          "leftOperand": "odrl:language",
