{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0914_far_narrow:consumer:aspiration",
  "assigner": "did:party:traffic-data-provider",
  "assignee": [
    "did:party:counterparty"
  ],
  "target": [
    "urn:asset:traffic-live2025-data",
    "urn:asset:usage-effectiveness-report",
    "urn:asset:public-data-maintenance-fund"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:relativeTemporalPosition",
          "operator": "odrl:lteq",
          "rightOperand": "2023-10-20"
        },
        {
          "leftOperand": "odrl:industry",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "health",
            "state credit industry administrative department",
            "public"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:media",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "print",
            "broadcast"
          ]
        },
        {
          "leftOperand": "odrl:language",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "el",
            "fr",
            "es"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "report",
      "constraint": [
        {
          "leftOperand": "odrl:timeInterval",
          "operator": "odrl:lteq",
          "rightOperand": "PT0S"
        },
        {
          "leftOperand": "odrl:deliveryChannel",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "courier",
            "https",
            "kafka"
          ]
        }
      ]
    },
    {
      "action": "contribute",
      "constraint": [
        {
          "leftOperand": "odrl:payAmount",
          "operator": "odrl:lteq",
          "rightOperand": 0.0
        }
      ]
    },
    {
      "action": "pay",
      "constraint": [
        {
          "leftOperand": "odrl:payAmount",
          "operator": "odrl:gteq",
          "rightOperand": 1
        }
      ]
    }
  ]
}