{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:1338_far_narrow:consumer:hard",
  "assigner": "did:party:policy-owner",
  "assignee": [
    "did:party:traffic-data-service-provider"
  ],
  "target": [
    "urn:asset:traffic-data-asset",
    "urn:asset:traffic-flow-data",
    "urn:asset:traffic-flow-logs",
    "urn:asset:personal-travel-trajectories",
    "urn:asset:statistical-data",
    "urn:asset:third-party-report",
    "urn:asset:user-account",
    "urn:asset:traffic-data",
    "urn:asset:full-domain-security",
    "urn:asset:cause-analysis",
    "urn:asset:security-certification"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:count",
          "operator": "odrl:gt",
          "rightOperand": 277096
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:language",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "fr",
            "en",
            "el"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "log",
      "constraint": [
        {
          "leftOperand": "odrl:accessedResource",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "drk:TrafficFlowData"
          ]
        }
      ]
    },
    {
      "action": "attachProof",
      "constraint": [
        {
          "leftOperand": "odrl:resource",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "drk:SensitiveTrafficData"
          ]
        }
      ]
    },
    {
      "action": "store",
      "constraint": [
        {
          "leftOperand": "odrl:elapsedTime",
          "operator": "odrl:gt",
          "rightOperand": "P18DT14H44M14.793S"
        }
      ]
    },
    {
      "action": "applyPrivacyTech",
      "constraint": [
        {
          "leftOperand": "odrl:tech",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "homomorphicEncryption",
            "federatedLearning"
          ]
        }
      ]
    },
    {
      "action": "shareData",
      "constraint": [
        {
          "leftOperand": "odrl:privacy",
          "operator": "odrl:gt",
          "rightOperand": 2.22
        }
      ]
    },
    {
      "action": "triggerFengzhad",
      "constraint": [
        {
          "leftOperand": "odrl:dailyAccessCount",
          "operator": "odrl:lt",
          "rightOperand": 0.78
        }
      ]
    }
  ]
}