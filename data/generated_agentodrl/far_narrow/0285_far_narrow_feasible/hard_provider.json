  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:count",
          "operator": "odrl:lt",
          "rightOperand": 527889
        },
        {
          "leftOperand": "odrl:deliveryChannel",
