{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0744_far_narrow:consumer:hard",
  "assigner": "did:party:data-owner",
  "assignee": [
    "did:party:data-consumer"
  ],
  "target": [
    "urn:asset:outputs-derived-from-aggregated-pedestrian-movement-data"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:samplingRate",
          "operator": "odrl:gteq",
          "rightOperand": 0.44
        },
        {
          "leftOperand": "odrl:timeInterval",
          "operator": "odrl:lt",
          "rightOperand": "P14DT22H49M39.075S"
        },
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "CH"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "share",
      "constraint": [
        {
          "leftOperand": "odrl:relativeTemporalPosition",
          "operator": "odrl:lt",
          "rightOperand": "2025-05-08"
        },
        {
          "leftOperand": "odrl:media",
          "operator": "odrl:neq",
          "rightOperand": "internal-wiki"
        },
        {
          "leftOperand": "odrl:recipient",
          "operator": "odrl:isAllOf",
          "rightOperand": [
            "regulator"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "notify",
      "constraint": [
        {
          "leftOperand": "odrl:percentage",
          "operator": "odrl:gteq",
          "rightOperand": 49
        },
        {
          "leftOperand": "odrl:event",
          "operator": "odrl:neq",
          "rightOperand": "termination"
        }
      ]
    }
  ]
