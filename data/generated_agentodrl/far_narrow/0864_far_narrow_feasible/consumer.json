{
  "@context": "http://www.w3.org/ns/odrl.jsonld",
  "@type": "Offer",
  "@id": "urn:case:0864_far_narrow:consumer:aspiration",
  "assigner": "did:party:policy-issuer",
  "assignee": [
    "did:party:user"
  ],
  "target": [
    "urn:asset:services"
  ],
  "permission": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:absoluteAge",
          "operator": "odrl:lteq",
          "rightOperand": 0
        },
        {
          "leftOperand": "odrl:spatial",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "UserCountry",
            "NorthAmerica",
            "UK"
          ]
        },
        {
          "leftOperand": "odrl:percentage",
          "operator": "odrl:gteq",
          "rightOperand": 94
        },
        {
          "leftOperand": "odrl:virtualLocation",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "hybrid",
            "http://example.org/servers",
            "edge"
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "action": "use",
      "constraint": [
        {
          "leftOperand": "odrl:age",
          "operator": "odrl:gteq",
          "rightOperand": 47
        },
        {
          "leftOperand": "odrl:deliveryChannel",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "courier",
            "SupportChannel",
            "sftp"
          ]
        }
      ]
    }
  ],
  "obligation": [
    {
      "action": "obtainParentOrGuardianConsent",
      "constraint": [
        {
          "leftOperand": "odrl:age",
          "operator": "odrl:gteq",
          "rightOperand": 47
        },
        {
          "leftOperand": "odrl:systemDevice",
          "operator": "odrl:isAnyOf",
          "rightOperand": [
            "bare-metal",
            "tee",
            "Australia Spatial Data Hub"
          ]
        }
      ]
    }
  ]
}